@using Sense.Application.DTOs.CategoryDTOs
@model UploadCategoryImageDto

<div class="card mb-xl-8">
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">صورة التصنيف</span>
            <span class="text-muted mt-1 fw-semibold fs-7">@ViewBag.CategoryName</span>
        </h3>
    </div>

    <div class="card-body pt-3">
        <form asp-area="Provider" asp-controller="Category" asp-action="UploadImage" method="post" enctype="multipart/form-data">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger fs-7 mb-3"></div>

            <div class="mb-5">
                <label asp-for="Image" class="form-label required">اختر صورة التصنيف</label>
                <input asp-for="Image" class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" required />
                <span asp-validation-for="Image" class="text-danger fs-7"></span>
                <div class="form-text">الصيغ المدعومة: JPG وJPEG وPNG، بحد أقصى 5 ميجابايت.</div>
            </div>

            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-primary">
                    <i class="ki-duotone ki-check fs-2"></i>
                    حفظ الصورة
                </button>
                <a asp-area="Provider" asp-controller="Category" asp-action="Index" class="btn btn-light">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
