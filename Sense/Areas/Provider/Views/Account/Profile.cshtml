@using Sense.Application.DTOs.AuthDTOs
@model UserDto

<div class="card mb-xl-8">
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">ملفي الشخصي</span>
            <span class="text-muted mt-1 fw-semibold fs-7">بيانات حساب المزود الخاص بك.</span>
        </h3>
    </div>
    <div class="card-body pt-3">
        <div class="text-center mb-5">
            @if (!string.IsNullOrEmpty(Model?.ImageURL))
            {
                <img src="@Model.ImageURL" class="symbol symbol-75px symbol-circle" style="width:15%;height:15%" />
            }
            else
            {
                <img src="~/assets/img/avatar-default.svg" class="symbol symbol-75px symbol-circle" style="width:15%;height:15%" />
            }
        </div>

        <div class="row g-6">
            <div class="col-md-6">
                <label class="form-label fw-semibold">الاسم الكامل</label>
                <div class="form-control form-control-solid">@Model?.FullName</div>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">اسم المستخدم</label>
                <div class="form-control form-control-solid">@Model?.Username</div>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">البريد الإلكتروني</label>
                <div class="form-control form-control-solid">@Model?.Email</div>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">رقم الهاتف</label>
                <div class="form-control form-control-solid">@Model?.PhoneNumber</div>
            </div>
            <div class="col-md-12">
                <label class="form-label fw-semibold">حالة الحساب</label>
                @if (Model?.IsActive == true)
                {
                    <span class="badge badge-light-success fs-6">نشط</span>
                }
                else
                {
                    <span class="badge badge-light-danger fs-6">معطل</span>
                }
            </div>
        </div>

        <div class="d-flex gap-3 mt-7">
            <a asp-area="Provider" asp-controller="Account" asp-action="ChangePassword" class="btn btn-light">
                تغيير كلمة المرور
            </a>
        </div>
    </div>
</div>
