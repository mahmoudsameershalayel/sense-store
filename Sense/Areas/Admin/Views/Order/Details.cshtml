                                        <td id="productQuantity">-</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">إجمالي المبيعات</th>
                                        <td id="productTotalSales" class="text-primary fw-bold">-</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">نوع المنتج</th>
                                        <td id="productType">-</td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Additional Details -->
                            <div class="row mt-3">
                                <div class="col-md-4">
                                    <div class="card text-center shadow-sm">
                                        <div class="card-body">
                                            <h6 class="card-title text-muted">العلامة التجارية</h6>
                                            <p id="productBrand" class="card-text fw-bold">-</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card text-center shadow-sm">
                                        <div class="card-body">
                                            <h6 class="card-title text-muted">الموديل</h6>
                                            <p id="productModel" class="card-text fw-bold">-</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card text-center shadow-sm">
                                        <div class="card-body">
                                            <h6 class="card-title text-muted">الفئة</h6>
                                            <p id="productCategory" class="card-text fw-bold">-</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Error Message -->
                <div id="productErrorMessage" class="alert alert-danger" style="display: none;" role="alert">
                    <i class="fa fa-exclamation-triangle"></i>
                    <span id="errorText">حدث خطأ أثناء تحميل بيانات المنتج</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times"></i> إغلاق
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <link rel="stylesheet" href="~/assets/plugins/custom/leaflet/leaflet.bundle.css" />
    <script src="~/assets/plugins/custom/leaflet/leaflet.bundle.js"></script>

    <script>
        let addressMap;
        let addressMarker;

        // Initialize map when modal is shown
        $('#addressMapModal').on('shown.bs.modal', function () {
            if (!window.addressMapInitialized) {
                initAddressMap();
                window.addressMapInitialized = true;
            } else if (addressMap) {
                // Invalidate size to fix rendering issues
                addressMap.invalidateSize();
            }
        });

        // Initialize address map with geocoding fallback
        function initAddressMap() {
            const latStr = '@Model.Address?.LocationLat';
            const lngStr = '@Model.Address?.LocationLong';
            const lat = parseFloat(latStr);
            const lng = parseFloat(lngStr);

            // Check if coordinates are valid
            const hasValidCoords = !isNaN(lat) && !isNaN(lng) && lat !== 0 && lng !== 0;

            if (hasValidCoords) {
                // Use provided coordinates
                createMap(lat, lng);
            } else {
                // Try geocoding with city name
                const city = '@Model.Address?.City';
                if (city && city.trim() !== '') {
                    geocodeCity(city);
                } else {
                    // Default to Riyadh center
                    createMap(24.7136, 46.6753);
                }
            }
        }

        // Geocode city name using Nominatim API
        function geocodeCity(city) {
            // Show loading spinner
            const mapContainer = $('#orderAddressMap');
            mapContainer.html('<div class="map-loading"><i class="fas fa-spinner fa-spin"></i><div style="margin-top: 10px;">جاري تحميل الموقع...</div></div>');

            $.ajax({
                url: 'https://nominatim.openstreetmap.org/search',
                method: 'GET',
                data: {
                    format: 'json',
                    q: city + ', Saudi Arabia',
                    limit: 1
                },
                headers: {
                    'User-Agent': 'SenseApp/1.0'
                },
                timeout: 5000,
                success: function(response) {
                    if (response && response.length > 0) {
                        const lat = parseFloat(response[0].lat);
                        const lng = parseFloat(response[0].lon);
                        createMap(lat, lng);
                    } else {
                        console.log('No geocoding results found, using default location');
                        createMap(24.7136, 46.6753);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Geocoding error:', error);
                    createMap(24.7136, 46.6753);
                }
            });
        }

        // Create and initialize the map
        function createMap(lat, lng) {
            // Clear loading spinner
            $('#orderAddressMap').html('');

            // Initialize map centered on the coordinates
            addressMap = L.map('orderAddressMap').setView([lat, lng], 15);

            // Add OpenStreetMap tiles
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                maxZoom: 19
            }).addTo(addressMap);

            // Create custom marker icon
            const customIcon = L.divIcon({
                html: '<i class="fas fa-map-marker-alt" style="color: #dc3545; font-size: 32px;"></i>',
                iconSize: [32, 32],
                iconAnchor: [16, 32],
                popupAnchor: [0, -32],
                className: 'custom-marker-icon'
            });

            // Add marker with popup
            addressMarker = L.marker([lat, lng], { icon: customIcon }).addTo(addressMap);

            const city = '@Model.Address?.City' || '';
            const street = '@Model.Address?.Street' || '';
            const neighborhood = '@Model.Address?.Neighborhood' || '';

            const popupContent = `
                <div class="address-marker-popup">
                    <strong>📍 عنوان التوصيل</strong>
                    ${city && street ? `<div>${city}, ${street}</div>` : ''}
                    ${neighborhood ? `<div>الحي: ${neighborhood}</div>` : ''}
                </div>
            `;

            addressMarker.bindPopup(popupContent).openPopup();
        }
    </script>

    <script>
        // Function to fetch and display product details
        async function fetchProductDetails(productId) {
            // Show modal
            const modal = new bootstrap.Modal(document.getElementById('productDetailsModal'));
            modal.show();

            // Show loading spinner
            document.getElementById('productLoadingSpinner').style.display = 'block';
            document.getElementById('productDetailsContent').style.display = 'none';
            document.getElementById('productErrorMessage').style.display = 'none';

            try {
                // Make API request to get product by ID
                const response = await fetch(`/Admin/Product/GetProductById/${productId}`, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                if (!response.ok) {
                    throw new Error('فشل في تحميل بيانات المنتج');
                }

                const apiResponse = await response.json();
                const product = apiResponse.data;

