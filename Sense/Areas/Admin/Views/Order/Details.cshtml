                                    <tr>
                                        <th class="bg-light">الوصف</th>
                                        <td id="productDescription">-</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">السعر</th>
                                        <td id="productPrice" class="text-success fw-bold">-</td>
                                    </tr>
                                    <tr>
