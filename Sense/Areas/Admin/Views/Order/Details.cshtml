<!-- Address Map Modal -->
<div class="modal fade" id="addressMapModal" tabindex="-1" aria-labelledby="addressMapModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="direction: rtl; border-radius: 20px; overflow: hidden;">
            <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <h5 class="modal-title" id="addressMapModalLabel">
                    <i class="fas fa-map-marker-alt"></i> موقع عنوان التوصيل
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body" style="padding: 0;">
                <div id="orderAddressMap" style="height: 400px; width: 100%;"></div>
                <div style="padding: 20px; background: #f8f9fa;">
                    <h6 style="color: #667eea; margin-bottom: 15px;"><i class="fas fa-info-circle"></i> تفاصيل العنوان الكاملة</h6>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <strong>المدينة:</strong> @Model.Address?.City
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong>الشارع:</strong> @Model.Address?.Street
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.Address?.Neighborhood))
                        {
                            <div class="col-md-6 mb-2">
                                <strong>الحي السكني:</strong> @Model.Address?.Neighborhood
                            </div>
                        }
                        <div class="col-12 mb-2">
                            <strong>العنوان الكامل:</strong> @Model.Address?.City, @Model.Address?.Street @if (!string.IsNullOrWhiteSpace(Model.Address?.Neighborhood)) { @($" - الحي السكني : {Model.Address?.Neighborhood}") }
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong>خط العرض:</strong> @Model.Address?.LocationLat
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong>خط الطول:</strong> @Model.Address?.LocationLong
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> إغلاق
                </button>
            </div>
        </div>
    </div>
</div>


<!-- Modal Structure -->
<div class="modal fade" id="productDetailsModal" tabindex="-1" aria-labelledby="productDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="direction: rtl; text-align: right;">
            <div class="modal-header text-white">
                <h5 class="modal-title" id="productDetailsModalLabel">
                    <i class="fa fa-box"></i> تفاصيل المنتج
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Loading Spinner -->
                <div id="productLoadingSpinner" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">جاري التحميل...</span>
                    </div>
                    <p class="mt-3">جاري تحميل بيانات المنتج...</p>
                </div>

                <!-- Product Details Content -->
                <div id="productDetailsContent" style="display: none;">
                    <div class="row">
                        <!-- Product Image -->
                        <div class="col-md-4 text-center mb-3">
