                document.getElementById('productOfferDisVal').textContent = product.offerDisVal ? product.offerDisVal.toFixed(2) + '                         <svg class="riyal-svg currency" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 78.917 78.917" width="15" height="15" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-0.125em"><path d="M32.501,16.458H9.021L9,66.958c0,2.48-2.019,4.5-4.5,4.5s-4.5-2.02-4.5-4.5l0.025-55.005c0.003-2.479,2.021-4.495,4.5-4.495h27.977c13.51,0,24.5,10.991,24.5,24.5v23c0,2.48-2.02,4.5-4.5,4.5s-4.5-2.02-4.5-4.5v-23C48.001,23.412,41.048,16.458,32.501,16.458z M74.417,7.458c-2.481,0-4.5,2.019-4.5,4.5l-0.021,50.5h-23.48c-8.547,0-15.5-6.953-15.5-15.5v-23c0-2.481-2.019-4.5-4.5-4.5s-4.5,2.019-4.5,4.5v23c0,13.509,10.99,24.5,24.5,24.5h27.977c2.479,0,4.498-2.016,4.5-4.495l0.024-55.005C78.917,9.478,76.898,7.458,74.417,7.458z" /></svg>' : 'لا يوجد خصم';
                document.getElementById('productQuantity').textContent = product.quantityAvaliable || '0';
                document.getElementById('productTotalSales').textContent = product.totalSales ? product.totalSales.toFixed(2) + '                         <svg class="riyal-svg currency" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 78.917 78.917" width="15" height="15" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-0.125em"><path d="M32.501,16.458H9.021L9,66.958c0,2.48-2.019,4.5-4.5,4.5s-4.5-2.02-4.5-4.5l0.025-55.005c0.003-2.479,2.021-4.495,4.5-4.495h27.977c13.51,0,24.5,10.991,24.5,24.5v23c0,2.48-2.02,4.5-4.5,4.5s-4.5-2.02-4.5-4.5v-23C48.001,23.412,41.048,16.458,32.501,16.458z M74.417,7.458c-2.481,0-4.5,2.019-4.5,4.5l-0.021,50.5h-23.48c-8.547,0-15.5-6.953-15.5-15.5v-23c0-2.481-2.019-4.5-4.5-4.5s-4.5,2.019-4.5,4.5v23c0,13.509,10.99,24.5,24.5,24.5h27.977c2.479,0,4.498-2.016,4.5-4.495l0.024-55.005C78.917,9.478,76.898,7.458,74.417,7.458z" /></svg>' : '0.00                         <svg class="riyal-svg currency" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 78.917 78.917" width="15" height="15" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-0.125em"><path d="M32.501,16.458H9.021L9,66.958c0,2.48-2.019,4.5-4.5,4.5s-4.5-2.02-4.5-4.5l0.025-55.005c0.003-2.479,2.021-4.495,4.5-4.495h27.977c13.51,0,24.5,10.991,24.5,24.5v23c0,2.48-2.02,4.5-4.5,4.5s-4.5-2.02-4.5-4.5v-23C48.001,23.412,41.048,16.458,32.501,16.458z M74.417,7.458c-2.481,0-4.5,2.019-4.5,4.5l-0.021,50.5h-23.48c-8.547,0-15.5-6.953-15.5-15.5v-23c0-2.481-2.019-4.5-4.5-4.5s-4.5,2.019-4.5,4.5v23c0,13.509,10.99,24.5,24.5,24.5h27.977c2.479,0,4.498-2.016,4.5-4.495l0.024-55.005C78.917,9.478,76.898,7.458,74.417,7.458z" /></svg>';
                document.getElementById('productType').innerHTML = product.isSparePart
                    ? '<span class="badge bg-warning">قطعة غيار</span>'
                    : '<span class="badge bg-info">منتج عادي</span>';

                // Handle product image
                if (product.imageURL) {
                    document.getElementById('productImage').src = product.imageURL;
                    document.getElementById('productImage').style.display = 'block';
                    document.getElementById('noImagePlaceholder').style.display = 'none';
                } else {
                    document.getElementById('productImage').style.display = 'none';
                    document.getElementById('noImagePlaceholder').style.display = 'flex';
                }

                // Populate brand, model, category
                document.getElementById('productBrand').textContent = product.brand?.name || 'غير محدد';
                document.getElementById('productModel').textContent = product.model?.name || 'غير محدد';
                document.getElementById('productCategory').textContent = product.category?.name || 'غير محدد';

            } catch (error) {
                console.error('Error fetching product details:', error);

                // Hide loading spinner and show error message
                document.getElementById('productLoadingSpinner').style.display = 'none';
                document.getElementById('productDetailsContent').style.display = 'none';
                document.getElementById('productErrorMessage').style.display = 'block';
                document.getElementById('errorText').textContent = error.message || 'حدث خطأ أثناء تحميل بيانات المنتج';
            }
        }
    </script>
}
