@using Sense.Domain.Enums
@using Sense.Infrastructure.Extensions
@{
    ViewData["Title"] = "إدارة الطلبات";
}

<div class="card mb-5">
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">الطلبات</span>
            <span class="text-muted mt-1 fw-semibold fs-7">إدارة جميع الطلبات الواردة للمتجر</span>
        </h3>
    </div>

    <div class="card-body">

        <!-- ✅ Tabs Section -->
        <div class="bg-light p-3 rounded mb-4">
            <div class="d-flex justify-content-center gap-2 flex-wrap mb-2" id="mainTabs">
                <button class="btn btn-outline-primary active" data-tab="new">جديد (<span class="tab-count" data-tab="new">0</span>)</button>
                <button class="btn btn-outline-primary" data-tab="preparing">يجهز (<span class="tab-count" data-tab="preparing">0</span>)</button>
                <button class="btn btn-outline-primary" data-tab="completed">انتهت (<span class="tab-count" data-tab="completed">0</span>)</button>
            </div>

            <div class="d-flex justify-content-center gap-2 flex-wrap" id="subTabs"></div>
        </div>
        
        <!-- ✅ Filters -->
        <form id="filterForm" class="row g-3 align-items-end mb-4">
            <div class="col-md-4">
                <label for="searchInput" class="form-label">بحث</label>
                <input type="text" id="searchInput" class="form-control" placeholder="ابحث برقم الطلب أو اسم العميل">
            </div>
            <div class="col-md-3">
                <label for="startDate" class="form-label">من تاريخ</label>
                <input type="date" id="startDate" class="form-control" />
            </div>
            <div class="col-md-3">
                <label for="endDate" class="form-label">إلى تاريخ</label>
                <input type="date" id="endDate" class="form-control" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="button" id="filterButton" class="btn btn-primary flex-grow-1">تطبيق</button>
                <button type="button" id="clearFilters" class="btn btn-danger">مسح</button>
            </div>
        </form>

        <!-- ✅ Orders Table -->
        <div class="table-responsive">
            <table id="ordersTable" class="table table-bordered table-striped text-center align-middle w-100">
                <thead class="table-light">
                    <tr>
                        <th>رقم الطلب</th>
                        <th>اسم العميل</th>
                        <th>رقم الهاتف</th>
                        <th>تاريخ الطلب</th>
                        <th>وقت الطلب</th>
                        <th>الحالة</th>
                        <th>طريقة الدفع</th>
                        <th>حالة الدفع</th>
                        <th>العمليات</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

    </div>
</div>

<!-- ✅ Modal for Order Details -->
<div class="modal fade" id="orderDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">تفاصيل الطلب</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body" id="orderDetailsContent">
                <!-- details loaded dynamically -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // ==============================
            // ✅ Tabs
            // ==============================
            const subTabsMap = {
                new: [
                    { value: 1, label: 'طلبات جديدة' },
                    { value: 6, label: 'مرفوضة' }
                ],
                preparing: [
                    { value: 2, label: 'قيد التجهيز' },
                    { value: 3, label: 'تم التجهيز' },
                    { value: 4, label: 'تم الشحن' }
                ],
                completed: [
                    { value: 5, label: 'تم التوصيل' },
                    { value: 7, label: 'لم يتم التوصيل' }
                ]
            };

            let currentMainTab = 'new';
            let currentSubTab = subTabsMap['new'][0].value;

            function renderSubTabs(mainKey) {
                const container = $('#subTabs');
                container.empty();
                subTabsMap[mainKey].forEach(st => {
                    const btn = $('<button>')
                        .addClass('btn btn-outline-success')
                        .attr('data-subtab', st.value)
                        .text(st.label)
                        .on('click', function () {
                            $('#subTabs button').removeClass('active');
                            $(this).addClass('active');
                            currentSubTab = st.value;
                            table.ajax.reload();
                        });
                    container.append(btn);
                });
                container.find('button').first().addClass('active');
            }

            renderSubTabs('new');

            $('#mainTabs button').on('click', function () {
                $('#mainTabs button').removeClass('active');
                $(this).addClass('active');
                currentMainTab = $(this).data('tab');
                renderSubTabs(currentMainTab);
                currentSubTab = subTabsMap[currentMainTab][0].value;
                table.ajax.reload();
            });

            // ==============================
            // ✅ DataTable with Action Buttons
            // ==============================
            const table = $('#ordersTable').DataTable({
                processing: true,
                serverSide: true,
                searching: false,
                ajax: {
                    url: '@Url.Action("LoadOrders", "Order", new { area = "Admin" })',
                    type: 'POST',
                    data: function (d) {
                        d.status = currentSubTab;
                        d.searchTerm = $('#searchInput').val();
                        d.startDate = $('#startDate').val();
                        d.endDate = $('#endDate').val();
                    }
                },
                columns: [
                    { data: 'orderNumber' },
                    { data: 'customerName' },
                    { data: 'customerPhoneNumber' },
                    { data: 'orderDate' },
                    { data: 'orderTime' },
                    { data: 'orderStatus' },
                    { data: 'paymentMethod' },
                    { data: 'paymentStatus' },
                    {
                        data: null,
                        render: function (data) {
                            let buttons = `
                                <a href="/Admin/Order/Details/${data.id}" class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1" title="تفاصيل">
                                    <i class="ki-duotone ki-information fs-2">
                                      <span class="path1"></span>
                                      <span class="path2"></span>
                                    </i>
                                </a>
                            `;

                            // Status-based actions
                            switch (data.orderStatusValue) { // make sure backend sends int status value
                                case 1: // Pending
                                    buttons += `
                                        <button class="btn btn-success btn-sm me-1 update-status" data-id="${data.id}" data-status="2">قبول</button>
                                        <button class="btn btn-danger btn-sm update-status" data-id="${data.id}" data-status="6">رفض</button>
                                    `;
                                    break;
                                case 2: // Preparing
                                    buttons += `
                                        <button class="btn btn-primary btn-sm update-status" data-id="${data.id}" data-status="3">تم التجهيز</button>
                                    `;
                                    break;
                                case 3: // Prepared
                                    buttons += `
                                        <button class="btn btn-info btn-sm update-status" data-id="${data.id}" data-status="4">في الطريق</button>
                                    `;
                                    break;
                                case 4: // OutForDelivery
                                    buttons += `
                                        <button class="btn btn-success btn-sm me-1 update-status" data-id="${data.id}" data-status="5">تم التوصيل</button>
                                        <button class="btn btn-danger btn-sm update-status" data-id="${data.id}" data-status="7">لم يتم التوصيل</button>
                                    `;
                                    break;
                            }

                            return buttons;
                        },
                        orderable: false,
                        searchable: false
                    }
                ],
                language: {
                    url: '/js/datatables/i18n/ar.json'
                }
            });

            // ==============================
            // ✅ Filters
            // ==============================
            $('#filterButton').on('click', function () { table.ajax.reload(); });
            $('#clearFilters').on('click', function () {
                $('#searchInput').val('');
                $('#startDate').val('');
                $('#endDate').val('');
                table.ajax.reload();
            });

                function loadTabCounts() {
                    $.get('/Admin/Order/GetOrderCounts', function(data) {
                        $('#mainTabs .tab-count').each(function() {
                            const tab = $(this).data('tab'); // 'new', 'preparing', 'completed'
                            $(this).text(data[tab]); // use lowercase key directly
                        });
                    });
                }

                // Call on page load
                loadTabCounts();

                     // Refresh counts after status update
                $('#ordersTable').on('click', '.update-status', function () {
                    // after table reload
                    table.ajax.reload(null, false);
                    loadTabCounts();
                });
          // ==============================
            // ✅ Update Order Status with SweetAlert2
            // ==============================
            $('#ordersTable').on('click', '.update-status', function () {
                const id = $(this).data('id');
                const newStatus = $(this).data('status');

                Swal.fire({
                    title: 'تأكيد التحديث',
                    text: 'هل أنت متأكد من تغيير حالة الطلب؟',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'نعم، تأكيد',
                    cancelButtonText: 'إلغاء',
                    reverseButtons: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: `/Admin/Order/UpdateStatus/${id}`,
                            type: 'POST',
                            data: { status: newStatus },
                            success: function () {
                                Swal.fire({
                                    title: 'تم التحديث',
                                    text: 'تم تغيير حالة الطلب بنجاح',
                                    icon: 'success',
                                    timer: 1500,
                                    showConfirmButton: false
                                });
                                table.ajax.reload(null, false);
                            },
                            error: function () {
                                Swal.fire({
                                    title: 'خطأ',
                                    text: 'حدث خطأ أثناء تحديث الحالة',
                                    icon: 'error',
                                    confirmButtonText: 'موافق'
                                });
                            }
                        });
                    }
                });
            });

        });
    </script>
}
