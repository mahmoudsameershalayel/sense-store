@model Sense.Domain.DBEntities.InvoiceTbl
@using Sense.Infrastructure.Extensions
@using Sense.Application.DTOs.CenterSettingDTOs

@{
    ViewData["Title"] = "تفاصيل الفاتورة";

    var setting = ViewBag.Setting as CenterSettingDto;
    var centerName = !string.IsNullOrWhiteSpace(setting?.CenterName) ? setting.CenterName : "مركز سدرا";

    var customerName = Model.Order != null
        ? $"{Model.Order.Customer?.ApplicationUser?.FirstName} {Model.Order.Customer?.ApplicationUser?.LastName}"
        : $"{Model.MaintenanceRecord?.Appointment?.Customer?.ApplicationUser?.FirstName} {Model.MaintenanceRecord?.Appointment?.Customer?.ApplicationUser?.LastName}";
    customerName = string.IsNullOrWhiteSpace(customerName?.Trim()) ? "-" : customerName.Trim();

    var customerAddress = Model.Order?.Address != null
        ? string.Join("، ", new[] { Model.Order.Address.City, Model.Order.Address.Neighborhood, Model.Order.Address.Street, Model.Order.Address.Address }
            .Where(s => !string.IsNullOrWhiteSpace(s)))
        : "";

    var paymentMethod = Model.Order?.PaymentMethod?.GetDisplayName()
        ?? Model.MaintenanceRecord?.PaymentMethod?.GetDisplayName() ?? "-";
    var paymentStatus = Model.Order?.PaymentStatus?.GetDisplayName()
        ?? Model.MaintenanceRecord?.PaymentStatus?.GetDisplayName() ?? "-";

    // Line items: store-order invoices list the order products; maintenance invoices show a single line.
    var items = new List<(string Description, string Qty, decimal Price, decimal Total)>();
    if (Model.Order != null && Model.Order.OrderDetails.Any())
    {
        foreach (var d in Model.Order.OrderDetails)
        {
            var qty = d.ProductAmount ?? 1;
            var price = d.ProductPrice ?? 0;
            var total = d.ProductNetPrice ?? (price * qty);
            items.Add((d.Product?.Name ?? "منتج", $"{qty:0.##} قطعة", price, total));
        }
    }
    else
    {
        items.Add((Model.InvoiceType?.GetDisplayName() ?? "فاتورة", "1", Model.InvoiceAmount, Model.InvoiceAmount));
    }

    var subTotal = items.Sum(x => x.Total);
    var discount = Model.Order?.OrderTotalOfferDisValue ?? 0;
    var deliveryFee = Model.Order?.DeliveryFee ?? 0;
}

<style>
    .inv-sheet {
        --inv-yellow: #FFD500;
        --inv-blue: #1C3F94;
        background: #fff;
        max-width: 800px;
        margin: 0 auto;
        box-shadow: 0 0 24px rgba(0, 0, 0, .08);
        border-radius: 8px;
        overflow: hidden;
        color: #1e1e2d;
        display: flex;
        flex-direction: column;
        min-height: 1000px;
    }

    .inv-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 48px 0 0 48px;
    }

    .inv-contact {
        color: var(--inv-blue);
        font-size: .95rem;
        line-height: 2;
        padding-top: 8px;
    }

    .inv-title-band {
        background: var(--inv-yellow);
        padding: 28px 56px 28px 72px;
        border-radius: 0 0 0 12px;
    }

    .inv-title-band h1 {
        color: var(--inv-blue);
        font-weight: 900;
        font-size: 3.2rem;
        margin: 0;
        letter-spacing: 1px;
    }

    .inv-billto {
        padding: 48px 48px 0;
    }

    .inv-billto .name {
        color: var(--inv-blue);
        font-weight: 800;
        font-size: 1.15rem;
        margin-bottom: 4px;
    }

    .inv-billto .addr {
        color: #3f4254;
        line-height: 1.9;
    }

    .inv-no {
        padding: 20px 48px 0;
        font-weight: 800;
        font-size: 1.05rem;
        color: var(--inv-blue);
    }

    .inv-no span {
        background: var(--inv-yellow);
        padding: 2px 10px;
        border-radius: 4px;
    }

    .inv-table {
        width: calc(100% - 96px);
        margin: 24px 48px 0;
        border-collapse: collapse;
    }

    .inv-table thead th {
        color: #12244F;
        font-weight: 800;
        font-size: 1.05rem;
        padding: 12px 8px;
        border-bottom: 3px solid var(--inv-blue);
        text-align: right;
    }

    .inv-table tbody td {
        padding: 18px 8px;
        border-bottom: 1px solid #e4e6ef;
        color: #3f4254;
    }

    .inv-table th:not(:first-child),
    .inv-table td:not(:first-child) {
        text-align: center;
        white-space: nowrap;
    }

    .inv-totals {
        width: 300px;
        margin: 28px 48px 0 auto;
        margin-inline-start: auto;
        margin-inline-end: 48px;
    }

    .inv-totals .row-line {
        display: flex;
        justify-content: space-between;
        padding: 8px 4px;
        color: #3f4254;
    }

    .inv-totals .row-line.grand {
        border-top: 3px solid var(--inv-blue);
        margin-top: 6px;
        padding-top: 12px;
        font-weight: 900;
        font-size: 1.15rem;
        color: #12244F;
    }

    .inv-pay {
        padding: 40px 48px 0;
        margin-top: auto;
    }

    .inv-pay .head {
        color: var(--inv-blue);
        font-weight: 800;
        margin-bottom: 6px;
        font-size: 1.05rem;
    }

    .inv-pay .line {
        color: #3f4254;
        line-height: 2;
    }

    .inv-bottom-band {
        margin-top: 32px;
        display: flex;
        justify-content: flex-start;
    }

    .inv-bottom-band .bar {
        background: var(--inv-yellow);
        height: 56px;
        width: 45%;
        border-radius: 0 12px 0 0;
    }

    @@media print {
        body * {
            visibility: hidden;
        }

        .inv-sheet, .inv-sheet * {
            visibility: visible;
        }

        .inv-sheet {
            position: absolute;
            inset: 0;
            width: 100%;
            max-width: 100%;
            box-shadow: none;
            border-radius: 0;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-5" style="max-width:800px;margin:0 auto;">
    <h3 class="m-0">تفاصيل الفاتورة</h3>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary" onclick="window.print()">
            <i class="fas fa-print me-1"></i> طباعة
        </button>
        <a asp-action="Index" class="btn btn-light">رجوع</a>
    </div>
</div>

<div class="inv-sheet">
    <!-- Header: contact info + yellow title band -->
    <div class="inv-top">
        <div class="inv-contact">
            @if (!string.IsNullOrWhiteSpace(setting?.Email))
            {
                <div>@setting.Email</div>
            }
            @if (!string.IsNullOrWhiteSpace(setting?.Address))
            {
                <div>@setting.Address</div>
            }
            @if (!string.IsNullOrWhiteSpace(setting?.PhoneNumber))
            {
                <div dir="ltr">@setting.PhoneNumber</div>
            }
        </div>
        <div class="inv-title-band">
            <h1>فاتورة</h1>
        </div>
    </div>

    <!-- Bill to -->
    <div class="inv-billto">
        <div class="name">@customerName</div>
        @if (!string.IsNullOrWhiteSpace(customerAddress))
        {
            <div class="addr">@customerAddress</div>
        }
    </div>

    <!-- Invoice number + date -->
    <div class="inv-no">
        فاتورة <span>#@Model.InvoiceNo.ToString("000000")</span>
        @if (Model.CreatedAt.HasValue)
        {
            <span style="background:none;color:#3f4254;font-weight:600;margin-inline-start:16px;">@Model.CreatedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
        }
    </div>

    <!-- Items -->
    <table class="inv-table">
        <thead>
            <tr>
                <th>الوصف</th>
                <th>الكمية</th>
                <th>السعر</th>
                <th>الإجمالي</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td>@item.Description</td>
                    <td>@item.Qty</td>
                    <td>
                        @item.Price.ToString("N2")                         <svg class="riyal-svg currency" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 78.917 78.917" width="15" height="15" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-0.125em"><path d="M32.501,16.458H9.021L9,66.958c0,2.48-2.019,4.5-4.5,4.5s-4.5-2.02-4.5-4.5l0.025-55.005c0.003-2.479,2.021-4.495,4.5-4.495h27.977c13.51,0,24.5,10.991,24.5,24.5v23c0,2.48-2.02,4.5-4.5,4.5s-4.5-2.02-4.5-4.5v-23C48.001,23.412,41.048,16.458,32.501,16.458z M74.417,7.458c-2.481,0-4.5,2.019-4.5,4.5l-0.021,50.5h-23.48c-8.547,0-15.5-6.953-15.5-15.5v-23c0-2.481-2.019-4.5-4.5-4.5s-4.5,2.019-4.5,4.5v23c0,13.509,10.99,24.5,24.5,24.5h27.977c2.479,0,4.498-2.016,4.5-4.495l0.024-55.005C78.917,9.478,76.898,7.458,74.417,7.458z" /></svg>
                    </td>
                    <td>
                        @item.Total.ToString("N2")                         <svg class="riyal-svg currency" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 78.917 78.917" width="15" height="15" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-0.125em"><path d="M32.501,16.458H9.021L9,66.958c0,2.48-2.019,4.5-4.5,4.5s-4.5-2.02-4.5-4.5l0.025-55.005c0.003-2.479,2.021-4.495,4.5-4.495h27.977c13.51,0,24.5,10.991,24.5,24.5v23c0,2.48-2.02,4.5-4.5,4.5s-4.5-2.02-4.5-4.5v-23C48.001,23.412,41.048,16.458,32.501,16.458z M74.417,7.458c-2.481,0-4.5,2.019-4.5,4.5l-0.021,50.5h-23.48c-8.547,0-15.5-6.953-15.5-15.5v-23c0-2.481-2.019-4.5-4.5-4.5s-4.5,2.019-4.5,4.5v23c0,13.509,10.99,24.5,24.5,24.5h27.977c2.479,0,4.498-2.016,4.5-4.495l0.024-55.005C78.917,9.478,76.898,7.458,74.417,7.458z" /></svg>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Totals -->
    <div class="inv-totals">
        <div class="row-line">
            <span>إجمالي</span>
            <span>
                @subTotal.ToString("N2")
                <svg class="riyal-svg currency" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 78.917 78.917" width="15" height="15" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-0.125em"><path d="M32.501,16.458H9.021L9,66.958c0,2.48-2.019,4.5-4.5,4.5s-4.5-2.02-4.5-4.5l0.025-55.005c0.003-2.479,2.021-4.495,4.5-4.495h27.977c13.51,0,24.5,10.991,24.5,24.5v23c0,2.48-2.02,4.5-4.5,4.5s-4.5-2.02-4.5-4.5v-23C48.001,23.412,41.048,16.458,32.501,16.458z M74.417,7.458c-2.481,0-4.5,2.019-4.5,4.5l-0.021,50.5h-23.48c-8.547,0-15.5-6.953-15.5-15.5v-23c0-2.481-2.019-4.5-4.5-4.5s-4.5,2.019-4.5,4.5v23c0,13.509,10.99,24.5,24.5,24.5h27.977c2.479,0,4.498-2.016,4.5-4.495l0.024-55.005C78.917,9.478,76.898,7.458,74.417,7.458z" /></svg>
            </span>
        </div>
        @if (discount > 0)
        {
            <div class="row-line">
                <span>الخصم</span>
                <span>
                    - @discount.ToString("N2")
                    <svg class="riyal-svg currency" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 78.917 78.917" width="15" height="15" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-0.125em"><path d="M32.501,16.458H9.021L9,66.958c0,2.48-2.019,4.5-4.5,4.5s-4.5-2.02-4.5-4.5l0.025-55.005c0.003-2.479,2.021-4.495,4.5-4.495h27.977c13.51,0,24.5,10.991,24.5,24.5v23c0,2.48-2.02,4.5-4.5,4.5s-4.5-2.02-4.5-4.5v-23C48.001,23.412,41.048,16.458,32.501,16.458z M74.417,7.458c-2.481,0-4.5,2.019-4.5,4.5l-0.021,50.5h-23.48c-8.547,0-15.5-6.953-15.5-15.5v-23c0-2.481-2.019-4.5-4.5-4.5s-4.5,2.019-4.5,4.5v23c0,13.509,10.99,24.5,24.5,24.5h27.977c2.479,0,4.498-2.016,4.5-4.495l0.024-55.005C78.917,9.478,76.898,7.458,74.417,7.458z" /></svg>
                </span>
            </div>
        }
        @if (deliveryFee > 0)
        {
            <div class="row-line">
                <span>رسوم التوصيل</span>
                <span>
                    @deliveryFee.ToString("N2")
                    <svg class="riyal-svg currency" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 78.917 78.917" width="15" height="15" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-0.125em"><path d="M32.501,16.458H9.021L9,66.958c0,2.48-2.019,4.5-4.5,4.5s-4.5-2.02-4.5-4.5l0.025-55.005c0.003-2.479,2.021-4.495,4.5-4.495h27.977c13.51,0,24.5,10.991,24.5,24.5v23c0,2.48-2.02,4.5-4.5,4.5s-4.5-2.02-4.5-4.5v-23C48.001,23.412,41.048,16.458,32.501,16.458z M74.417,7.458c-2.481,0-4.5,2.019-4.5,4.5l-0.021,50.5h-23.48c-8.547,0-15.5-6.953-15.5-15.5v-23c0-2.481-2.019-4.5-4.5-4.5s-4.5,2.019-4.5,4.5v23c0,13.509,10.99,24.5,24.5,24.5h27.977c2.479,0,4.498-2.016,4.5-4.495l0.024-55.005C78.917,9.478,76.898,7.458,74.417,7.458z" /></svg>
                </span>
            </div>
        }
        <div class="row-line grand">
            <span>القيمة</span>
            <span>
                @Model.InvoiceAmount.ToString("N2")
                <svg class="riyal-svg currency" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 78.917 78.917" width="15" height="15" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-0.125em"><path d="M32.501,16.458H9.021L9,66.958c0,2.48-2.019,4.5-4.5,4.5s-4.5-2.02-4.5-4.5l0.025-55.005c0.003-2.479,2.021-4.495,4.5-4.495h27.977c13.51,0,24.5,10.991,24.5,24.5v23c0,2.48-2.02,4.5-4.5,4.5s-4.5-2.02-4.5-4.5v-23C48.001,23.412,41.048,16.458,32.501,16.458z M74.417,7.458c-2.481,0-4.5,2.019-4.5,4.5l-0.021,50.5h-23.48c-8.547,0-15.5-6.953-15.5-15.5v-23c0-2.481-2.019-4.5-4.5-4.5s-4.5,2.019-4.5,4.5v23c0,13.509,10.99,24.5,24.5,24.5h27.977c2.479,0,4.498-2.016,4.5-4.495l0.024-55.005C78.917,9.478,76.898,7.458,74.417,7.458z" /></svg>
            </span>
        </div>
    </div>

    <!-- Payment info -->
    <div class="inv-pay">
        <div class="head">معلومات الدفع</div>
        <div class="line">طريقة الدفع: @paymentMethod</div>
        <div class="line">حالة الدفع: @paymentStatus</div>
        <div class="line">نوع الفاتورة: @(Model.InvoiceType?.GetDisplayName() ?? "-")</div>
        <div class="line">@centerName</div>
    </div>

    <!-- Bottom yellow accent -->
    <div class="inv-bottom-band">
        <div class="bar"></div>
    </div>
</div>
