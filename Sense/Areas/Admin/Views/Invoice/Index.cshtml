@using Sense.Domain.Enums
@using Sense.Application.DTOs.SupervisorDTOs
@using Sense.Infrastructure.Extensions
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "فواتير الصيانة";
    var supervisors = ViewBag.Supervisors as List<SupervisorDto>;
}

<div class="card mb-5">
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">جدول فواتير المتجر</span>
            <span class="text-muted mt-1 fw-semibold fs-7">قم بتصفية الفواتير حسب البيانات المتوفرة.</span>
        </h3>
    </div>
    <div class="card-body">
        <!-- الفلاتر -->
        <form id="filterForm" class="row gx-3 gy-2 mb-4 align-items-end">
            <div class="col-md-2">
                <label class="form-label">المشرف</label>
                <select id="SupervisorId" name="SupervisorId" class="form-select">
                    <option value="">-- الكل --</option>
                    @foreach (var supervisor in supervisors)
                    {
                        <option value="@supervisor.Id">@supervisor.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">نوع الفاتورة</label>
                <select id="InvoiceType" name="InvoiceType" class="form-select">
                    <option value="">-- الكل --</option>
                    @foreach (InvoiceType type in Enum.GetValues(typeof(InvoiceType)))
                    {
                        <option value="@( (int)type )">@type.GetDisplayName()</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">رقم الفاتورة</label>
                <input type="text" id="InvoiceNo" name="InvoiceNo" class="form-control" placeholder="مثال: 1024" />
            </div>
            <div class="col-md-2">
                <label class="form-label">من تاريخ</label>
                <input type="date" id="StartDate" name="StartDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">إلى تاريخ</label>
                <input type="date" id="EndDate" name="EndDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="button" id="filterButton" class="btn btn-primary">فلتر</button>
            </div>
        </form>
        <div id="supervisorTotalCard" class="card border-primary mb-4 d-none">
            <div class="card-body text-center">
                <h5 class="card-title fw-bold">إحصائيات المشرف</h5>
                <p class="card-text mb-1">
                    💰 <strong>إجمالي قيمة الفواتير:</strong> <span id="supervisorTotalAmount">0.00</span>                         <svg class="riyal-svg currency" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 78.917 78.917" width="15" height="15" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-0.125em"><path d="M32.501,16.458H9.021L9,66.958c0,2.48-2.019,4.5-4.5,4.5s-4.5-2.02-4.5-4.5l0.025-55.005c0.003-2.479,2.021-4.495,4.5-4.495h27.977c13.51,0,24.5,10.991,24.5,24.5v23c0,2.48-2.02,4.5-4.5,4.5s-4.5-2.02-4.5-4.5v-23C48.001,23.412,41.048,16.458,32.501,16.458z M74.417,7.458c-2.481,0-4.5,2.019-4.5,4.5l-0.021,50.5h-23.48c-8.547,0-15.5-6.953-15.5-15.5v-23c0-2.481-2.019-4.5-4.5-4.5s-4.5,2.019-4.5,4.5v23c0,13.509,10.99,24.5,24.5,24.5h27.977c2.479,0,4.498-2.016,4.5-4.495l0.024-55.005C78.917,9.478,76.898,7.458,74.417,7.458z" /></svg>
                </p>
                <p class="card-text">
                    🧾 <strong>عدد الفواتير:</strong> <span id="supervisorInvoiceCount">0</span> فاتورة
                </p>
            </div>
        </div>

        <!-- جدول الفواتير -->
        <div class="table-responsive">
            <table id="invoicesTable" class="table table-row-dashed table-row-gray-300">
                <thead>
                    <tr class="fw-bold text-muted bg-light">
                        <th>رقم الفاتورة</th>
                        <th>رقم الطلب</th>
                        <th>اسم العميل</th>
                        <th>اسم المشرف</th>
                        <th>نوع الفاتورة</th>
                        <th>مبلغ الفاتورة</th>
                        <th>التاريخ</th>
                        <th>الوقت</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody class="text-center">
                    <!-- البيانات سيتم تحميلها عبر AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Adding padding to the table rows */
        #invoicesTable td, #invoicesTable th {
            padding: 12px 15px;
        }

        /* Optional: you can also add padding to table header */
        #invoicesTable th {
            padding-top: 16px;
            padding-bottom: 16px;
        }

        /* Optional: Adding a slight border between rows for better visibility */
        #invoicesTable tbody tr {
            border-bottom: 1px solid #e1e1e1;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#invoicesTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("LoadInvoices", "Invoice", new { area = "Admin" })',
                    type: 'POST',
                    data: function (d) {
                        d.SupervisorId = $('#SupervisorId').val();
                        d.StartDate = $('#StartDate').val();
                        d.EndDate = $('#EndDate').val();
                        d.InvoiceNo = $('#InvoiceNo').val();
                        d.InvoiceType = $('#InvoiceType').val();
                    },
                    dataSrc: function (json) {
                        const supervisorId = $('#SupervisorId').val();
                        if (supervisorId && json.supervisorTotal) {
                            $('#supervisorTotalAmount').text(json.supervisorTotal);
                            $('#supervisorInvoiceCount').text(json.supervisorCount);
                            $('#supervisorTotalCard').removeClass('d-none');
                        } else {
                            $('#supervisorTotalCard').addClass('d-none');
                        }
                        return json.data;
                    }
                },
                columns: [
                    { data: 'id' },
                    { data: 'orderNo' },
                    { data: 'customerName' },
                    { data: 'supervisorName' },
                    { data: 'invoiceType' },
                    { data: 'invoiceAmount' },
                    { data: 'date' },
                    { data: 'time' },
                    {
                        data: 'id',
                        orderable: false,
                        render: function (data, type, row) {
                            const detailsUrl = '@Url.Action("Details", "Invoice", new { area = "Admin" })' + '?id=' + data;
                            return `
                                <a class="btn btn-sm btn-light-primary" href="${detailsUrl}" title="عرض الفاتورة">
                                    عرض
                                </a>
                            `;
                        }
                    }
                ],
                columnDefs: [
                   { targets: '_all', className: 'text-center' }
                ],
                language: {
                    url: '/js/datatables/i18n/ar.json'
                }
            });

            $('#filterButton').on('click', function () {
                table.ajax.reload();
            });

        });
    </script>
}
