@using Sense.Application.DTOs.StatementDTOs
@model IEnumerable<StatementDto>
@{
    var message = TempData["Message"];
    var errorMessage = TempData["ErrorMessage"];
}
<!--begin::Tables Widget 10-->
<div class="card mb-xl-8">
    <!--begin::Header-->
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">جدول عبارات الثقة</span>
            <span class="text-muted mt-1 fw-semibold fs-7">العبارات التي تظهر في الصفحة الرئيسية للمتجر والعمليات عليها.</span>
        </h3>
        <div class="card-toolbar" title="اضغط لإضافة عبارة">
            <a asp-area="admin" asp-controller="Statement" asp-action="add" class="btn btn-sm btn-light btn-active-primary">
                <i class="ki-duotone ki-plus fs-2"></i>عبارة جديدة
            </a>
        </div>
    </div>
    <!--end::Header-->
    <!--begin::Body-->
    <div class="card-body pt-3">
        <!--begin::Table container-->
        <div class="table-responsive">
            <!--begin::Table-->
            <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                <!--begin::Table head-->
                <thead>
                    <tr class="fw-bold text-muted bg-light">
                        <th class="ps-4 min-w-325px rounded-start">العبارة</th>
                        <th class="min-w-125px">الأيقونة</th>
                        <th class="min-w-100px">الترتيب</th>
                        <th class="min-w-100px">الحالة</th>
                        <th class="min-w-200px text-end rounded-end"></th>
                    </tr>
                </thead>
                <!--end::Table head-->
                <!--begin::Table body-->
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="text-gray-900 fw-bold fs-6 ps-4">@item.Text</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.IconClass))
                                {
                                    <i class="@item.IconClass fs-2 me-2"></i>
                                    <span class="text-muted fs-7">@item.IconClass</span>
                                }
                                else
                                {
                                    <span class="text-muted fs-7">-</span>
                                }
                            </td>
                            <td>
                                <span class="badge badge-light-primary fs-7 fw-bold">@item.SortOrder</span>
                            </td>
                            <td>
                                <span id="status-badge-@item.Id"
                                      class="badge toggle-status @(item.IsActive ? "bg-success" : "bg-danger") fs-7 fw-bold"
                                      data-id="@item.Id"
                                      role="button"
                                      style="cursor: pointer;color:white;"
                                      title="اضغط لتغيير حالة العبارة">
                                    @(item.IsActive ? "نشطة" : "معطلة")
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-area="admin" asp-controller="Statement" asp-action="edit" asp-route-id="@item.Id"
                                   class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1" title="تعديل العبارة">
                                    <i class="ki-duotone ki-pencil fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                </a>
                                <a data-id="@item.Id" class="btn btn-delete btn-icon btn-bg-light btn-active-color-primary btn-sm" title="حذف العبارة">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                        <span class="path3"></span>
                                        <span class="path4"></span>
                                        <span class="path5"></span>
                                    </i>
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>
                <!--end::Table body-->
            </table>
            <!--end::Table-->
        </div>
        <!--end::Table container-->
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function () {

            toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-bottom-left",
                "preventDuplicates": true,
                "timeOut": "2000"
            };

            $(".btn-delete").on("click", function (e) {
                e.preventDefault();
                var $this = $(this);
                var id = $this.attr("data-id");
                Swal.fire({
                    title: 'هل أنت متأكد؟',
                    text: "سيتم حذف العبارة!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'نعم, قم بالحذف!',
                    cancelButtonText: 'إلغاء'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "@Url.Action("Delete", "Statement", new { area = "Admin" })/" + id,
                            type: 'DELETE',
                            success: function (result) {
                                if (result.success) {
                                    Swal.fire('تم الحذف!', 'تم حذف العبارة بنجاح.', 'success');
                                    $this.closest("tr").remove();
                                } else {
                                    Swal.fire('خطأ!', result.message || 'حدث خطأ أثناء حذف العبارة', 'error');
                                }
                            },
                            error: function () {
                                Swal.fire('خطأ!', 'حدث خطأ أثناء حذف العبارة', 'error');
                            }
                        });
                    }
                });
            });

            $('.toggle-status').click(function () {
                var button = $(this);
                var id = button.data('id');
                var isActive = button.hasClass('bg-success');

                Swal.fire({
                    title: 'هل أنت متأكد؟',
                    text: isActive ? "سيتم إخفاء العبارة من الصفحة الرئيسية" : "سيتم إظهار العبارة في الصفحة الرئيسية",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: isActive ? 'نعم، قم بالتعطيل' : 'نعم، قم بالتفعيل',
                    cancelButtonText: 'إلغاء'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "@Url.Action("ChangeStatus", "Statement", new { area = "Admin" })/" + id,
                            type: 'PUT',
                            success: function (response) {
                                if (!response.success) {
                                    toastr.error(response.message || "حدث خطأ أثناء تغيير حالة العبارة.");
                                    return;
                                }
                                toastr.success(response.message);

                                const badge = $('#status-badge-' + id);
                                const isNowActive = badge.hasClass('bg-danger');

                                badge.removeClass('bg-success bg-danger');
                                badge.addClass(isNowActive ? 'bg-success' : 'bg-danger');
                                badge.text(isNowActive ? 'نشطة' : 'معطلة');
                            },
                            error: function () {
                                toastr.error("حدث خطأ أثناء تغيير حالة العبارة.");
                            }
                        });
                    }
                });
            });
        });

        document.addEventListener("DOMContentLoaded", function () {
            var message = '@message';
            if (message) {
                Swal.fire({
                    icon: 'success',
                    title: 'تم',
                    text: message,
                    showConfirmButton: false,
                    timer: 1500
                });
            }
            var errorMessage = '@errorMessage';
            if (errorMessage) {
                Swal.fire({
                    icon: "error",
                    title: "خطأ",
                    text: errorMessage,
                    timer: 1500
                });
            }
        });
    </script>
}
