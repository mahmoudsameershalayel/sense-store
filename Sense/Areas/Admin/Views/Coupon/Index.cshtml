@using Sense.Application.DTOs.CouponDTOs
@model List<CouponDto>
@{
    var message = TempData["Message"];
    var errorMessage = TempData["ErrorMessage"];
}
<!--begin::Tables Widget 10-->
<div class="card mb-xl-8">
    <!--begin::Header-->
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">جدول كوبونات الخصم</span>
            <span class="text-muted mt-1 fw-semibold fs-7">يحتوي هذا الجدول على جميع بيانات كوبونات الخصم والعمليات عليها.</span>
        </h3>
        <div class="card-toolbar" title="اضغط لإضافة كوبون خصم">
            <button class="btn btn-sm btn-light btn-active-primary" data-bs-toggle="modal" data-bs-target="#couponModal">
                <i class="ki-duotone ki-plus fs-2"></i>كوبون خصم جديد
            </button>
        </div>
    </div>
    <!--end::Header-->
    <!--begin::Body-->
    <div class="card-body pt-3">
        <!--begin::Table container-->
        <div class="table-responsive">
            <!--begin::Table-->
            <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                <!--begin::Table head-->
                <thead>
                    <tr class="fw-bold text-muted bg-light">
                        <th class="ps-4 min-w-100px rounded-start">الكوبون</th>
                        <th class="min-w-100px">القيمة</th>
                        <th class="min-w-105px">النوع</th>
                        <th class="min-w-100px">الإستخدامات المسموحة لكل عميل</th>
                        <th class="min-w-105px">تاريخ البدء</th>
                        <th class="min-w-100px">تاريخ الإنتهاء</th>
                        <th class="min-w-100px">الفعالية</th>
                        <th class="min-w-80px"></th>
                    </tr>

                </thead>
                <!--end::Table head-->
                <!--begin::Table body-->
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="d-flex justify-content-start flex-column">
                                        <a href="#" class="text-gray-900 fw-bold text-hover-primary mb-1 fs-6">@item.CouponCode</a>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <a href="#" class="text-gray-900 fw-bold text-hover-primary d-block mb-1 fs-6">@item.DiscountAmount</a>
                            </td>
                            <td>
                                <span class="badge badge-light-primary fs-7 fw-bold">@item.DiscountType</span>
                            </td>
                            <td>
                                <span class="badge badge-light-primary fs-7 fw-bold">@item.PerUser</span>
                            </td>
                            <td>
                                <a href="#" class="text-gray-900 fw-bold text-hover-primary d-block mb-1 fs-6">@item.StartDate</a>
                            </td>
                            <td>
                                <a href="#" class="text-gray-900 fw-bold text-hover-warning d-block mb-1 fs-6">@item.EndDate</a>
                            </td>
                            <td>
                                <span id="status-badge-@item.Id"
                                      class="badge toggle-status @(item.IsActive ? "bg-success" : "bg-danger") fs-7 fw-bold"
                                      data-id="@item.Id"
                                      role="button"
                                      style="cursor: pointer;color:white;"
                                      title="اضغط لتغيير حالة العرض">
                                    @(item.IsActive ? "نشط" : "معطل")
                                </span>
                            </td>


                            <td class="text-end">
                                @{
                                    // DiscountType is a string: "Percentage" or "Fixed"
                                    var discountTypeValue = item.DiscountType == "Percentage" ? "1" : "2";

                                    // Dates are already strings, just need to format them for input[type="date"]
                                    var startDateValue = "";
                                    var endDateValue = "";

                                    if (!string.IsNullOrEmpty(item.StartDate))
                                    {
                                        if (DateTime.TryParse(item.StartDate, out DateTime startDate))
                                        {
                                            startDateValue = startDate.ToString("yyyy-MM-dd");
                                        }
                                    }

                                    if (!string.IsNullOrEmpty(item.EndDate))
                                    {
                                        if (DateTime.TryParse(item.EndDate, out DateTime endDate))
                                        {
                                            endDateValue = endDate.ToString("yyyy-MM-dd");
                                        }
                                    }
                                }
                                <a href="#"
                                   class="btn btn-edit btn-icon btn-bg-light btn-active-color-primary btn-sm me-1"
                                   data-id="@item.Id"
                                   data-code="@item.CouponCode"
                                   data-type="@discountTypeValue"
                                   data-amount="@item.DiscountAmount"
                                   data-peruser="@item.PerUser"
                                   data-startdate="@startDateValue"
                                   data-enddate="@endDateValue"
                                   data-bs-toggle="modal"
                                   data-bs-target="#couponModal">
                                    <i class="ki-duotone ki-pencil fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                </a>
                                <a asp-route-id="@item.Id" data-id="@item.Id" class="btn btn-delete btn-icon btn-bg-light btn-active-color-primary btn-sm">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                        <span class="path3"></span>
                                        <span class="path4"></span>
                                        <span class="path5"></span>
                                    </i>
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>
                <!--end::Table body-->
            </table>
            <!--end::Table-->
        </div>
        <!--end::Table container-->
    </div>
</div>



<!-- Modal -->
<div class="modal fade" id="couponModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form id="couponForm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">إضافة كوبون خصم</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="couponId" value="" />
                    <div class="mb-3">
                        <label>كود الكوبون</label>
                        <input type="text" class="form-control" id="code" required />
                    </div>
                    <!-- Cashback Type -->
                    <div class="mb-3">
                        <label for="disType" class="form-label">نوع الخصم</label>
                        <select class="form-select" id="disType" required>
                            <option value="2">ثابت</option>
                            <option value="1">نسبة مئوية</option>
                        </select>
                    </div>

                    <!-- Cashback Value -->
                    <div class="mb-3">
                        <label for="disVal" class="form-label">قيمة الخصم</label>
                        <input type="number" step="0.01" class="form-control" id="disVal" required />
                    </div>
                    <!-- Cashback Value -->
                    <div class="mb-3">
                        <label for="perUser" class="form-label">الإستخدامات المسموحة لكل عميل</label>
                        <input type="number" step="any" class="form-control" id="perUser" required />
                    </div>
                    <!-- Start Date -->
                    <div class="mb-3">
                        <label for="startDate" class="form-label">تاريخ البداية</label>
                        <input type="date" class="form-control" id="startDate" />
                    </div>

                    <!-- End Date -->
                    <div class="mb-3">
                        <label for="endDate" class="form-label">تاريخ النهاية</label>
                        <input type="date" class="form-control" id="endDate" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary" id="submitBtn">إضافة الكوبون</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            toastr.options = {
                "closeButton": true,
                "debug": false,
                "newestOnTop": false,
                "progressBar": true,
                "positionClass": "toast-bottom-left",
                "preventDuplicates": true,
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "2000",
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut"
            };

            $('.toggle-status').click(function () {
                var button = $(this);
                var id = button.data('id');

                $.ajax({
                    url: "@Url.Action("ChangeStatus", "Coupon", new { area = "Admin" })/" + id,
                    type: 'PUT',
                    success: function (response) {
                        toastr.success(response.message);

                        // Toggle badge content and style
                        const badge = $('#status-badge-' + id);
                        const isNowActive = badge.hasClass('bg-danger');

                        badge.removeClass('bg-success bg-danger');
                        badge.addClass(isNowActive ? 'bg-success' : 'bg-danger');
                        badge.text(isNowActive ? 'نشط' : 'معطل');
                    },
                    error: function () {
                        toastr.error("حدث خطأ أثناء تغيير حالة الحساب.");
                    }
                });
            });

            // Reset modal for create mode when "New Coupon" button is clicked
            $('[data-bs-target="#couponModal"]').not('.btn-edit').on('click', function() {
                $('#modalTitle').text('إضافة كوبون خصم');
                $('#submitBtn').text('إضافة الكوبون');
                $('#couponId').val('');
                $('#couponForm')[0].reset();
            });

            // Populate modal with coupon data for editing
            $('.btn-edit').on('click', function() {
                const btn = $(this);
                $('#modalTitle').text('تعديل كوبون خصم');
                $('#submitBtn').text('تحديث الكوبون');

                $('#couponId').val(btn.data('id'));
                $('#code').val(btn.data('code'));
                $('#disType').val(btn.data('type'));
                $('#disVal').val(btn.data('amount'));
                $('#perUser').val(btn.data('peruser'));
                $('#startDate').val(btn.data('startdate') || '');
                $('#endDate').val(btn.data('enddate') || '');
            });

            $('#couponForm').on('submit', function (e) {
                e.preventDefault();

                const couponId = $('#couponId').val();
                const isEdit = couponId !== '';

                const dto = {
                    couponCode: $('#code').val(),
                    discountType: parseInt($('#disType').val()),
                    discountAmount: parseFloat($('#disVal').val()),
                    perUser: parseInt($('#perUser').val()),
                    startDate: $('#startDate').val() || null,
                    endDate: $('#endDate').val() || null
                };

                // Add ID for edit mode
                if (isEdit) {
                    dto.id = parseInt(couponId);
                }

                console.log(dto);

                $.ajax({
                    url: isEdit
                        ? '@Url.Action("Edit", "Coupon", new { area = "Admin" })'
                        : '@Url.Action("Add", "Coupon", new { area = "Admin" })',
                    type: isEdit ? 'PUT' : 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    success: function (response) {
                        Swal.fire({
                            icon: 'success',
                            title: isEdit ? 'تم التحديث' : 'تمت الإضافة',
                            text: isEdit ? 'تم تحديث كوبون الخصم بنجاح.' : 'تمت إضافة كوبون الخصم بنجاح.',
                            timer: 3000
                        });

                        $('#couponModal').modal('hide');
                        $('#couponForm')[0].reset();
                        window.location.reload();
                    },
                    error: function (xhr) {
                        Swal.fire({
                            icon: 'error',
                            title: 'خطأ',
                            text: isEdit ? 'حدث خطأ أثناء تحديث الكوبون.' : 'حدث خطأ أثناء إضافة الكوبون.',
                            timer: 3000
                        });
                    }
                });
            });

            $(".btn-delete").on("click", function (e) {
                $this = $(this);
                var id = $(this).attr("data-id");
                Swal.fire({
                    title: 'هل أنت متأكد?',
                    text: "سيتم حذف هذا الكوبون بشكل نهائي!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'نعم, قم بالحذف!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "@Url.Action("Delete", "Coupon", new { area = "Admin" })/" + id,
                            type: 'DELETE',
                            success: function (result) {
                                Swal.fire(
                                    'تم الحذف!',
                                    'تم حذف العرض بنجاح.',
                                    'success'
                                )
                                console.log($this.closest("tr").remove());
                            }
                        });
                    }
                })
                e.preventDefault();
            });
            $(".btn-pge").on("click", function (e) {
                $this = $(this);
                var pg = $(this).attr("data-pg");
                if (result.isConfirmed) {
                    $.ajax({
                        url: "@Url.Action("Index", "CashbackOffer", new { area = "Admin" })/" + pg,
                        type: 'POST'

                    });
                }
            })
            e.preventDefault();
        });
     

    </script>
}
