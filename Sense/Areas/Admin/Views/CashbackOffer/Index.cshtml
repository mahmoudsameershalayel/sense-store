}
<!--begin::Tables Widget 10-->
<div class="card mb-xl-8">
    <!--begin::Header-->
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">ÃœÊ· ⁄—Ê÷ «·ﬂ«‘ »«ﬂ</span>
            <span class="text-muted mt-1 fw-semibold fs-7">ÌÕ ÊÌ Â–« «·ÃœÊ· ⁄·Ï Ã„Ì⁄ »Ì«‰«  ⁄—Ê÷ «·ﬂ«‘ »«ﬂ Ê«·⁄„·Ì«  ⁄·ÌÂ«.</span>
        </h3>
        <div class="card-toolbar" title="«÷€ÿ ·≈÷«›… ⁄—÷ ﬂ«‘ »«ﬂ">
            <button class="btn btn-sm btn-light btn-active-primary" data-bs-toggle="modal" data-bs-target="#cashbackModal">
                <i class="ki-duotone ki-plus fs-2"></i>⁄—÷ ﬂ«‘ »«ﬂ ÃœÌœ
            </button>
        </div>
    </div>
    <!--end::Header-->
    <!--begin::Body-->
    <div class="card-body pt-3">
        <!--begin::Table container-->
        <div class="table-responsive">
            <!--begin::Table-->
            <table id="cashbackOffersTable" class="table table-row-dashed table-row-gray-300 align-middle text-center gs-0 gy-4">
                <thead>
                    <tr class="fw-bold text-muted bg-light">
                        <th class="ps-4 min-w-100px rounded-start">«·⁄—÷</th>
                        <th class="min-w-125px">«·ﬁÌ„…</th>
                        <th class="min-w-125px">«·‰Ê⁄</th>
                        <th class="min-w-125px">«·ﬁÌ„… «·„—Ã⁄…</th>
                        <th class="min-w-150px">ŒÌ«—«  «· ÿ»Ìﬁ</th>
                        <th class="min-w-125px"> «—ÌŒ «·»œ¡</th>
                        <th class="min-w-125px"> «—ÌŒ «·≈‰ Â«¡</th>
                        <th class="min-w-125px">«·›⁄«·Ì…</th>
                        <th class="min-w-150px"></th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>

            <!--end::Table-->
        </div>
        <!--end::Table container-->
    </div>
</div>



<!-- Cashback Offer Modal -->
<div class="modal fade" id="cashbackModal" tabindex="-1" aria-labelledby="cashbackModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="cashbackForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="cashbackModalLabel">≈÷«›… ⁄—÷ ﬂ«‘ »«ﬂ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">

                    <div class="row">
                        <div class="col-md-6">
                            <!-- Cashback Type -->
                            <div class="mb-3">
                                <label for="cashbackType" class="form-label">‰Ê⁄ «·ﬂ«‘ »«ﬂ</label>
                                <select class="form-select" id="cashbackType" required>
                                    <option value="1">À«» </option>
                                    <option value="2">‰”»… „∆ÊÌ…</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <!-- Return Type -->
                            <div class="mb-3">
                                <label for="returnType" class="form-label">‰Ê⁄ «·ﬁÌ„… «·„—Ã⁄…</label>
                                <select class="form-select" id="returnType" required>
                                    @foreach (var status in Enum.GetValues(typeof(ReturnType)))
                                    {
                                        var enumStatus = (ReturnType)status;
                                        var display = enumStatus.GetDisplayName();
                                        var val = (int)enumStatus;
                                        <option value="@val">@display</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <!-- Cashback Value -->
                            <div class="mb-3">
                                <label for="cashbackVal" class="form-label">ﬁÌ„… «·ﬂ«‘ »«ﬂ</label>
                                <input type="number" step="0.01" class="form-control" id="cashbackVal" required />
                            </div>
                        </div>
                    </div>

                    <!-- Application Options -->
                    <div class="mb-4">
                        <label class="form-label">ŒÌ«—«  «· ÿ»Ìﬁ</label>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="isApplyOnSparePart">
                                    <label class="form-check-label" for="isApplyOnSparePart">
                                        Ìÿ»ﬁ ⁄·Ï ﬁÿ⁄ «·€Ì«—
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="isApplyOnLaborCost">
                                    <label class="form-check-label" for="isApplyOnLaborCost">
                                        Ìÿ»ﬁ ⁄·Ï  ﬂ·›… «·⁄„«·…
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="isApplyOnStore">
                                    <label class="form-check-label" for="isApplyOnStore">
                                        Ìÿ»ﬁ ⁄·Ï «·„ Ã—
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <!-- Start Date -->
                            <div class="mb-3">
                                <label for="startDate" class="form-label"> «—ÌŒ «·»œ«Ì…</label>
                                <input type="date" class="form-control" id="startDate" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <!-- End Date -->
                            <div class="mb-3">
                                <label for="endDate" class="form-label"> «—ÌŒ «·‰Â«Ì…</label>
                                <input type="date" class="form-control" id="endDate" />
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">≈÷«›… «·⁄—÷</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">≈·€«¡</button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function () {
             var table = $('#cashbackOffersTable').DataTable({
                processing: true,
                serverSide: true,
                autoWidth: false,
                ajax: {
                    url: '@Url.Action("LoadCashbackOffers", "CashbackOffer", new { area = "Admin" })',
                    type: 'POST'
                },
                columns: [
                    {
                        data: "id",
                        render: function(data, type, row) {
                            return `<div class="d-flex align-items-center">
                                <div class="symbol symbol-50px m-5">
                                    <img src="${row.imageURL || '/images/default-offer.png'}" alt="" />
                                </div>
                                <div class="d-flex justify-content-start flex-column">
                                    <a href="#" class="text-gray-900 fw-bold text-hover-primary mb-1 fs-6">${data}#</a>
                                </div>
                            </div>`;
                        }
                    },
                    { data: "cashbackVal" },
                    { data: "cashbackType" },
                    { data: "returnType" },
                    {
                        data: null,
                        render: function(data, type, row) {
                            var options = [];
                            if (row.isApplyOnSparePart) {
                                options.push('<span class="badge badge-primary text-white option-badge">ﬁÿ⁄ «·€Ì«—</span>');
                            }
                            if (row.isApplyOnLaborCost) {
                                options.push('<span class="badge badge-info text-white option-badge">«·⁄„«·…</span>');
                            }
                            if (row.isApplyOnStore) {
                                options.push('<span class="badge badge-success text-white option-badge">«·„ Ã—</span>');
                            }

                            if (options.length === 0) {
                                return '<span class="badge bg-secondary option-badge">€Ì— „Õœœ</span>';
                            }

                            return '<div class="application-options">' + options.join('') + '</div>';
                        }
                    },
                    { data: "startDate" },
                    { data: "endDate" },
                    {
                        data: "isActive",
                        render: function (data, type, row) {
                            let badgeClass = data ? "bg-success" : "bg-danger";
                            let text = data ? "‰‘ÿ" : "„⁄ÿ·";

                            return `<span id="status-badge-${row.id}"
                                          class="badge toggle-status ${badgeClass} fs-7 fw-bold"
                                          data-id="${row.id}"
                                          role="button"
                                          style="cursor:pointer; color:white;"
                                          title="«÷€ÿ · €ÌÌ— Õ«·… «·⁄—÷">${text}</span>`;
                        }
                    },
                    {
                        data: "id",
                        orderable: false,
                        render: function(data) {
                            const uploadUrl = '@Url.Action("UploadImage", "CashbackOffer", new { area = "Admin", id = "__id__" })';
                            const url = uploadUrl.replace("__id__", data);

                            return `<a href="${url}" class="btn btn-icon btn-sm btn-light-info" title="«—›⁄ ’Ê—… ··„‰ Ã">
                                        <i class="ki-duotone ki-switch fs-2">
                                            <span class="path1"></span><span class="path2"></span>
                                        </i>
                                    </a>

                                    <a data-id="${data}" class="btn btn-delete btn-icon btn-light-danger btn-sm">
                                        <i class="ki-duotone ki-trash fs-2">
                                            <span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span>
                                        </i>
                                    </a>`;
                        }
                    }
                ],
                language: {
                    url: "/js/datatables/i18n/ar.json"
                },
                order: [[0, "asc"]]
            });

            toastr.options = {
                "closeButton": true,
                "debug": false,
                "newestOnTop": false,
                "progressBar": true,
                "positionClass": "toast-bottom-left",
                "preventDuplicates": true,
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "2000",
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut"
            };

            $('#cashbackOffersTable tbody').on('click', '.toggle-status', function () {
                var button = $(this);
                var id = button.data('id');

                $.ajax({
                    url: "@Url.Action("ChangeStatus", "CashbackOffer", new { area = "Admin" })/" + id,
                    type: 'PUT',
                    success: function (response) {
                        toastr.success(response.message);

                        const badge = $('#status-badge-' + id);
                        const isNowActive = badge.hasClass('bg-danger');

                        badge.removeClass('bg-success bg-danger');
                        badge.addClass(isNowActive ? 'bg-success' : 'bg-danger');
                        badge.text(isNowActive ? '‰‘ÿ' : '„⁄ÿ·');
                    },
                    error: function () {
                        toastr.error("ÕœÀ Œÿ√ √À‰«¡  €ÌÌ— Õ«·… «·Õ”«».");
                    }
                });
            });

            $('#cashbackForm').on('submit', function (e) {
                e.preventDefault();

                const dto = {
                    cashbackType: parseInt($('#cashbackType').val()),
                    returnType: parseInt($('#returnType').val()),
                    cashbackVal: parseFloat($('#cashbackVal').val()),
                    isApplyOnSparePart: $('#isApplyOnSparePart').is(':checked'),
                    isApplyOnLaborCost: $('#isApplyOnLaborCost').is(':checked'),
                    isApplyOnStore: $('#isApplyOnStore').is(':checked'),
                    startDate: $('#startDate').val() || null,
                    endDate: $('#endDate').val() || null
                };

                $.ajax({
                    url: '@Url.Action("Add", "CashbackOffer", new { area = "Admin" })',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    success: function (response) {
                        Swal.fire({
                            icon: 'success',
                            title: ' „  «·≈÷«›…',
                            text: ' „  ≈÷«›… ⁄—÷ «·ﬂ«‘ »«ﬂ »‰Ã«Õ.',
                            timer: 3000
                        });
                        $('#cashbackModal').modal('hide');
                        $('#cashbackForm')[0].reset();
                        table.ajax.reload(null, false);
                    },
                    error: function (xhr) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Œÿ√',
                            text: 'ÕœÀ Œÿ√ √À‰«¡ ≈÷«›… «·⁄—÷.',
                            timer: 3000
                        });
                    }
                });
            });

            $('#cashbackOffersTable tbody').on('click', '.btn-delete', function (e) {
                $this = $(this);
                var id = $(this).attr("data-id");
                Swal.fire({
                    title: 'Â· √‰  „ √ﬂœ?',
                    text: "”Ì „ Õ–› Â–« «·⁄—÷ »‘ﬂ· ‰Â«∆Ì!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: '‰⁄„, ﬁ„ »«·Õ–›!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "@Url.Action("Delete", "CashbackOffer", new { area = "Admin" })/" + id,
                            type: 'DELETE',
                            success: function (result) {
                                Swal.fire(
                                    ' „ «·Õ–›!',
                                    ' „ Õ–› «·⁄—÷ »‰Ã«Õ.',
                                    'success'
                                )
                                table.ajax.reload(null, false);
                            }
                        });
                    }
                })
                e.preventDefault();
            });

            $(".btn-pge").on("click", function (e) {
                $this = $(this);
                var pg = $(this).attr("data-pg");
                if (result.isConfirmed) {
                    $.ajax({
                        url: "@Url.Action("Index", "CashbackOffer", new { area = "Admin" })/" + pg,
                        type: 'POST'
                    });
                }
                e.preventDefault();
            });
        });

        document.addEventListener("DOMContentLoaded", function () {
            var message = '@message';
            if (message) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: message,
                    showConfirmButton: false,
                    timer: 1500
                });
            }
        });

        document.addEventListener("DOMContentLoaded", function () {
            var message = '@errorMessage';
            if (message) {
                Swal.fire({
                    icon: "error",
                    title: "Oops...",
                    text: message,
                    timer: 1500
                });
            }
        });
    </script>
}