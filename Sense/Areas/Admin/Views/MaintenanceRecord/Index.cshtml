@using Sense.Application.DTOs.MaintenanceRecordDTOs
@using Sense.Application.DTOs.SupervisorDTOs
@model List<MaintenanceRecordDto>
@{
    var message = TempData["Message"];
    var errorMessage = TempData["ErrorMessage"];
    var supervisors = ViewBag.Supervisors as List<SupervisorDto>;

    var totalPages = ViewBag.TotalPages;
    var currentPage = ViewBag.CurrentPage;
    var serviceType = Context.Request.Query["ServiceType"];
    var appointmentStatus = Context.Request.Query["Status"];
    var brandId = Context.Request.Query["BrandId"];
}
<!--begin::Tables Widget 10-->
<div class="card mb-xl-8">
    <!--begin::Header-->
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">جدول فواتير الصيانة</span>
            <span class="text-muted mt-1 fw-semibold fs-7">يحتوي هذا الجدول على جميع بيانات الفواتير.</span>
        </h3>
    </div>
    <!--end::Header-->
    <!--begin::Body-->
    <div class="card-body pt-3">
        <form id="filterForm" method="get" asp-action="Index" class="mb-4">
            <div class="row gx-3 gy-2 align-items-end">
                <!-- Invoice Number Filter -->
                <div class="col-md-2">
                    <label for="InvoiceNo" class="form-label">رقم الفاتورة</label>
                    <input type="text" class="form-control" id="InvoiceNo" name="InvoiceNo" placeholder="رقم الفاتورة">
                </div>
                <!-- Supervisor Filter -->
                <div class="col-md-2">
                    <label for="SupervisorId" class="form-label">المشرف</label>
                    <select class="form-select" name="SupervisorId" id="SupervisorId">
                        <option value="">-- الكل --</option>
                        @foreach (var user in supervisors)
                        {
                            <option value="@user.Id">@user.FullName</option>
                        }
                    </select>
                </div>
                <!-- From Date Filter -->
                <div class="col-md-2">
                    <label for="scheduledDateStart" class="form-label">من تاريخ</label>
                    <input type="date" id="scheduledDateStart" name="StartDate" class="form-control">
                </div>

                <!-- To Date Filter -->
                <div class="col-md-2">
                    <label for="scheduledDateEnd" class="form-label">إلى تاريخ</label>
                    <input type="date" id="scheduledDateEnd" name="EndDate" class="form-control">
                </div>

                <!-- Filter Button -->
                <div class="col-md-2">
                    <button type="button" id="filterButton" class="btn btn-primary w-100">فلتر</button>
                </div>
            </div>
        </form>

        <!--begin::Table container-->
        <div class="table-responsive">
            <!--begin::Table-->
            <table id="maintenancesTable"
                   class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-1 text-center">
                <thead>
                    <tr class="fw-bold text-muted bg-light">
                        <th>رقم سجل الصيانة</th>
                        <th>إسم العميل</th>
                        <th>إسم المشرف</th>
                        <th>تاريخ بدء الصيانة</th>
                        <th>وقت البدء</th>
                        <th>تاريخ الإنتهاء</th>
                        <th>وقت الإنتهاء</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
            </table>
            @*   
