        </div>
        <!--end::Table container-->
    </div>
    <!--end::Body-->

</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.29/dist/sweetalert2.all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js"></script>
    <script>
        $(document).ready(function () {

        var table = $('#maintenancesTable').DataTable({
              processing: true,
              serverSide: true,
              searching: false,
              ajax: {
                  url: '@Url.Action("LoadMaintenanceRecords", "MaintenanceRecord", new { area = "Admin" })',
                  type: 'POST',
                  data: function (d) {
                      d.SupervisorId = $('#SupervisorId').val();
                      d.StartDate = $('#scheduledDateStart').val();
                      d.EndDate = $('#scheduledDateEnd').val();
                      d.InvoiceNo = $('#InvoiceNo').val(); // أضف هذا السطر
                  }
              },
              columns: [
                  { data: "id" },
                  { data: "customerName" },
                  { data: "supervisorName" },
                  { data: "startDate" },
                  { data: "startTime" },
                  { data: "endDate" },
                  { data: "endTime" },
                  { data: "status" },
                  {
                      data: "id",
                      orderable: false,
                      render: function (data) {
                          return `<a href="/Admin/MaintenanceRecord/Details/${data}" class="btn btn-icon btn-sm btn-bg-light btn-active-color-primary me-1">
                                      <i class="ki-duotone ki-information fs-2">
                                          <span class="path1"></span><span class="path2"></span>
                                  </i></a>`;
                      }
                  }
              ],
              language: {
                  url: "/js/datatables/i18n/ar.json"
              }
          });

          $('#filterButton').on('click', function () {
              table.ajax.reload();
          });



            $(".btn-complete").on("click", function (e) {
                e.preventDefault();
                const $this = $(this);
                const id = $this.attr("data-id");

                Swal.fire({
                    title: 'هل أنت متأكد؟',
                    text: "سيتم الإنتهاء من الصيانة!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'نعم، قم بالإنتهاء!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "@Url.Action("CompleteAppointment", "Appointment", new { area = "Supervisor" })/" + id,
                            type: 'PUT',
                            success: function () {
                                Swal.fire(
                                    'تم الإنتهاء!',
                                    'تم الإنتهاء من الصيانة بنجاح.',
                                    'success'
                                );
                            },
                            error: function (xhr) {
                                Swal.fire(
                                    'خطأ!',
                                    'حدث خطأ أثناء الإنتهاء من الصيانة.',
                                    'error'
                                );
                                console.error(xhr.responseText);
                            }
                        });
                    }
                });
            });




            $(document).on('click', '.add-btn', function () {
                const maintenanceRecordId = $(this).data('id');

                $('#maintenanceRecordId').val(maintenanceRecordId);
            });

            $('#invoiceForm').on('submit', function (e) {
                e.preventDefault();

                const formData = {
                    maintenanceRecordId: $('#maintenanceRecordId').val(),
                    quantity: $('#quantity').val(),
                    productCost: $('#productCost').val(),
                    laborCost: $('#laborCost').val(),
                    productId: $('#productId').val()
                };

                $.ajax({
                    url: "@Url.Action("Add", "Invoice", new { area = "Supervisor" })",
                    type: 'POST',
                    data: JSON.stringify(formData),
                    contentType: 'application/json',
                    success: function (response) {
                        $('#addInvoiceModal').modal('hide');
                        Swal.fire({
                            icon: 'success',
                            title: 'تم الإضافة إلى الفاتورة بنجاح!',
                            text: 'تم عملية الإضافة بنجاح.',
                            confirmButtonText: 'موافق',
                            timer: 3000
                        });
                    },
                    error: function (xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'حدث خطأ!',
                            text: 'حدث خطأ أثناء الإضافة. الرجاء المحاولة لاحقاً.',
                            confirmButtonText: 'حسناً',
                            timer: 3000
                        });
                    }
                });
            });
        });


    </script>
}



