@using Sense.Application.DTOs.ProductDTOs
@model List<ProductDto>
@{
    var message = TempData["Message"];
    var errorMessage = TempData["ErrorMessage"];
    var categories = ViewBag.Categories;
  
}
<!--begin::Tables Widget 10-->
<div class="card mb-xl-8">
    <!--begin::Header-->
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">جدول المنتجات</span>
            <span class="text-muted mt-1 fw-semibold fs-7">يحتوي هذا الجدول على جميع بيانات المنتجات والعمليات عليها.</span>
        </h3>
        <div class="card-toolbar" title="اضغط لإضافة منتج">
            <a asp-area="admin" asp-controller="product" asp-action="add" class="btn btn-sm btn-light btn-active-primary">
                <i class="ki-duotone ki-plus fs-2"></i>منتج جديد
            </a>
        </div>
    </div>
    <!--end::Header-->
    <!--begin::Body-->
    <div class="card-body pt-3">
        <form id="filterForm" method="get" class="mb-4">
            <div class="row gx-5 gy-2">

                <div class="col-md-5">
                    <label class="form-label">الفئة</label>
                    <select class="form-select" id="CategoryId">
                        <option value="">-- الكل --</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">حالة المنتج</label>
                    <select class="form-select" id="StatusFilter">
                        <option value="">-- الكل --</option>
                        <option value="1">مسودة</option>
                        <option value="2">بإنتظار المراجعة</option>
                        <option value="3">مقبول</option>
                        <option value="4">مرفوض</option>
                        <option value="5">منشور</option>
                        <option value="6">غير منشور</option>
                        <option value="7">مؤرشف</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button type="button" id="filterButton" class="btn btn-primary w-100">فلتر</button>
                </div>
            </div>
        </form>
       
        <!--begin::Table container-->
        <div class="table-responsive">
            <table id="productsTable"
                   class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-2 text-center">
                <thead>
                    <tr class="fw-bold text-muted bg-light">
                        <th style="width:320px">المنتج</th>
                        <th>الفئة</th>
                        <th>المزود</th>
                        <th>السعر</th>
                        <th>المخزون</th>
                        <th>تاريخ الإضافة</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
            </table>

        </div>
        <!--end::Table container-->
    </div>
</div>

<!-- Update Stock Modal -->

<div class="modal fade" id="updateStockModal" tabindex="-1" aria-labelledby="updateStockModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="updateStockForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="updateStockModalLabel">تحديث المخزون</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="updateStockProductId" />
                    <div class="mb-3">
                        <label for="updateStockProductName" class="form-label">اسم المنتج</label>
                        <input type="text" class="form-control" id="updateStockProductName" disabled />
                    </div>
                    <div class="mb-3">
                        <label for="updateStockValue" class="form-label">الكمية الجديدة</label>
                        <input type="number" class="form-control" id="updateStockValue" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">تحديث</button>
                </div>
            </form>
        </div>
    </div>
</div>




<div class="modal fade" id="editProductModal" tabindex="-1" aria-labelledby="editProductModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editProductForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="editProductModalLabel">تعديل المنتج</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editProductId" />
                    <div class="mb-3">
                        <label for="editProductName" class="form-label">اسم المنتج</label>
                        <input type="text" class="form-control" id="editProductName" required />
                    </div>
                    <div class="mb-3">
                        <label for="editProductPrice" class="form-label">سعر المنتج</label>
                        <input type="number" step="any" class="form-control" id="editProductPrice" required />
                    </div>
                    <div class="mb-3">
                        <label for="editProductQuantity" class="form-label">الكمية المتاحة</label>
                        <input type="number" class="form-control" id="editProductQuantity" required />
                    </div>
                    <div class="mb-3">
                        <label for="editProductCategory" class="form-label">صنف المنتج</label>
                        <select id="editProductCategory" class="form-select form-select-lg" data-allow-clear="true">
                            <option disabled selected hidden>-- اختر الصنف --</option>
                            @foreach (var category in categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editProductDescription" class="form-label">الوصف (اختياري)</label>
                        <textarea id="editProductDescription" rows="4" class="form-control" placeholder="(إختياري)"></textarea>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">تحديث</button>
                </div>
            </form>
        </div>
    </div>
</div>

  @section Styles {
    <style>
        .description {
            overflow: hidden;
            display: -webkit-box;
            -webkit-line-clamp: 3; /* Show only 3 lines */
            -webkit-box-orient: vertical;
        }

        .description.expanded {
            -webkit-line-clamp: unset;
        }

        .read-more {
            cursor: pointer;
            color: #0d6efd; /* Bootstrap primary color */
        }
    </style>
}
@section Scripts {
    <script>
       document.querySelectorAll('.read-more').forEach(link => {
            link.addEventListener('click', function() {
                const desc = this.previousElementSibling;
                desc.classList.toggle('expanded');
                this.textContent = desc.classList.contains('expanded') ? 'اقرأ أقل' : 'اقرأ المزيد';
            });
        });
        
        $(document).ready(function () {
             var table = $('#productsTable').DataTable({
                processing: true,
                serverSide: true,
                searching: true,
                ajax: {
                    url: '@Url.Action("LoadProducts", "Product", new { area = "Admin" })',
                    type: 'POST',
                    data: function (d) {
                        d.CategoryId = $('#CategoryId').val();
                        d.Status = $('#StatusFilter').val();
                    }
                },
                columns: [
                    {
                        data: null,
                        render: function (data) {
                            return `
                                <div class="d-flex align-items-center">
                                    <div class="symbol symbol-50px m-5">
                                        <img src="${data.image}" alt="product" />
                                    </div>
                                    <div class="d-flex justify-content-start flex-column">
                                        <a href="#" class="text-gray-900 fw-bold text-hover-primary mb-1 fs-6">
                                            ${data.name}
                                        </a>
                                       
                                    </div>
                                </div>
                            `;
                        }
                    },
                    { data: "category" },
                    { data: "provider", orderable: false },
                    { data: "price" },
                     { data: "quantity" },
                    { data: "createdAt" },
                    { 
                        data: "status",
                        orderable: false,
                        render: function (data) {
                            return data;
                        }
                    },
                   {
                        data: null,
                        orderable: false,
                        render: function (row) {
                            let statusActions = '';
                            if (row.statusValue === 2) { // PendingReview
                                statusActions += `
                                    <button data-id="${row.id}" data-status="3" data-label="قبول المنتج"
                                            class="btn-change-status btn btn-icon btn-sm btn-light-success" title="قبول المنتج">
                                        <i class="fas fa-check"></i>
                                    </button>
                                    <button data-id="${row.id}" data-status="4" data-label="رفض المنتج"
                                            class="btn-change-status btn btn-icon btn-sm btn-light-danger" title="رفض المنتج">
                                        <i class="fas fa-times"></i>
                                    </button>`;
                            }
                            if (row.statusValue === 1 || row.statusValue === 3 || row.statusValue === 6) { // Draft / Approved / Unpublished
                                statusActions += `
                                    <button data-id="${row.id}" data-status="5" data-label="نشر المنتج"
                                            class="btn-change-status btn btn-icon btn-sm btn-light-success" title="نشر المنتج">
                                        <i class="fas fa-globe"></i>
                                    </button>`;
                            }
                            if (row.statusValue === 5) { // Published
                                statusActions += `
                                    <button data-id="${row.id}" data-status="6" data-label="إلغاء نشر المنتج"
                                            class="btn-change-status btn btn-icon btn-sm btn-light-warning" title="إلغاء النشر">
                                        <i class="fas fa-eye-slash"></i>
                                    </button>`;
                            }

                            return statusActions + `
                                <a href="/admin/product/uploadimage/${row.id}"
                                   class="btn btn-icon btn-sm btn-light-info"
                                   title="ارفع صورة للمنتج">
                                    <i class="ki-duotone ki-switch fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                </a>

                                <a href="#"
                                   class="btn btn-icon btn-light-warning btn-sm me-1 edit-product"
                                   data-id="${row.id}"
                                   data-name="${row.name}"
                                   data-price="${row.price}"
                                   data-quantity="${row.quantity ?? 0}"
                                   data-category-id="${row.categoryId ?? 0}"
                                   data-provider-id="${row.providerId ?? ''}"
                                   data-is-spare="${row.isSparePart}"
                                   data-description="${row.description ?? ''}"
                                   title="تعديل بيانات المنتج">
                                    <i class="ki-duotone ki-pencil fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                </a>

                                <a href="#"
                                   class="btn btn-icon btn-light-primary btn-sm me-1 update-stock"
                                   data-id="${row.id}"
                                   data-name="${row.name}"
                                   data-stock="${row.quantity ?? 0}"
                                   title="تحديث المخزون">
                                    <i class="ki-duotone ki-arrows-circle fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                        <span class="path3"></span>
                                        <span class="path4"></span>
                                        <span class="path5"></span>
                                    </i>
                                </a>

                                <button data-id="${row.id}"
                                        class="btn-delete btn btn-icon btn-sm btn-light-danger"
                                        title="حذف المنتج">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                        <span class="path3"></span>
                                        <span class="path4"></span>
                                        <span class="path5"></span>
                                    </i>
                                </button>
                            `;
                        }
                    }
                ],
                language: {
                    url: '/js/datatables/i18n/ar.json'
                }
            });

            // Filters
            $('#filterButton').on('click', function () {
                table.ajax.reload();
            });

            toastr.options = {
                "closeButton": true,
                "debug": false,
                "newestOnTop": false,
                "progressBar": true,
                "positionClass": "toast-bottom-left",
                "preventDuplicates": true,
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "2000", 
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut"
            };

            $('table').on('click', '.edit-product', function (e) {
                e.preventDefault();

                const $btn = $(this);

                // Fill the modal fields with data from the clicked button
                $("#editProductId").val($btn.data("id"));
                $("#editProductId").data("provider-id", $btn.data("provider-id"));
                $("#editProductName").val($btn.data("name"));
                $("#editProductPrice").val($btn.data("price"));
                $("#editProductQuantity").val($btn.data("quantity"));
                $("#editProductCategory").val($btn.data("category-id"));
                $("#editProductDescription").val($btn.data("description"));
                $("#editProductIsSparePart").prop("checked", $btn.data("is-spare") === true || $btn.data("is-spare") === "True");
                // Show the modal
                $("#editProductModal").modal("show");
            });

            // Handle Update Stock Button Click
            $('table').on('click', '.update-stock', function (e) {
                e.preventDefault();

                const $btn = $(this);

                $("#updateStockProductId").val($btn.data("id"));
                $("#updateStockProductName").val($btn.data("name"));
                $("#updateStockValue").val($btn.data("stock"));

                $("#updateStockModal").modal("show");
            });

            // Handle Update Stock Form Submission
            $("#updateStockForm").on("submit", function (e) {
                e.preventDefault();

                const dto = {
                    itemId: parseInt($("#updateStockProductId").val()),
                    newStockVal: parseInt($("#updateStockValue").val())
                };

                $.ajax({
                    url: "/Admin/Product/update-stock",
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    success: function (response) {
                        Swal.fire({
                            icon: 'success',
                            title: 'تم تحديث المخزون بنجاح!',
                            showConfirmButton: false,
                            timer: 1500
                        });

                        $("#updateStockModal").modal("hide");
                        window.location.reload();
                    },
                    error: function (xhr) {
                        Swal.fire({
                            icon: 'error',
                            title: 'حدث خطأ!',
                            text: xhr.responseText || 'لم يتم تحديث المخزون.',
                            showConfirmButton: true
                        });
                    }
                });
            });


            $("#editProductForm").on("submit", function (e) {
                e.preventDefault();

                const productId = $("#editProductId").val();
              const data = {
                    name: $("#editProductName").val(),
                    price: parseFloat($("#editProductPrice").val()),
                    quantityAvaliable: parseInt($("#editProductQuantity").val()),
                    description: $("#editProductDescription").val(),
                    isSparePart: $("#editProductIsSparePart").is(":checked"),
                    categoryId: parseInt($("#editProductCategory").val()) || null,
                    providerId: parseInt($("#editProductId").data("provider-id")) || null,
                };
                $.ajax({
                    url: "@Url.Action("Edit", "Product", new { area = "Admin" })/" + productId,
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function (response) {
                        // Assuming the response contains the updated product data in response.data
                        const updatedProduct = response;
                        console.log(updatedProduct);

                        Swal.fire({
                            icon: 'success',
                            title: 'تم التحديث بنجاح!',
                            showConfirmButton: false,
                            timer: 1500
                        });

                        $("#editProductModal").modal("hide");
                        window.location.reload();

                        // Optional: refresh page or update row in table dynamically
                        // location.reload();
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'حدث خطأ!',
                            text: 'لم يتم تحديث المنتج.',
                            showConfirmButton: true
                        });
                    }
                });
            });

            $('table').on('click', '.btn-change-status', function (e) {
                e.preventDefault();

                const $btn = $(this);
                const id = $btn.data('id');
                const status = $btn.data('status');
                const label = $btn.data('label');

                Swal.fire({
                    title: 'هل أنت متأكد؟',
                    text: label,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'نعم',
                    cancelButtonText: 'إلغاء'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post("@Url.Action("ChangeStatus", "Product", new { area = "Admin" })", { id: id, status: status })
                            .done(function (res) {
                                if (res.success) {
                                    toastr.success(res.message);
                                    table.ajax.reload(null, false);
                                } else {
                                    Swal.fire('خطأ', res.message || 'تعذر تغيير حالة المنتج', 'error');
                                }
                            })
                            .fail(function () {
                                Swal.fire('خطأ', 'حدث خطأ أثناء تغيير حالة المنتج', 'error');
                            });
                    }
                });
            });

            $('table').on('click', '.btn-delete', function (e) {
                e.preventDefault();

                const $this = $(this);
                const id = $this.attr("data-id");

                Swal.fire({
                    title: 'هل أنت متأكد؟',
                    text: "سيتم حذف هذا المنتج!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'نعم، احذفه!',
                    cancelButtonText: 'إلغاء'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "@Url.Action("Delete", "Product", new { area = "Admin" })/" + id,
                            type: 'DELETE',
                            success: function () {
                                Swal.fire(
                                    'تم الحذف!',
                                    'تم حذف المنتج بنجاح.',
                                    'success'
                                );
                                $this.closest("tr").remove();
                            },
                            error: function () {
                                Swal.fire(
                                    'خطأ!',
                                    'حدث خطأ أثناء الحذف.',
                                    'error'
                                );
                            }
                        });
                    }
                });
            });
            $(".btn-pge").on("click", function (e) {
                $this = $(this);
                var pg = $(this).attr("data-pg");
                if (result.isConfirmed) {
                    $.ajax({
                        url: "@Url.Action("Index", "Product", new { area = "Admin" })/" + pg,
                        type: 'POST'

                    });
                }
            })
            e.preventDefault();
        });
        

    </script>
}
