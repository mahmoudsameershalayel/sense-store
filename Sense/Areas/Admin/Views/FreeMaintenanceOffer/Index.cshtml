@using Sense.Application.DTOs.FreeMaintenanceOfferDTOs
@model List<FreeMaintenanceOfferDto>
@{
    var message = TempData["Message"];
    var errorMessage = TempData["ErrorMessage"];
}
@section Styles 
{
  
}
<!--begin::Tables Widget 10-->
<div class="card mb-xl-8">
    <!--begin::Header-->
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">جدول عروض الصيانة المجانية</span>
            <span class="text-muted mt-1 fw-semibold fs-7">يحتوي هذا الجدول على جميع بيانات عروض الصيانة المجانية والعمليات عليها.</span>
        </h3>
        <div class="card-toolbar" title="اضغط لإضافة عرض صيانة مجانية">
            <button class="btn btn-sm btn-light btn-active-primary" data-bs-toggle="modal" data-bs-target="#offerModal">
                <i class="ki-duotone ki-plus fs-2"></i>عرض صيانة مجانية جديد
            </button>
        </div>
    </div>
    <!--end::Header-->
    <!--begin::Body-->
    <div class="card-body pt-3">
        <!--begin::Table container-->
        <div class="table-responsive">

            <!--begin::Table-->
            <table id="freeMaintenanceOffersTable" class="table table-row-dashed table-row-gray-300 align-middle text-center gs-0 gy-4">
                <thead>
                    <tr class="fw-bold text-muted bg-light">
                        <th class="ps-4 min-w-100px rounded-start">العرض</th>
                        <th class="min-w-125px">العنوان</th>
                        <th class="min-w-125px">التفاصيل</th>
                        <th class="min-w-125px">عدد الصيانات المكتملة للتفعيل</th>
                        <th class="min-w-125px">فترة الصيانة المجانية بالإيام</th>
                        <th class="min-w-125px">الفعالية</th>
                        <th class="min-w-150px"></th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
