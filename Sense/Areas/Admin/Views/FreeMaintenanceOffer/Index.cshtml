</div>



<!-- Modal -->
<div class="modal fade" id="offerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form id="offerForm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">إضافة عرض صيانة مجانية</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label>عنوان العرض</label>
                        <input type="text" class="form-control" id="title" required />
                    </div>
                    <div class="mb-3">
                        <label>التفاصيل</label>
                        <textarea class="form-control" id="description"></textarea>
                    </div>
                    <div class="mb-3">
                        <label>الحجوزات المطلوبة</label>
                        <input type="number" class="form-control" id="requiredAppointments" required />
                    </div>
                    <div class="mb-3">
                        <label>الفترة المجانية (الأيام)</label>
                        <input type="number" class="form-control" id="freePeriod" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">إضافة العرض</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            toastr.options = {
                "closeButton": true,
                "debug": false,
                "newestOnTop": false,
                "progressBar": true,
                "positionClass": "toast-bottom-left",
                "preventDuplicates": true,
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "2000", 
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut"
            };


            var table = $('#freeMaintenanceOffersTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("LoadFreeMaintenanceOffers", "FreeMaintenanceOffer", new { area = "Admin" })',
                    type: 'POST'
                },
                columns: [
                    {
                        data: "id",
                        render: function (data, type, row) {
                            return `
                            <div class="d-flex align-items-center">
                                <div class="symbol symbol-50px m-5">
                                    <img src="${row.imageURL}" alt="" />
                                </div>
                                <div class="d-flex justify-content-start flex-column">
                                    <a href="#" class="text-gray-900 fw-bold text-hover-primary mb-1 fs-6">#${data}</a>
                                </div>
                            </div>`;
                        }
                    },
                    { data: "title" },
                    { data: "description" },
                    {
                        data: "requiredAppointments",
                        className: "text-center align-middle",
                        render: function (data) {
                            return `<span class="badge rounded-circle bg-primary px-3 py-2 fs-6 fw-bold text-white">${data}</span>`;
                        }
                    },
                    {
                        data: "freePeriodInDays",
                        className: "text-center align-middle",
                        render: function (data) {
                            return `<span class="badge rounded-circle bg-primary px-3 py-2 fs-6 fw-bold text-white">${data}</span>`;
                        }
                    },
                    {
                        data: "isActive",
                        render: function (data, type, row) {
                            let badgeClass = data ? "bg-success" : "bg-danger";
                            let text = data ? "نشط" : "معطل";
                            return `<span id="status-badge-${row.id}" class="badge toggle-status ${badgeClass} fs-7 fw-bold" data-id="${row.id}" role="button" style="cursor:pointer; color:white;" title="اضغط لتغيير حالة العرض">${text}</span>`;
                        }
                    },
                    {
                        data: "id",
                        orderable: false,
                        render: function (data) {
                            var uploadUrl = '@Url.Action("UploadImage", "FreeMaintenanceOffer", new { area = "Admin", id = "__id__" })';
                            var url = uploadUrl.replace("__id__", data);
                            return `
                            <a href="${url}" class="btn btn-icon btn-sm btn-light-info" title="ارفع صورة للمنتج">
                                <i class="ki-duotone ki-switch fs-2"><span class="path1"></span><span class="path2"></span></i>
                            </a>
                          
                            <a data-id="${data}" class="btn btn-delete btn-icon btn-light-danger btn-sm">
                                <i class="ki-duotone ki-trash fs-2"><span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span></i>
                            </a>`;
                        }
                    }
                ],
                language: {
                    url: "/js/datatables/i18n/ar.json"
                },
                order: [[0, "asc"]]
            });

             $('#freeMaintenanceOffersTable tbody').on('click', '.toggle-status', function () {
                var button = $(this);
                var id = button.data('id');

                $.ajax({
                    url: "@Url.Action("ChangeStatus", "FreeMaintenanceOffer", new { area = "Admin" })/" + id,
                    type: 'PUT',
                    success: function (response) {
                        toastr.success(response.message);
                        const badge = $('#status-badge-' + id);
                        const isNowActive = badge.hasClass('bg-danger');
                        badge.removeClass('bg-success bg-danger').addClass(isNowActive ? 'bg-success' : 'bg-danger');
                        badge.text(isNowActive ? 'نشط' : 'معطل');
                    },
                    error: function () {
                        toastr.error("حدث خطأ أثناء تغيير حالة العرض.");
                    }
                });
            });



            $('#cashbackForm').on('submit', function (e) {
                e.preventDefault();

                const dto = {
                    cashbackType: parseInt($('#cashbackType').val()),
                    cashbackVal: parseFloat($('#cashbackVal').val()),
                    startDate: $('#startDate').val() || null,
                    endDate: $('#endDate').val() || null
                };

                $.ajax({
                    url: '@Url.Action("Add", "CashbackOffer", new { area = "Admin" })',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    success: function (response) {
                       
                        $('#cashbackModal').modal('hide');
                        $('#cashbackForm')[0].reset();


                      

                        $('table tbody').append(newRow);

                    },
                   
                });
            });


            $('#offerForm').on('submit', function (e) {
                e.preventDefault();
                const dto = {
                    title: $('#title').val(),
                    description: $('#description').val(),
                    requiredAppointments: parseInt($('#requiredAppointments').val()),
                    freePeriodInDays: parseInt($('#freePeriod').val())
                };

                $.ajax({
                    url: '@Url.Action("Add", "FreeMaintenanceOffer", new { area = "Admin" })',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    success: function (response) {
                        Swal.fire({
                            icon: 'success',
                            title: 'تمت الإضافة',
                            text: 'تمت إضافة عرض الصيانة المجانية بنجاح.',
                            timer: 3000
                        });
                        $('#offerModal').modal('hide');
                        $('#offerForm')[0].reset();
                        table.ajax.reload(null, false);
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'خطأ',
                            text: 'حدث خطأ أثناء إضافة العرض.',
                            timer: 3000
                        });
                    }
                });
            });

            $('#freeMaintenanceOffersTable tbody').on('click', '.btn-delete', function (e) {
                e.preventDefault();
                var button = $(this);
                var id = button.data('id');
                Swal.fire({
                    title: 'هل أنت متأكد?',
                    text: "سيتم حذف هذا العرض بشكل نهائي!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'نعم, قم بالحذف!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "@Url.Action("Delete", "FreeMaintenanceOffer", new { area = "Admin" })/" + id,
                            type: 'DELETE',
                            success: function () {
                                Swal.fire('تم الحذف!', 'تم حذف العرض بنجاح.', 'success');
                                table.ajax.reload(null, false); // Reload table without changing page
                            }
                        });
                    }
                });
            });





            $(".btn-pge").on("click", function (e) {
                $this = $(this);
                var pg = $(this).attr("data-pg");
                if (result.isConfirmed) {
                    $.ajax({
                        url: "@Url.Action("Index", "CashbackOffer", new { area = "Admin" })/" + pg,
                        type: 'POST'

                    });
                }
            })
            e.preventDefault();
        });
        document.addEventListener("DOMContentLoaded", function () {
            var message = '@message';
            if (message) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: message,
                    showConfirmButton: false,
                    timer: 1500
                });
            }
        });
        document.addEventListener("DOMContentLoaded", function () {
            var message = '@errorMessage';
            if (message) {
                Swal.fire({
                    icon: "error",
                    title: "Oops...",
                    text: message,
                    timer: 1500
                });
            }
        });

    </script>
}