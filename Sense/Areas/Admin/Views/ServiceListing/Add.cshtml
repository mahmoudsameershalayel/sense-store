@using Sense.Application.DTOs.ServiceListingDTOs
@model ServiceListingForCreateUpdateDto

@{
    var serviceProviders = ViewBag.ServiceProviders;
}

<form asp-controller="ServiceListing" asp-action="Add" method="POST" class="form">
    <div class="container-xxl">
        <div class="card mb-4">
            <div class="card-header mb-4">
                <h3 class="card-title">املأ بيانات الخدمة</h3>
            </div>
            <div class="card-body pt-0">
                <!-- Service Name and Price -->
                <div class="row mb-5">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label required">إسم الخدمة</label>
                        <input type="text" asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger fs-7"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label required">سعر الخدمة</label>
                        <input type="number" asp-for="Price" step="any" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger fs-7"></span>
                    </div>
                </div>

                <!-- Service Provider -->
                <div class="row mb-5">
                    <div class="col-md-6">
                        <label asp-for="ServiceProviderId" class="form-label">مزود الخدمة (اختياري)</label>
                        <select asp-for="ServiceProviderId" class="form-select form-select-lg" data-allow-clear="true">
                            <option value="">-- خدمة المتجر (بدون مزود) --</option>
                            @if (serviceProviders != null)
                            {
                                @foreach (var provider in serviceProviders)
                                {
                                    <option value="@provider?.Id">@provider?.DisplayName</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="ServiceProviderId" class="text-danger fs-7"></span>
                    </div>
                </div>

                <!-- Description -->
                <div class="mb-5">
                    <label asp-for="Description" class="form-label">الوصف (اختياري)</label>
                    <textarea asp-for="Description" rows="4" class="form-control" placeholder="(إختياري)"></textarea>
                </div>

                <!-- Submit & Reset Buttons -->
                <div class="d-flex gap-3 mt-6">
                    <button type="submit" class="btn btn-primary">
                        <i class="ki-duotone ki-check fs-2"></i> إنشاء
                    </button>
                    <button type="reset" class="btn btn-light-warning">
                        <i class="ki-duotone ki-refresh fs-2"></i> إعادة الضبط
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>
