@using Sense.Application.DTOs.ServiceListingDTOs
@model UploadServiceListingImageDto
@{
    var id = ViewBag.Id;
}
<form asp-controller="ServiceListing" asp-action="UploadImage" enctype="multipart/form-data" method="POST">
    <input type="hidden" value="@id" asp-for="Id" />
    <div class="row mt-5 container">
        <div class="card mb-4">
            <div class="card-header">
                <h3 class="card-title">ارفع صورة الخدمة</h3>
            </div>

            <div class="alert alert-info m-3 text-right">
                <h5 class="alert-heading mb-2">
                    <i class="fas fa-info-circle ml-2"></i>
                    تعليمات رفع الصورة:
                </h5>
                <ul class="list-unstyled mb-0">
                    <li>• يجب أن تكون الصورة بصيغة JPEG , PNG أو JPG </li>
                    <li>• الحد الأقصى لحجم كل ملف: 5 ميجابايت (5000 كيلوبايت)</li>
                </ul>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label for="image">صورة الخدمة</label>
                        <input type="file" class="form-control" id="image" asp-for="Image">
                    </div>
                </div>


                <div class="row mt-3">
                    <div class="col-lg-1 col-md-2 col-sm-4  mb-4">
                        <button type="submit" class="btn btn-primary btn-create">إضافة</button>
                    </div>
                    <div class="col-lg-1 col-md-2 col-sm-4  mb-4">
                        <input type="reset" class="btn btn-warning" value="إعادة الضبط">
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
