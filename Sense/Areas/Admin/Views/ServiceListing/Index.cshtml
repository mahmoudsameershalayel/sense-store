@using Sense.Application.DTOs.ServiceListingDTOs
@model List<ServiceListingDto>
@{
    var message = TempData["Message"];
    var errorMessage = TempData["ErrorMessage"];
}
<!--begin::Tables Widget 10-->
<div class="card mb-xl-8">
    <!--begin::Header-->
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">جدول الخدمات المعروضة</span>
            <span class="text-muted mt-1 fw-semibold fs-7">يحتوي هذا الجدول على جميع بيانات الخدمات والعمليات عليها.</span>
        </h3>
        <div class="card-toolbar" title="اضغط لإضافة خدمة">
            <a asp-area="admin" asp-controller="ServiceListing" asp-action="add" class="btn btn-sm btn-light btn-active-primary">
                <i class="ki-duotone ki-plus fs-2"></i>خدمة جديدة
            </a>
        </div>
    </div>
    <!--end::Header-->
    <!--begin::Body-->
    <div class="card-body pt-3">
        <form id="filterForm" method="get" class="mb-4">
            <div class="row gx-5 gy-2">

                <div class="col-md-4">
                    <label class="form-label">حالة الخدمة</label>
                    <select class="form-select" id="StatusFilter">
                        <option value="">-- الكل --</option>
                        <option value="1">مسودة</option>
                        <option value="2">بإنتظار المراجعة</option>
                        <option value="3">مقبولة</option>
                        <option value="4">مرفوضة</option>
                        <option value="5">منشورة</option>
                        <option value="6">غير منشورة</option>
                        <option value="7">مؤرشفة</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button type="button" id="filterButton" class="btn btn-primary w-100">فلتر</button>
                </div>
            </div>
        </form>

        <!--begin::Table container-->
        <div class="table-responsive">
            <table id="serviceListingsTable"
                   class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-2 text-center">
                <thead>
                    <tr class="fw-bold text-muted bg-light">
                        <th style="width:320px">الخدمة</th>
                        <th>مزود الخدمة</th>
                        <th>السعر</th>
                        <th>تاريخ الإضافة</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
            </table>

        </div>
        <!--end::Table container-->
    </div>
</div>

<div class="modal fade" id="editServiceListingModal" tabindex="-1" aria-labelledby="editServiceListingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editServiceListingForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="editServiceListingModalLabel">تعديل الخدمة</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editServiceListingId" />
                    <div class="mb-3">
                        <label for="editServiceListingName" class="form-label">اسم الخدمة</label>
                        <input type="text" class="form-control" id="editServiceListingName" required />
                    </div>
                    <div class="mb-3">
                        <label for="editServiceListingPrice" class="form-label">سعر الخدمة</label>
                        <input type="number" step="any" class="form-control" id="editServiceListingPrice" required />
                    </div>
                    <div class="mb-3">
                        <label for="editServiceListingDescription" class="form-label">الوصف (اختياري)</label>
                        <textarea id="editServiceListingDescription" rows="4" class="form-control" placeholder="(إختياري)"></textarea>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">تحديث</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
             var table = $('#serviceListingsTable').DataTable({
                processing: true,
                serverSide: true,
                searching: true,
                ajax: {
                    url: '@Url.Action("LoadServiceListings", "ServiceListing", new { area = "Admin" })',
                    type: 'POST',
                    data: function (d) {
                        d.Status = $('#StatusFilter').val();
                    }
                },
                columns: [
                    {
                        data: null,
                        render: function (data) {
                            return `
                                <div class="d-flex align-items-center">
                                    <div class="symbol symbol-50px m-5">
                                        <img src="${data.image}" alt="service" />
                                    </div>
                                    <div class="d-flex justify-content-start flex-column">
                                        <a href="#" class="text-gray-900 fw-bold text-hover-primary mb-1 fs-6">
                                            ${data.name}
                                        </a>
                                    </div>
                                </div>
                            `;
                        }
                    },
                    { data: "serviceProvider", orderable: false },
                    { data: "price" },
                    { data: "createdAt" },
                    {
                        data: "status",
                        orderable: false,
                        render: function (data) {
                            return data;
                        }
                    },
                   {
                        data: null,
                        orderable: false,
                        render: function (row) {
                            let statusActions = '';
                            if (row.statusValue === 2) { // PendingReview
                                statusActions += `
                                    <button data-id="${row.id}" data-status="3" data-label="قبول الخدمة"
                                            class="btn-change-status btn btn-icon btn-sm btn-light-success" title="قبول الخدمة">
                                        <i class="fas fa-check"></i>
                                    </button>
                                    <button data-id="${row.id}" data-status="4" data-label="رفض الخدمة"
                                            class="btn-change-status btn btn-icon btn-sm btn-light-danger" title="رفض الخدمة">
                                        <i class="fas fa-times"></i>
                                    </button>`;
                            }
                            if (row.statusValue === 1 || row.statusValue === 3 || row.statusValue === 6) { // Draft / Approved / Unpublished
                                statusActions += `
                                    <button data-id="${row.id}" data-status="5" data-label="نشر الخدمة"
                                            class="btn-change-status btn btn-icon btn-sm btn-light-success" title="نشر الخدمة">
                                        <i class="fas fa-globe"></i>
                                    </button>`;
                            }
                            if (row.statusValue === 5) { // Published
                                statusActions += `
                                    <button data-id="${row.id}" data-status="6" data-label="إلغاء نشر الخدمة"
                                            class="btn-change-status btn btn-icon btn-sm btn-light-warning" title="إلغاء النشر">
                                        <i class="fas fa-eye-slash"></i>
                                    </button>`;
                            }

                            return statusActions + `
                                <a href="/admin/servicelisting/uploadimage/${row.id}"
                                   class="btn btn-icon btn-sm btn-light-info"
                                   title="ارفع صورة للخدمة">
                                    <i class="ki-duotone ki-switch fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                </a>

                                <a href="#"
                                   class="btn btn-icon btn-light-warning btn-sm me-1 edit-service-listing"
                                   data-id="${row.id}"
                                   data-name="${row.name}"
                                   data-price="${row.price}"
                                   data-description="${row.description ?? ''}"
                                   title="تعديل بيانات الخدمة">
                                    <i class="ki-duotone ki-pencil fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                </a>

                                <button data-id="${row.id}"
                                        class="btn-delete btn btn-icon btn-sm btn-light-danger"
                                        title="حذف الخدمة">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                        <span class="path3"></span>
                                        <span class="path4"></span>
                                    </i>
                                </button>
                            `;
                        }
                    }
                ],
                language: {
                    url: '/js/datatables/i18n/ar.json'
                }
            });

            // Filters
            $('#filterButton').on('click', function () {
                table.ajax.reload();
            });

            toastr.options = {
                "closeButton": true,
                "debug": false,
                "newestOnTop": false,
                "progressBar": true,
                "positionClass": "toast-bottom-left",
                "preventDuplicates": true,
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "2000",
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut"
            };

            $('table').on('click', '.edit-service-listing', function (e) {
                e.preventDefault();

                const $btn = $(this);

                $("#editServiceListingId").val($btn.data("id"));
                $("#editServiceListingName").val($btn.data("name"));
                $("#editServiceListingPrice").val($btn.data("price"));
                $("#editServiceListingDescription").val($btn.data("description"));

                $("#editServiceListingModal").modal("show");
            });

            $("#editServiceListingForm").on("submit", function (e) {
                e.preventDefault();

                const serviceListingId = $("#editServiceListingId").val();
                const data = {
                    name: $("#editServiceListingName").val(),
                    price: parseFloat($("#editServiceListingPrice").val()),
                    description: $("#editServiceListingDescription").val(),
                };
                $.ajax({
                    url: "@Url.Action("Edit", "ServiceListing", new { area = "Admin" })/" + serviceListingId,
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function (response) {
                        Swal.fire({
                            icon: 'success',
                            title: 'تم التحديث بنجاح!',
                            showConfirmButton: false,
                            timer: 1500
                        });

                        $("#editServiceListingModal").modal("hide");
                        window.location.reload();
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'حدث خطأ!',
                            text: 'لم يتم تحديث الخدمة.',
                            showConfirmButton: true
                        });
                    }
                });
            });

            $('table').on('click', '.btn-change-status', function (e) {
                e.preventDefault();

                const $btn = $(this);
                const id = $btn.data('id');
                const status = $btn.data('status');
                const label = $btn.data('label');

                Swal.fire({
                    title: 'هل أنت متأكد؟',
                    text: label,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'نعم',
                    cancelButtonText: 'إلغاء'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post("@Url.Action("ChangeStatus", "ServiceListing", new { area = "Admin" })", { id: id, status: status })
                            .done(function (res) {
                                if (res.success) {
                                    toastr.success(res.message);
                                    table.ajax.reload(null, false);
                                } else {
                                    Swal.fire('خطأ', res.message || 'تعذر تغيير حالة الخدمة', 'error');
                                }
                            })
                            .fail(function () {
                                Swal.fire('خطأ', 'حدث خطأ أثناء تغيير حالة الخدمة', 'error');
                            });
                    }
                });
            });

            $('table').on('click', '.btn-delete', function (e) {
                e.preventDefault();

                const $this = $(this);
                const id = $this.attr("data-id");

                Swal.fire({
                    title: 'هل أنت متأكد؟',
                    text: "سيتم حذف هذه الخدمة!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'نعم، احذفها!',
                    cancelButtonText: 'إلغاء'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "@Url.Action("Delete", "ServiceListing", new { area = "Admin" })/" + id,
                            type: 'DELETE',
                            success: function () {
                                Swal.fire(
                                    'تم الحذف!',
                                    'تم حذف الخدمة بنجاح.',
                                    'success'
                                );
                                $this.closest("tr").remove();
                            },
                            error: function () {
                                Swal.fire(
                                    'خطأ!',
                                    'حدث خطأ أثناء الحذف.',
                                    'error'
                                );
                            }
                        });
                    }
                });
            });
        });
    </script>
}
