@using Sense.Domain.Enums
@model List<PartnerInquiryTbl>

<!--begin::Tables Widget 10-->
<div class="card mb-xl-8">
    <!--begin::Header-->
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">طلبات تقديم خدمة أو منتج</span>
            <span class="text-muted mt-1 fw-semibold fs-7">يحتوي هذا الجدول على جميع طلبات الراغبين في تقديم خدمة أو منتج.</span>
        </h3>
    </div>
    <!--end::Header-->
    <!--begin::Body-->
    <div class="card-body pt-3">
        <!--begin::Table container-->
        <div class="table-responsive">
            <!--begin::Table-->
            <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                <!--begin::Table head-->
                <thead>
                    <tr class="fw-bold text-muted bg-light">
                        <th class="ps-4 min-w-200px rounded-start">الاسم الكامل</th>
                        <th class="min-w-150px">اسم النشاط / العلامة</th>
                        <th class="min-w-125px">رقم الهاتف</th>
                        <th class="min-w-100px">النوع</th>
                        <th class="min-w-300px rounded-end">التفاصيل</th>
                    </tr>
                </thead>
                <!--end::Table head-->
                <!--begin::Table body-->
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="text-gray-900 fw-bold d-block mb-1 fs-6">@item.FullName</span>
                            </td>
                            <td>
                                <span class="text-gray-900 fw-bold d-block mb-1 fs-6">@item.BrandName</span>
                            </td>
                            <td>
                                <span class="text-gray-900 fw-bold d-block mb-1 fs-6" dir="ltr">@item.PhoneNumber</span>
                            </td>
                            <td>
                                @if (item.OfferType == PartnerOfferType.Service)
                                {
                                    <span class="badge badge-light-info">خدمة</span>
                                }
                                else
                                {
                                    <span class="badge badge-light-success">منتج</span>
                                }
                            </td>
                            <td>
                                <span class="text-gray-700 d-block mb-1 fs-7">@item.Description</span>
                            </td>
                        </tr>
                    }
                </tbody>
                <!--end::Table body-->
            </table>
            <!--end::Table-->
        </div>
        <!--end::Table container-->
    </div>
</div>
