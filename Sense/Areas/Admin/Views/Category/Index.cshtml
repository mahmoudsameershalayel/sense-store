@using Sense.Application.DTOs.CategoryDTOs
@model List<CategoryDto>
@{
    var message = TempData["Message"];
    var errorMessage = TempData["ErrorMessage"];
}
<!--begin::Tables Widget 10-->
<div class="card mb-xl-8">
    <!--begin::Header-->
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">جدول التصنيفات</span>
            <span class="text-muted mt-1 fw-semibold fs-7">يحتوي هذا الجدول على جميع بيانات التصنيفات والعمليات عليها.</span>
        </h3>
        <div class="card-toolbar" title="اضغط لإضافة صنف">
            <a asp-area="admin" asp-controller="category" asp-action="add" class="btn btn-sm btn-light btn-active-primary">
                <i class="ki-duotone ki-plus fs-2"></i>تصنيف جديد
            </a>
        </div>
    </div>
    <!--end::Header-->
    <!--begin::Body-->
    <div class="card-body pt-3">
        <!--begin::Table container-->
        <div class="table-responsive">
            <!--begin::Table-->
            <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                <!--begin::Table head-->
                <thead>
                    <tr class="fw-bold text-muted bg-light">
                        <th class="ps-4 min-w-325px rounded-start">التصنيف</th>
                        <th class="min-w-125px">الإسم</th>
                        <th class="min-w-200px text-end rounded-end"></th>
                    </tr>
                   
                </thead>
                <!--end::Table head-->
                <!--begin::Table body-->
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="symbol symbol-50px m-5">
                                        <img src="@item.ImageURL" class="" alt="" />
                                    </div>
                                    <div class="d-flex justify-content-start flex-column">
                                        <a href="#" class="text-gray-900 fw-bold text-hover-primary mb-1 fs-6">#@item.Id</a>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <a href="#" class="text-gray-900 fw-bold text-hover-primary d-block mb-1 fs-6" id="category-name-@item.Id">@item.Name</a>
                            </td>
                           
                            <td class="text-end">
                                <a asp-area="admin" asp-controller="category" asp-action="uploadimage" asp-route-id="@item.Id" class="btn btn-icon btn-sm btn-light-info" title="ارفع صورة للمنتج">
                                    <i class="ki-duotone ki-switch fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                </a>
                                <button class="btn btn-icon btn-light-warning  btn-sm edit-category"
                                        data-id="@item.Id"
                                        data-name="@item.Name">
                                    <i class="ki-duotone ki-pencil fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                </button>
                                
                                <a asp-route-id="@item.Id" data-id="@item.Id" class="btn btn-delete btn-icon btn-light-danger  btn-sm">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                        <span class="path3"></span>
                                        <span class="path4"></span>
                                        <span class="path5"></span>
                                    </i>
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>
                <!--end::Table body-->
            </table>
            <!--end::Table-->
        </div>
        <!--end::Table container-->
    </div>
</div>


<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editCategoryForm">
                <div class="modal-header">
                    <h5 class="modal-title">تعديل القسم</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editCategoryId" />
                    <div class="mb-3">
                        <label for="editCategoryName" class="form-label">اسم القسم</label>
                        <input type="text" class="form-control" id="editCategoryName" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">حفظ</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    
    <script>
        $(document).ready(function () {
            toastr.options = {
                "closeButton": true,
                "debug": false,
                "newestOnTop": false,
                "progressBar": true,
                "positionClass": "toast-bottom-left", 
                "preventDuplicates": true,
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "2000", 
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut"
            };


            $('.edit-category').click(function () {
                selectedCategory = {
                    id: $(this).data('id'),
                    name: $(this).data('name')
                };

                $('#editCategoryModal').modal('show');
            });

            // When modal is shown, fill the form
            $('#editCategoryModal').on('show.bs.modal', function () {
                $('#editCategoryId').val(selectedCategory.id);
                $('#editCategoryName').val(selectedCategory.name);
            });

            // Submit via AJAX
            $('#editCategoryForm').submit(function (e) {
                e.preventDefault();

                const data = {
                    Id: parseInt($('#editCategoryId').val()),
                    Name: $('#editCategoryName').val()
                };

                $.ajax({
                    url: "@Url.Action("Edit", "Category", new { area = "Admin" })",
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function (res) {
                        toastr.success(res.message);
                        $('#editCategoryModal').modal('hide');
                        // Update the table row
                        const updatedId = res.id;
                        const updatedName = $('#editCategoryName').val();
                        // Update the name cell content
                        $('#category-name-' + updatedId).text(updatedName);
                    },
                    error: function (xhr) {
                        toastr.error(xhr.responseText || 'حدث خطأ أثناء التحديث');
                    }
                });
            });

           
            $(".btn-delete").on("click", function (e) {
                $this = $(this);
                var id = $(this).attr("data-id");
                Swal.fire({
                    title: 'Are you sure?',
                    text: "All Products that have this Category will removed!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "@Url.Action("Delete", "Category", new { area = "Admin" })/" + id,
                            type: 'DELETE',
                            success: function (result) {
                                Swal.fire(
                                    'Deleted!',
                                    'Your entity has been deleted.',
                                    'success'
                                )
                                console.log($this.closest("tr").remove());
                            }
                        });
                    }
                })
                e.preventDefault();
            });
            $(".btn-pge").on("click", function (e) {
                $this = $(this);
                var pg = $(this).attr("data-pg");
                if (result.isConfirmed) {
                    $.ajax({
                        url: "@Url.Action("Index", "Category", new { area = "Admin" })/" + pg,
                        type: 'POST'

                    });
                }
            })
            e.preventDefault();
        });
        document.addEventListener("DOMContentLoaded", function () {
            var message = '@message';
            if (message) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: message,
                    showConfirmButton: false,
                    timer: 1500
                });
            }
        });
        document.addEventListener("DOMContentLoaded", function () {
            var message = '@errorMessage';
            if (message) {
                Swal.fire({
                    icon: "error",
                    title: "Oops...",
                    text: message,
                    timer: 1500
                });
            }
        });

    </script>
}