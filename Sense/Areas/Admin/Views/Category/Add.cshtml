@using Sense.Application.DTOs.CategoryDTOs
@model CategoryDto
@{
}
<form asp-controller="Category" asp-action="Add" method="POST">
    <div class="row mt-5 container">
        <div class="card mb-4">
            <div class="card-header">
                <h3 class="card-title">املأ بيانات التصنيف</h3>
            </div>
            <div class="card-body">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="name">اسم التصنيف</label>
                        <input type="text" class="form-control" id="name" asp-for="Name">
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-lg-1 col-md-2 col-sm-4  mb-4">
                        <button type="submit" class="btn btn-primary btn-create">إنشاء</button>
                    </div>
                    <div class="col-lg-1 col-md-2 col-sm-4  mb-4">
                        <input type="reset" class="btn btn-warning" value="إعادة الضبط">
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>