@using Sense.Application.DTOs.CenterSettingDTOs
@model CenterSettingDto
@{
}

<form id="centerSettingForm">
    <div class="container mt-5">

        <!-- Center Settings Section -->
        <div class="card mb-4">
            <h5 class="card-header p-0 m-0">
                <div class="text-center fw-bold text-primary" style="width: 100%;padding-top:3%;">
                    إعدادات مركز سدرا
                </div>
            </h5>

            <div class="card-body row">
                <div class="col-md-6 mb-3">
                    <label class="form-label mb-1">اسم المتجر</label>
                    <input type="text" class="form-control" id="centerName" name="centerName" value="@(Model?.CenterName ?? "مركز سدرا")" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label mb-1">شعار المتجر</label>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <img id="logoPreview" src="@(Model?.LogoUrl ?? "/assets/img/logo-default.png")" alt="شعار المتجر" style="width:72px;height:72px;object-fit:cover;border-radius:14px;border:1px solid #e5e7eb;background:#fff;" />
                        <div class="flex-grow-1">
                            <input type="hidden" id="logoUrl" name="logoUrl" value="@(Model?.LogoUrl ?? "/assets/img/logo-default.png")" />
                            <input type="file" class="form-control" id="logoFile" accept="image/*" />
                            <small class="text-muted d-block mt-1">يمكنك اختيار ملف الصورة لرفعه كشعار للمتجر.</small>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label mb-1">أيقونة المتصفح (Favicon)</label>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <img id="faviconPreview" src="@(Model?.FaviconUrl ?? Model?.LogoUrl ?? "/assets/img/logo-default.png")" alt="أيقونة المتصفح" style="width:48px;height:48px;object-fit:cover;border-radius:10px;border:1px solid #e5e7eb;background:#fff;" />
                        <div class="flex-grow-1">
                            <input type="hidden" id="faviconUrl" name="faviconUrl" value="@Model?.FaviconUrl" />
                            <input type="file" class="form-control" id="faviconFile" accept="image/*" />
                            <small class="text-muted d-block mt-1">يفضل صورة مربعة (مثال 32x32 أو 64x64).</small>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label mb-1">العنوان</label>
                    <input type="text" class="form-control" id="address" name="address" value="@Model?.Address" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label mb-1">البريد الإلكتروني</label>
                    <input type="email" class="form-control" id="email" name="email" value="@Model?.Email" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label mb-1">رقم الهاتف</label>
                    <input type="text" class="form-control" id="phoneNumber" name="phoneNumber" value="@Model?.PhoneNumber" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label mb-1">رابط تويتر</label>
                    <input type="text" class="form-control" id="twitterUrl" name="twitterUrl" value="@Model?.TwitterUrl" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label mb-1">رابط فيسبوك</label>
                    <input type="text" class="form-control" id="facebookUrl" name="facebookUrl" value="@Model?.FacebookUrl" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label mb-1">رابط إنستغرام</label>
                    <input type="text" class="form-control" id="instagramUrl" name="instagramUrl" value="@Model?.InstagramUrl" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label mb-1">رابط لينكدإن</label>
                    <input type="text" class="form-control" id="linkedInUrl" name="linkedInUrl" value="@Model?.LinkedInUrl" />
                </div>
            </div>
        </div>

        <!-- Points Configuration Section -->
        <div class="card mb-4">
            <h5 class="card-header p-0 m-0">
                <div class="text-center fw-bold text-success" style="width: 100%;padding-top:3%;">
                    إعدادات نظام النقاط
                </div>
            </h5>

            <div class="card-body row">
                <div class="col-md-4 mb-3">
                    <label class="form-label mb-1">
                        <i class="fas fa-exchange-alt text-primary me-2"></i>
                        معدل تحويل النقاط إلى                         <svg class="riyal-svg currency" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 78.917 78.917" width="15" height="15" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-0.125em"><path d="M32.501,16.458H9.021L9,66.958c0,2.48-2.019,4.5-4.5,4.5s-4.5-2.02-4.5-4.5l0.025-55.005c0.003-2.479,2.021-4.495,4.5-4.495h27.977c13.51,0,24.5,10.991,24.5,24.5v23c0,2.48-2.02,4.5-4.5,4.5s-4.5-2.02-4.5-4.5v-23C48.001,23.412,41.048,16.458,32.501,16.458z M74.417,7.458c-2.481,0-4.5,2.019-4.5,4.5l-0.021,50.5h-23.48c-8.547,0-15.5-6.953-15.5-15.5v-23c0-2.481-2.019-4.5-4.5-4.5s-4.5,2.019-4.5,4.5v23c0,13.509,10.99,24.5,24.5,24.5h27.977c2.479,0,4.498-2.016,4.5-4.495l0.024-55.005C78.917,9.478,76.898,7.458,74.417,7.458z" /></svg>
                    </label>
                    <div class="input-group">
                        <input type="number" step="0.01" min="0.01" class="form-control"
                               id="pointsToSARRate" name="pointsToSARRate"
                               value="@(Model?.PointsToSARRate ?? 1.0m)" />
                        <span class="input-group-text">ريال / نقطة</span>
                    </div>
                    <small class="text-muted">مثال: 1.00 يعني أن كل نقطة تساوي ريال واحد</small>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label mb-1">
                        <i class="fas fa-arrow-down text-warning me-2"></i>
                        الحد الأدنى لاسترداد النقاط
                    </label>
                    <div class="input-group">
                        <input type="number" min="1" class="form-control"
                               id="minRedeemPoints" name="minRedeemPoints"
                               value="@(Model?.MinRedeemPoints ?? 100)" />
                        <span class="input-group-text">نقطة</span>
                    </div>
                    <small class="text-muted">أقل عدد نقاط يمكن استردادها</small>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label mb-1">
                        <i class="fas fa-arrow-up text-danger me-2"></i>
                        الحد الأقصى لاسترداد النقاط
                    </label>
                    <div class="input-group">
                        <input type="number" min="1" class="form-control"
                               id="maxRedeemPoints" name="maxRedeemPoints"
                               value="@(Model?.MaxRedeemPoints ?? 10000)" />
                        <span class="input-group-text">نقطة</span>
                    </div>
                    <small class="text-muted">أكبر عدد نقاط يمكن استردادها في المرة الواحدة</small>
                </div>

                <div class="col-12 mb-3">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>ملاحظة:</strong> هذه الإعدادات تحكم في كيفية استرداد العملاء للنقاط والحصول على خصومات على فواتير الطلبات وسجلات الصيانة.
                    </div>
                </div>
            </div>
        </div>

        <!-- Delivery Fee Section (Separate) -->
        <div class="card mb-4">
            <h5 class="card-header p-0 m-0">
                <div class="text-center fw-bold text-info" style="width: 100%;padding-top:3%;">
                    إعدادات رسوم التوصيل
                </div>
            </h5>

            <div class="card-body row">
                <div class="col-md-4 mb-3">
                    <label class="form-label mb-1">
                        <i class="fas fa-truck text-info me-2"></i>
                        رسوم التوصيل
                    </label>
                    <div class="input-group">
                        <input type="number" step="0.01" min="0" class="form-control"
                               id="deliveryFee" name="deliveryFee"
                               value="@(Model?.DeliveryFee ?? 0.00m)" />
                        <span class="input-group-text">ريال</span>
                    </div>
                    <small class="text-muted">أدخل رسوم التوصيل لكل طلب (مثال: 15.00 ريال)</small>
                </div>
            </div>
        </div>

        <!-- Form Buttons -->
        <div class="row">
            <div class="col-12">
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="fas fa-save me-2"></i>
                    حفظ جميع الإعدادات
                </button>
                <input type="reset" class="btn btn-secondary btn-lg ms-2" value="إعادة الضبط" />
            </div>
        </div>
    </div>

    @Html.AntiForgeryToken()
</form>

@section Scripts
{
    <script type="text/javascript">
        document.getElementById("centerSettingForm").addEventListener("submit", function (e) {
            e.preventDefault();

            // Validate points settings
            const pointsToSARRate = parseFloat(document.getElementById("pointsToSARRate").value);
            const minRedeemPoints = parseInt(document.getElementById("minRedeemPoints").value);
            const maxRedeemPoints = parseInt(document.getElementById("maxRedeemPoints").value);
            const deliveryFee = parseFloat(document.getElementById("deliveryFee").value);

            if (pointsToSARRate <= 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'تحذير',
                    text: 'معدل تحويل النقاط يجب أن يكون أكبر من صفر',
                    confirmButtonText: 'موافق'
                });
                return;
            }

            if (minRedeemPoints >= maxRedeemPoints) {
                Swal.fire({
                    icon: 'warning',
                    title: 'تحذير',
                    text: 'الحد الأدنى يجب أن يكون أقل من الحد الأقصى لاسترداد النقاط',
                    confirmButtonText: 'موافق'
                });
                return;
            }

            if (deliveryFee < 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'تحذير',
                    text: 'رسوم التوصيل يجب أن تكون صفر أو أكبر',
                    confirmButtonText: 'موافق'
                });
                return;
            }

            const formData = {
                centerName: document.getElementById("centerName").value,
                logoUrl: document.getElementById("logoUrl").value,
                faviconUrl: document.getElementById("faviconUrl").value,
                address: document.getElementById("address").value,
                email: document.getElementById("email").value,
                phoneNumber: document.getElementById("phoneNumber").value,
                twitterUrl: document.getElementById("twitterUrl").value,
                facebookUrl: document.getElementById("facebookUrl").value,
                instagramUrl: document.getElementById("instagramUrl").value,
                linkedInUrl: document.getElementById("linkedInUrl").value,
                pointsToSARRate: pointsToSARRate,
                minRedeemPoints: minRedeemPoints,
                maxRedeemPoints: maxRedeemPoints,
                deliveryFee: deliveryFee
            };

            fetch('/admin/CenterSetting/Edit', {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(formData)
            })
            .then(response => {
                if (response.ok) {
                    Swal.fire({
                        icon: 'success',
                        title: 'تم الحفظ',
                        text: 'تم تحديث جميع الإعدادات بنجاح!',
                        confirmButtonText: 'موافق'
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'فشل التحديث',
                        text: 'حدث خطأ أثناء حفظ البيانات.',
                        confirmButtonText: 'موافق'
                    });
                }
            })
            .catch(error => {
                Swal.fire({
                    icon: 'error',
                    title: 'خطأ غير متوقع',
                    text: error.message
                });
            });
        });



        document.getElementById("logoFile").addEventListener("change", function () {
            const file = this.files && this.files[0];
            if (!file) {
                return;
            }

            const uploadData = new FormData();
            uploadData.append("logo", file);

            fetch('/admin/CenterSetting/UploadLogo', {
                method: 'POST',
                body: uploadData
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('فشل رفع الشعار');
                }
                return response.json();
            })
            .then(result => {
                document.getElementById("logoUrl").value = result.logoUrl;
                document.getElementById("logoPreview").src = result.logoUrl;
                Swal.fire({
                    icon: 'success',
                    title: 'تم رفع الشعار',
                    timer: 1200,
                    showConfirmButton: false
                });
            })
            .catch(error => {
                Swal.fire({
                    icon: 'error',
                    title: 'فشل رفع الشعار',
                    text: error.message
                });
            });
        });

        document.getElementById("faviconFile").addEventListener("change", function () {
            const file = this.files && this.files[0];
            if (!file) {
                return;
            }

            const uploadData = new FormData();
            uploadData.append("favicon", file);

            fetch('/admin/CenterSetting/UploadFavicon', {
                method: 'POST',
                body: uploadData
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('فشل رفع الأيقونة');
                }
                return response.json();
            })
            .then(result => {
                document.getElementById("faviconUrl").value = result.faviconUrl;
                document.getElementById("faviconPreview").src = result.faviconUrl;
                Swal.fire({
                    icon: 'success',
                    title: 'تم رفع الأيقونة',
                    timer: 1200,
                    showConfirmButton: false
                });
            })
            .catch(error => {
                Swal.fire({
                    icon: 'error',
                    title: 'فشل رفع الأيقونة',
                    text: error.message
                });
            });
        });

        // Real-time conversion preview
        document.getElementById("pointsToSARRate").addEventListener("input", function() {
            const rate = parseFloat(this.value);
            const minPoints = parseInt(document.getElementById("minRedeemPoints").value);
            const maxPoints = parseInt(document.getElementById("maxRedeemPoints").value);

            if (rate > 0) {
                const minAmount = (minPoints * rate).toFixed(2);
                const maxAmount = (maxPoints * rate).toFixed(2);
                // Optional: display these amounts in the UI
            }
        });
    </script>
}
