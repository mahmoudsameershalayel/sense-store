@using Sense.Domain.Enums
@model Sense.Domain.DBEntities.ProviderRequestTbl

@{
    var message = TempData["Message"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
    var statusClass = Model.Status switch
    {
        ProviderRequestStatus.Approved => "badge-light-success",
        ProviderRequestStatus.Rejected => "badge-light-danger",
        _ => "badge-light-warning"
    };
    var statusText = Model.Status switch
    {
        ProviderRequestStatus.Approved => "مقبول",
        ProviderRequestStatus.Rejected => "مرفوض",
        _ => "قيد المراجعة"
    };
}

@functions {
    private static string FormatFileSize(long bytes)
        => bytes >= 1024 * 1024
            ? $"{bytes / 1024d / 1024d:0.##} MB"
            : $"{bytes / 1024d:0.##} KB";
}

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="fs-2 fw-bold mb-1">@Model.BusinessName</h1>
        <span class="badge @statusClass">@statusText</span>
    </div>
    <a asp-action="Index" class="btn btn-light">العودة إلى الطلبات</a>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-success">@message</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row g-5">
    <div class="col-xl-7">
        <div class="card card-flush mb-5">
            <div class="card-header">
                <h3 class="card-title">بيانات الطلب</h3>
            </div>
            <div class="card-body">
                <div class="row g-5">
                    <div class="col-md-6">
                        <div class="text-muted fs-7 mb-1">مقدم الطلب</div>
                        <div class="fw-bold">@Model.FullName</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted fs-7 mb-1">النشاط التجاري</div>
                        <div class="fw-bold">@Model.BusinessName</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted fs-7 mb-1">البريد الإلكتروني</div>
                        <a href="mailto:@Model.Email" class="fw-bold">@Model.Email</a>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted fs-7 mb-1">رقم الهاتف</div>
                        <a href="tel:@Model.PhoneNumber" class="fw-bold" dir="ltr">@Model.PhoneNumber</a>
                    </div>
                    <div class="col-12">
                        <div class="text-muted fs-7 mb-1">وصف النشاط التجاري</div>
                        <div class="border rounded p-4" style="white-space:pre-wrap;">@Model.BusinessDescription</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted fs-7 mb-1">تاريخ التقديم</div>
                        <div>@Model.CreatedAt?.ToString("yyyy/MM/dd HH:mm")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted fs-7 mb-1">الموافقة على الشروط</div>
                        <div>@(Model.AcceptedTerms ? "نعم" : "لا")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-flush mb-5">
            <div class="card-header">
                <h3 class="card-title">وثيقة التحقق الخاصة</h3>
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 border rounded p-4">
                    <div>
                        <div class="fw-bold">@Model.DocumentOriginalName</div>
                        <div class="text-muted fs-7">@FormatFileSize(Model.DocumentFileSize) · متاحة لمسؤولي النظام فقط</div>
                    </div>
                    <a asp-action="Document" asp-route-id="@Model.Id" class="btn btn-light-primary">
                        <i class="ki-duotone ki-file-down fs-2"></i>
                        تنزيل الوثيقة
                    </a>
                </div>
            </div>
        </div>

        @if (Model.Status != ProviderRequestStatus.Pending)
        {
            <div class="card card-flush">
                <div class="card-header">
                    <h3 class="card-title">نتيجة المراجعة</h3>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="text-muted fs-7 mb-1">تاريخ المراجعة</div>
                            <div>@Model.ReviewedAt?.ToString("yyyy/MM/dd HH:mm")</div>
                        </div>
                        @if (Model.Status == ProviderRequestStatus.Approved && Model.ApprovedProvider is not null)
                        {
                            <div class="col-md-6">
                                <div class="text-muted fs-7 mb-1">حساب المزود</div>
                                <a asp-controller="Provider"
                                   asp-action="Edit"
                                   asp-route-id="@Model.ApprovedProvider.ApplicationUserId">فتح حساب المزود</a>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
                        {
                            <div class="col-12">
                                <div class="text-muted fs-7 mb-1">سبب الرفض المرسل لمقدم الطلب</div>
                                <div class="alert alert-danger mb-0">@Model.RejectionReason</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.InternalNote))
                        {
                            <div class="col-12">
                                <div class="text-muted fs-7 mb-1">ملاحظة داخلية</div>
                                <div class="border rounded p-4">@Model.InternalNote</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.Status == ProviderRequestStatus.Pending)
    {
        <div class="col-xl-5">
            <div class="card card-flush mb-5">
                <div class="card-header">
                    <h3 class="card-title text-success">قبول الطلب</h3>
                </div>
                <div class="card-body">
                    <p class="text-muted">
                        سيُنشأ حساب Identity وحساب مزوّد، ثم تُرسل كلمة مرور مؤقتة إلى مقدم الطلب.
                    </p>
                    <form asp-action="Approve" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@Model.Id" />
                        <div class="mb-4">
                            <label for="approve-internal-note" class="form-label">ملاحظة داخلية (اختياري)</label>
                            <textarea id="approve-internal-note" name="InternalNote" class="form-control" rows="4" maxlength="3000"></textarea>
                        </div>
                        <button type="submit" class="btn btn-success w-100"
                                onclick="return confirm('هل تريد قبول الطلب وإنشاء حساب المزود؟');">
                            قبول وإنشاء الحساب
                        </button>
                    </form>
                </div>
            </div>

            <div class="card card-flush border border-danger">
                <div class="card-header">
                    <h3 class="card-title text-danger">رفض الطلب</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Reject" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@Model.Id" />
                        <div class="mb-4">
                            <label for="rejection-reason" class="form-label required">سبب الرفض</label>
                            <textarea id="rejection-reason" name="RejectionReason" class="form-control" rows="4" maxlength="2000" required></textarea>
                            <div class="form-text">سيظهر هذا النص في رسالة البريد الإلكتروني المرسلة لمقدم الطلب.</div>
                        </div>
                        <div class="mb-4">
                            <label for="reject-internal-note" class="form-label">ملاحظة داخلية (اختياري)</label>
                            <textarea id="reject-internal-note" name="InternalNote" class="form-control" rows="3" maxlength="3000"></textarea>
                        </div>
                        <button type="submit" class="btn btn-light-danger w-100"
                                onclick="return confirm('هل تريد رفض هذا الطلب؟');">
                            رفض الطلب
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
