@using Sense.Domain.Enums
@model List<Sense.Domain.DBEntities.ProviderRequestTbl>

@{
    var selectedStatus = ViewBag.SelectedStatus as string ?? "Pending";
    var message = TempData["Message"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-success">@message</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card mb-xl-8">
    <div class="card-header border-0 pt-5">
        <div class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">طلبات انضمام المزودين</span>
            <span class="text-muted mt-1 fw-semibold fs-7">مراجعة بيانات ووثائق المتقدمين وقبول الطلبات أو رفضها.</span>
        </div>
    </div>

    <div class="card-body pt-3">
        <div class="d-flex flex-wrap gap-2 mb-5">
            <a asp-action="Index" asp-route-status="Pending"
               class="btn btn-sm @(selectedStatus == "Pending" ? "btn-primary" : "btn-light-primary")">قيد المراجعة</a>
            <a asp-action="Index" asp-route-status="Approved"
               class="btn btn-sm @(selectedStatus == "Approved" ? "btn-primary" : "btn-light-primary")">المقبولة</a>
            <a asp-action="Index" asp-route-status="Rejected"
               class="btn btn-sm @(selectedStatus == "Rejected" ? "btn-primary" : "btn-light-primary")">المرفوضة</a>
            <a asp-action="Index" asp-route-status="All"
               class="btn btn-sm @(selectedStatus == "All" ? "btn-primary" : "btn-light-primary")">الكل</a>
        </div>

        <div class="table-responsive">
            <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                <thead>
                    <tr class="fw-bold text-muted bg-light">
                        <th class="ps-4 min-w-180px rounded-start">النشاط التجاري</th>
                        <th class="min-w-160px">مقدم الطلب</th>
                        <th class="min-w-180px">بيانات التواصل</th>
                        <th class="min-w-120px">الحالة</th>
                        <th class="min-w-130px">تاريخ التقديم</th>
                        <th class="min-w-80px text-end rounded-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-10">لا توجد طلبات ضمن هذا التصنيف.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var badgeClass = item.Status switch
                            {
                                ProviderRequestStatus.Approved => "badge-light-success",
                                ProviderRequestStatus.Rejected => "badge-light-danger",
                                _ => "badge-light-warning"
                            };
                            var statusText = item.Status switch
                            {
                                ProviderRequestStatus.Approved => "مقبول",
                                ProviderRequestStatus.Rejected => "مرفوض",
                                _ => "قيد المراجعة"
                            };

                            <tr>
                                <td class="ps-4">
                                    <span class="text-gray-900 fw-bold d-block fs-6">@item.BusinessName</span>
                                </td>
                                <td>@item.FullName</td>
                                <td>
                                    <a href="mailto:@item.Email" class="text-gray-800 d-block">@item.Email</a>
                                    <span class="text-muted" dir="ltr">@item.PhoneNumber</span>
                                </td>
                                <td><span class="badge @badgeClass">@statusText</span></td>
                                <td>@item.CreatedAt?.ToString("yyyy/MM/dd HH:mm")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light-primary">فتح</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
