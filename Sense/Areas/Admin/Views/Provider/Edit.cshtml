@using Sense.Application.DTOs.ProviderDTOs
@model ProviderForUpdateDto

<form asp-controller="Provider" asp-action="Edit" asp-route-id="@ViewBag.UserId" method="POST" enctype="multipart/form-data" class="form">
    <input type="hidden" asp-for="LogoURL" />
    <div class="container-xxl">
        <div class="card card-flush mb-10">
            <div class="card-header">
                <h3 class="card-title">تعديل بيانات المزود</h3>
            </div>
            <div class="card-body pt-0">
                <div asp-validation-summary="ModelOnly" class="text-danger fs-7 mb-3"></div>

                <div class="row mb-5">
                    <div class="col-md-6">
                        <label class="form-label">شعار المزود</label>
                        <div class="mb-3">
                            @if (!string.IsNullOrWhiteSpace(Model.LogoURL))
                            {
                                <img src="@Model.LogoURL" alt="@Model.DisplayName" class="symbol symbol-75px symbol-circle" style="width:75px;height:75px;object-fit:cover;border-radius:50%;" />
                            }
                        </div>
                        <input type="file" asp-for="Logo" class="form-control" accept="image/png,image/jpeg" />
                        <span asp-validation-for="Logo" class="text-danger fs-7"></span>
                    </div>
                </div>

                <div class="row mb-5">
                    <div class="col-md-6">
                        <label asp-for="DisplayName" class="form-label required">اسم المزود</label>
                        <input asp-for="DisplayName" class="form-control" required />
                        <span asp-validation-for="DisplayName" class="text-danger fs-7"></span>
                    </div>
                </div>

                <div class="row mb-5">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label required">البريد الإلكتروني</label>
                        <input type="email" asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger fs-7"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label">رقم الهاتف</label>
                        <input type="text" asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger fs-7"></span>
                    </div>
                </div>

                <div class="d-flex gap-3 mt-6">
                    <button type="submit" class="btn btn-primary">
                        <i class="ki-duotone ki-check fs-2"></i> حفظ التعديلات
                    </button>
                    <a asp-area="admin" asp-controller="Provider" asp-action="Index" class="btn btn-light">
                        إلغاء
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>
