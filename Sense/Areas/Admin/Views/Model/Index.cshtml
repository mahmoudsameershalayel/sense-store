@using Sense.Application.DTOs.ModelDTOs
@model List<ModelDto>
@{
    var message = TempData["Message"];
    var errorMessage = TempData["ErrorMessage"];
    var brands = ViewBag.Brands;
}
<!--begin::Tables Widget 10-->
<div class="card mb-xl-8">
    <!--begin::Header-->
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">جدول موديلات السيارات</span>
            <span class="text-muted mt-1 fw-semibold fs-7">يحتوي هذا الجدول على جميع بيانات موديلات السيارات والعمليات عليها.</span>
        </h3>
        <div class="card-toolbar" title="اضغط لإضافة موديل جديد">
            <a asp-area="admin" asp-controller="Model" asp-action="add" class="btn btn-sm btn-light btn-active-primary">
                <i class="ki-duotone ki-plus fs-2"></i>موديل سيارة جديد
            </a>
        </div>
    </div>
    <!--end::Header-->
    <!--begin::Body-->
    <div class="card-body pt-3">
        <!--begin::Table container-->
        <div class="table-responsive">
            <!--begin::Table-->
            <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                <!--begin::Table head-->
                <thead>
                    <tr class="fw-bold text-muted bg-light">
                        <th class="ps-4 min-w-325px rounded-start">موديل السيارة</th>
                        <th class="min-w-125px">الماركة</th>
                        <th class="min-w-125px">الموديل</th>
                        <th class="min-w-200px text-end rounded-end"></th>
                    </tr>
                </thead>
                <!--end::Table head-->
                <!--begin::Table body-->
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="d-flex justify-content-start flex-column">
                                        <a href="#" class="text-gray-900 fw-bold text-hover-primary mb-1 fs-6">#@item.Id</a>
                                    </div>
                                </div>
                            </td>
                            <td id="model-brand-@item.Id">
                                <a href="#" class="text-gray-900 fw-bold text-hover-primary mb-1 fs-6">@item.Brand?.Name</a>
                            </td>
                            <td id="model-name-@item.Id">
                                <a href="#" class="text-gray-900 fw-bold text-hover-primary mb-1 fs-6">@item.Name</a>
                            </td>
                            <td class="text-end">
                                <a href="#" class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1 edit-model" data-id="@item.Id" data-brandid="@item.Brand?.Id" data-name="@item.Name">
                                    <i class="ki-duotone ki-pencil fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                </a>
                                <a asp-route-id="@item.Id" data-id="@item.Id" class="btn btn-delete btn-icon btn-bg-light btn-active-color-primary btn-sm">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                        <span class="path3"></span>
                                        <span class="path4"></span>
                                        <span class="path5"></span>
                                    </i>
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>
                <!--end::Table body-->
            </table>
            <!--end::Table-->
        </div>
        <!--end::Table container-->
    </div>
</div>

<div class="modal fade" id="editModelModal" tabindex="-1" aria-labelledby="editModelModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editModelForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="editModelModalLabel">تعديل الموديل</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editModelId" />

                    <div class="mb-3">
                        <label for="editBrandId" class="form-label">اختر البراند</label>
                        <select id="editBrandId" class="form-select form-select-lg" required>
                            <option disabled selected hidden>-- اختر البراند --</option>
                            @foreach (var brand in ViewBag.Brands)
                            {
                                <option value="@brand.Id">@brand.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="editModelName" class="form-label">اسم الموديل</label>
                        <input type="text" class="form-control" id="editModelName" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">تحديث</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            toastr.options = {
                "closeButton": true,
                "debug": false,
                "newestOnTop": false,
                "progressBar": true,
                "positionClass": "toast-bottom-left",
                "preventDuplicates": true,
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "2000", // Show for 2 seconds
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut"
            };


            let selectedModel = null;

            // Open modal & fill inputs when edit button clicked
            $(document).on('click', '.edit-model', function () {
                // Read data attributes from the clicked button
                selectedModel = {
                    id: $(this).data('id'),
                    brandId: $(this).data('brandid'),
                    name: $(this).data('name')
                };

                $('#editModelId').val(selectedModel.id);
                $('#editBrandId').val(selectedModel.brandId);
                $('#editModelName').val(selectedModel.name);

                $('#editModelModal').modal('show');
            });

            // Submit edited data
            $('#editModelForm').submit(function (e) {
                e.preventDefault();

                const modelId = $('#editModelId').val();
                const data = {
                    BrandId: parseInt($('#editBrandId').val()),
                    Name: $('#editModelName').val()
                };

                $.ajax({
                    url: `/Admin/Model/Edit/${modelId}`,
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function (res) {
                        toastr.success(res.message || 'تم تحديث الموديل بنجاح');
                        $('#editModelModal').modal('hide');

                        // Update UI example (adjust selector accordingly)
                        $('#model-name-' + modelId).text(data.Name);
                        $('#model-brand-' + modelId).text($('#editBrandId option:selected').text());
                    },
                    error: function (xhr) {
                        toastr.error(xhr.responseText || 'حدث خطأ أثناء التحديث');
                    }
                });
            });

            $(".btn-delete").on("click", function (e) {
                const $this = $(this);
                const id = $(this).attr("data-id");

                Swal.fire({
                    title: 'هل أنت متأكد؟',
                    text: "سيتم حذف الفرع نهائيًا!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'نعم، احذفه!',
                    cancelButtonText: 'إلغاء'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "@Url.Action("Delete", "Model", new { area = "Admin" })/" + id,
                            type: 'DELETE',
                            success: function (result) {
                                Swal.fire(
                                    'تم الحذف!',
                                    'تم حذف الفرع بنجاح.',
                                    'success'
                                );
                                $this.closest("tr").remove();
                            }
                        });
                    }
                });

                e.preventDefault();
            });
            $(".btn-pge").on("click", function (e) {
                $this = $(this);
                var pg = $(this).attr("data-pg");
                if (result.isConfirmed) {
                    $.ajax({
                        url: "@Url.Action("Index", "Brand", new { area = "Admin" })/" + pg,
                        type: 'POST'

                    });
                }
            })
            e.preventDefault();
        });


    </script>
}