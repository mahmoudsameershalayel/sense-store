@model Sense.Areas.Admin.Models.ChangePasswordViewModel

@{
    var message = TempData["Message"];
}

<div class="card mb-xl-8">
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">تغيير كلمة المرور</span>
            <span class="text-muted mt-1 fw-semibold fs-7">استخدم كلمة المرور الحالية لتعيين كلمة مرور جديدة لحساب مسؤول النظام.</span>
        </h3>
    </div>
    <div class="card-body pt-3">
        @if (message != null)
        {
            <div class="alert alert-success d-flex align-items-center gap-2">
                <i class="fas fa-check-circle"></i>
                <span>@message</span>
            </div>
        }

        <form asp-area="Admin" asp-controller="Account" asp-action="ChangePassword" method="post" class="form w-100 mw-600px">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

            <div class="mb-5">
                <label asp-for="CurrentPassword" class="form-label required">كلمة المرور الحالية</label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="text-danger fs-7"></span>
            </div>

            <div class="mb-5">
                <label asp-for="NewPassword" class="form-label required">كلمة المرور الجديدة</label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger fs-7"></span>
            </div>

            <div class="mb-7">
                <label asp-for="ConfirmPassword" class="form-label required">تأكيد كلمة المرور الجديدة</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger fs-7"></span>
            </div>

            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-primary">
                    حفظ كلمة المرور
                </button>
                <a asp-area="Admin" asp-controller="Account" asp-action="Profile" class="btn btn-light">
                    رجوع
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
