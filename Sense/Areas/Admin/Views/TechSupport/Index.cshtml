@using Sense.Domain.Enums
@using Sense.Application.DTOs.AuthDTOs
@using Sense.Application.DTOs.TechSupportDTOs
@using Sense.Infrastructure.Extensions
@model List<UserDto>
@{
    var message = TempData["Message"];
    var errorMessage = TempData["ErrorMessage"];

    var name = Context.Request.Query["Name"];

}
<!--begin::Tables Widget 10-->
<div class="card mb-xl-8">
    <!--begin::Header-->
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">جدول موظفين الدعم الفني</span>
            <span class="text-muted mt-1 fw-semibold fs-7">يحتوي هذا الجدول على جميع بيانات موظفين الدعم الفني والعمليات عليها.</span>
        </h3>
        <div class="card-toolbar" title="اضغط لإضافة موظف">
            <a asp-area="admin" asp-controller="TechSupport" asp-action="add" class="btn btn-sm btn-light btn-active-primary">
                <i class="ki-duotone ki-plus fs-2"></i>موظف جديد
            </a>
        </div>
    </div>
    <!--end::Header-->
    <!--begin::Body-->
    <div class="card-body pt-3">
        <!-- Add AJAX functionality to the form -->
        <form id="filterForm" method="get" asp-action="Index" class="mb-4">
            <div class="row gx-5 gy-2">
                <!-- Service Type Filter -->
                <div class="col-md-3 mb-2">
                    <label for="techSupportName" class="form-label">إسم الموظف</label>
                    <input id="techSupportName" type="text" class="form-control" placeholder="البحث بإسم الموظف">
                </div>

                <!-- Filter Button (Optional, but to trigger AJAX) -->
                <div class="col-md-3 mb-2 d-flex align-items-end">
                    <button type="button" id="filterButton" class="btn btn-primary w-20"><i class="fas fa-search"></i></button>
                </div>
            </div>
        </form>
        <!--begin::Table container-->
        <div class="table-responsive" id="techSupportsTable">
            <!--begin::Table-->
            <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                <!--begin::Table head-->
                <thead>
                    <tr class="fw-bold text-muted bg-light">
                        <th class="ps-4 min-w-200px rounded-start">الموظف</th>
                        <th class="min-w-120px">الإسم بالكامل</th>
                        <th class="min-w-120px">الإيميل</th>
                        <th class="min-w-100px">رقم الهاتف</th>
                        <th class="min-w-120px">صلاحية المستخدم</th>
                        <th class="min-w-50px">حالة الحساب</th>
                        <th class="min-w-50px text-end rounded-end"></th>
                    </tr>
                </thead>
                <!--end::Table head-->
                <!--begin::Table body-->
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="symbol symbol-50px m-5">
                                        <img src="@item.ImageURL" class="" alt="" />
                                    </div>
                                    <div class="d-flex justify-content-start flex-column">
                                        <a href="#" class="text-gray-900 fw-bold text-hover-primary mb-1 fs-6">@item.Username</a>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <a href="#" class="text-gray-900 fw-bold text-hover-primary d-block mb-1 fs-6">@item.FullName</a>
                            </td>
                            <td>
                                <a href="#" class="text-gray-900 fw-bold text-hover-primary d-block mb-1 fs-6">@item.Email</a>
                            </td>
                            <td>
                                <a href="#" class="text-gray-900 fw-bold text-hover-primary d-block mb-1 fs-6">@item.PhoneNumber</a>
                            </td>
                            <td>
                                <span class="badge badge-light-primary fs-7 fw-bold">
                                    @{
                                        var typeEnum = (UserType)Enum.Parse(typeof(UserType), item.UserType);
                                        var arabicType = typeEnum.GetDisplayName();
                                    }
                                    @arabicType
                                </span>
                            </td>
                            <td>
                                <span id="status-badge-@item.Id"
                                      class="badge toggle-status @(item.IsActive ? "bg-success" : "bg-danger") fs-7 fw-bold"
                                      data-id="@item.Id"
                                      role="button"
                                      style="cursor: pointer;color:white;"
                                      title="اضغط لتغيير حالة الحساب">
                                    @(item.IsActive ? "نشط" : "معطل")
                                </span>
                            </td>

                            <td class="text-end">
                                <a asp-area="admin" asp-controller="TechSupport" asp-action="uploadimage" asp-route-id="@item.Id" class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1" title="ارفع صورة للمشرف">
                                    <i class="ki-duotone ki-switch fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                </a>
                                @*
                            <button class="btn btn-icon btn-sm btn-bg-light edit-tech-support"
                            data-id="@item.Id"
                            data-firstName="@item.FirstName"
                            data-lastName="@item.LastName"
                            data-username="@item.Username"
                            data-email="@item.Email"
                            data-phone="@item.PhoneNumber"
                            data-phone1="@item.Phone1"
                            data-phone2="@item.Phone2"
                            title="تعديل">
                            <i class="ki-duotone ki-pencil fs-2">
                            <span class="path1"></span>
                            <span class="path2"></span>
                            </i>
                            </button>
                                *@
                                

                            </td>
                        </tr>
                    }

                </tbody>
                <!--end::Table body-->
            </table>
            <!--end::Table-->
            <!-- Pagination -->
            <div class="pagination-container text-center mt-3">
                <!-- Previous Page Button -->
                @if (ViewBag.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", new {
                        pageNumber = ViewBag.CurrentPage - 1,
                        pageSize = ViewBag.PageSize,
                        searchTerm = ViewBag.SearchTerm,
                        name = name,
                    })" class="btn btn-primary">
                        الصفحة السابقة
                    </a>
                }

                <!-- Page Number Display -->
                <span class="mx-2">
                    صفحة @ViewBag.CurrentPage من @ViewBag.TotalPages
                </span>

                <!-- Next Page Button -->
                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a href="@Url.Action("Index", new {
                        pageNumber = ViewBag.CurrentPage + 1,
                        pageSize = ViewBag.PageSize,
                        searchTerm = ViewBag.SearchTerm,
                        name = name,
                    })" class="btn btn-primary">
                        الصفحة التالية
                    </a>
                }
            </div>
        </div>
        <!--end::Table container-->
    </div>
</div>

<!-- Update Supervisor Modal -->
<div class="modal fade" id="updateSupervisorModal" tabindex="-1" aria-labelledby="updateSupervisorModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="updateSupervisorForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="updateSupervisorModalLabel">تعديل بيانات المشرف</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="supervisorId" name="Id" />

                    <div class="mb-3">
                        <label for="firstName" class="form-label">الاسم الأول</label>
                        <input type="text" class="form-control" id="firstName" name="firstName" required />
                    </div>
                    <div class="mb-3">
                        <label for="lastName" class="form-label">الاسم الأخير</label>
                        <input type="text" class="form-control" id="lastName" name="lastName" required />
                    </div>
                    <div class="mb-3">
                        <label for="username" class="form-label">اسم المستخدم</label>
                        <input type="text" class="form-control" id="username" name="Username" required />
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">الإيميل</label>
                        <input type="email" class="form-control" id="email" name="Email" required />
                    </div>
                    <div class="mb-3">
                        <label for="phoneNumber" class="form-label">رقم الهاتف</label>
                        <input type="text" class="form-control" id="phoneNumber" name="PhoneNumber" />
                    </div>
                    <div class="mb-3">
                        <label for="phone1" class="form-label">رقم إضافي 1</label>
                        <input type="text" class="form-control" id="phone1" name="Phone1" />
                    </div>
                    <div class="mb-3">
                        <label for="phone2" class="form-label">رقم إضافي 2</label>
                        <input type="text" class="form-control" id="phone2" name="Phone2" />
                    </div>
                    <div class="mb-3">
                        <label for="branchId" class="form-label">الفرع</label>
                        <input type="number" class="form-control" id="branchId" name="BranchId" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">تحديث</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#filterButton').on('click', function (e) {
                e.preventDefault();
                var name = $('#techSupportName').val();

                // Send AJAX request
                $.ajax({
                    url: "@Url.Action("Index", "TechSupport", new { area = "Admin" })",
                    type: 'GET',
                    data: { name: name },
                    success: function (response) {
                        // Update the appointments table with the new content
                        $('#techSupportsTable').html($(response).find('#techSupportsTable').html());
                    },
                    error: function () {
                        alert("There was an error while filtering the data.");
                    }
                });
            });

            toastr.options = {
                "closeButton": true,
                "debug": false,
                "newestOnTop": false,
                "progressBar": true,
                "positionClass": "toast-bottom-left",
                "preventDuplicates": true,
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "2000", 
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut"
            };

                     $('.toggle-status').click(function () {
    var button = $(this);
    var userId = button.data('id');
    var isActive = button.hasClass('bg-success'); // true if currently active

    // If the user is active, confirm before disabling
    if (isActive) {
        Swal.fire({
            title: 'هل أنت متأكد؟',
            text: "سيتم تعطيل حساب هذا المستخدم",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'نعم، قم بالتعطيل',
            cancelButtonText: 'إلغاء'
        }).then((result) => {
            if (result.isConfirmed) {
                changeUserStatus(userId, button);
            }
        });
    } else {
           Swal.fire({
            title: 'هل أنت متأكد؟',
            text: "سيتم تفعيل حساب هذا المستخدم",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'نعم، قم بالتفعيل',
            cancelButtonText: 'إلغاء'
        }).then((result) => {
            if (result.isConfirmed) {
                changeUserStatus(userId, button);
            }
        });
    }
});

            function changeUserStatus(userId, button) {
    $.ajax({
        url: "@Url.Action("ChangeStatus", "ApplicationUser", new { area = "Admin" })/" + userId,
        type: 'PUT',
        success: function (response) {
            toastr.success(response.message);

            // Toggle badge content and style
            const badge = $('#status-badge-' + userId);
            const isNowActive = badge.hasClass('bg-danger');

            badge.removeClass('bg-success bg-danger');
            badge.addClass(isNowActive ? 'bg-success' : 'bg-danger');
            badge.text(isNowActive ? 'نشط' : 'معطل');
        },
        error: function () {
            toastr.error("حدث خطأ أثناء تغيير حالة الحساب.");
        }
    });
}


            $('.edit-tech-support').click(function () {
                const fullName = $(this).data('fullname');
                const names = fullName.split(' ');

                $('#supervisorId').val($(this).data('id'));
                $('#firstName').val(names[0]);
                $('#lastName').val(names.slice(1).join(' ')); // Handles middle/last names
                $('#username').val($(this).data('username'));
                $('#email').val($(this).data('email'));
                $('#phoneNumber').val($(this).data('phone'));
                $('#phone1').val($(this).data('phone1'));
                $('#phone2').val($(this).data('phone2'));
                $('#branchId').val($(this).data('branch'));

                $('#updateSupervisorModal').modal('show');
            });
            $('#updateSupervisorForm').submit(function (e) {
                e.preventDefault();

                const firstName = $('#firstName').val().trim();
                const lastName = $('#lastName').val().trim();

                if (!firstName || !lastName) {
                    toastr.error('يرجى إدخال الاسم الأول واسم العائلة', 'خطأ');
                    return;
                }

                const fullName = firstName + ' ' + lastName;

                const data = {
                    Id: $('#supervisorId').val(),
                    FullName: fullName,
                    Username: $('#username').val(),
                    Email: $('#email').val(),
                    PhoneNumber: $('#phoneNumber').val(),
                    Phone1: $('#phone1').val(),
                    Phone2: $('#phone2').val(),
                    BranchId: parseInt($('#branchId').val())
                };

                $.ajax({
                    url: '@Url.Action("UpdateSupervisor", "Supervisor", new { area = "Admin" })',
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function (res) {
                        toastr.success('تم تحديث المشرف بنجاح', 'نجاح');
                        $('#updateSupervisorModal').modal('hide');

                        // Optional: Refresh table or update row content here
                    },
                    error: function () {
                        toastr.error('حدث خطأ أثناء تحديث البيانات', 'خطأ');
                    }
                });
            });
        });

    </script>
}