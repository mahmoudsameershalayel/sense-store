@*
    @model List<Order>

@foreach (var item in Model)
{
    <tr>
        <td>@item.Id</td>
        <td>@item.ClientName</td>
        <td>@item.Vehicle.Name</td>
        <td>@item.Brand.Name</td>
        <td>@item.OrderDate.ToString("dd/MM/yyyy")</td>
        <td>@item.OrderDate.ToString("hh:mm tt")</td>
        <td>@item.OrderStatus.NameAr</td>
        <td>
            <div class="dropdown">
                <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                    <i class="bx bx-dots-vertical-rounded"></i>
                </button>
                <div class="dropdown-menu">
                    <a class="dropdown-item" asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-id="@item.Id">
                        <i class="bx bx-info-circle me-1"></i>
                        تفاصيل الطلب
                    </a>
                    <a class="dropdown-item" asp-area="Admin" asp-controller="Order" asp-action="ChangeStatus" asp-route-id="@item.Id"><i class="bx bx-edit-alt me-1"></i>تعديل حالة الطلب</a>
                    <a class="dropdown-item btn-delete" asp-area="Admin" asp-controller="Order" asp-action="Delete" asp-route-id="@item.Id" data-id="@item.Id"><i class="bx bx-trash me-1"></i> حذف</a>
                </div>
            </div>
        </td>
    </tr>
}
*@
