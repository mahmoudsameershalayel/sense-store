@using Sense.Domain.Enums
@using Sense.Application.DTOs.AppointmentDTOs
@using System.ComponentModel.DataAnnotations
@using Sense.Infrastructure.Extensions
@model List<AppointmentDto>
@{
    var message = TempData["Message"];
    var errorMessage = TempData["ErrorMessage"];

    var branches = ViewBag.Branches;
    var services = ViewBag.Services;
    var brands = ViewBag.Brands;

    var totalPages = ViewBag.TotalPages;
    var currentPage = ViewBag.CurrentPage;
    var serviceType = Context.Request.Query["ServiceType"];
    var appointmentStatus = Context.Request.Query["Status"];
    var brandId = Context.Request.Query["BrandId"];
}
<!--begin::Tables Widget 10-->
<div class="card mb-xl-8">
    <!--begin::Header-->
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">جدول الحجوزات</span>
            <span class="text-muted mt-1 fw-semibold fs-7">يحتوي هذا الجدول على جميع بيانات الحجوزات والعمليات عليها.</span>
        </h3>

    </div>
    <!--end::Header-->
    <!--begin::Body-->
    <div class="card-body pt-3">
        <!-- Add AJAX functionality to the form -->
        <form id="filterForm" method="get" asp-action="Index" class="mb-4">
            <div class="row gx-5 gy-2">
                <!-- Service Type Filter -->
                <div class="col-md-3 mb-2">
                    <label for="ServiceType" class="form-label">نوع الخدمة</label>
                    <select class="form-select" name="ServiceId" id="ServiceType">
                        <option value="">-- الكل --</option>
                        @if (services != null)
                            @foreach (var service in services)
                            {
                                <option value="@service.Id">@service.TitleAr</option>
                            }
                        }
                    </select>
                </div>

                 <div class="col-md-3 mb-2">
                    <label for="BrandId" class="form-label">نوع السيارة</label>
                    <select class="form-select" name="BrandId" id="BrandId">
                        <option value="">-- الكل --</option>
                        @if (brands != null)
                            @foreach (var brand in brands)
                            {
                                <option value="@brand.Id">@brand.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- Status Filter -->
                <div class="col-md-3 mb-2">
                    <label for="Status" class="form-label">حالة الحجز</label>
                    <select class="form-select" name="Status" id="Status">
                        <option value="">-- الكل --</option>
                        @foreach (var status in Enum.GetValues(typeof(AppointmentStatus)))
                        {
                            var display = status.GetType()
                            .GetField(status.ToString())
                            ?.GetCustomAttributes(typeof(DisplayAttribute), false)
                            .FirstOrDefault() as DisplayAttribute;
                            var name = display?.Name ?? status.ToString();
                            var val = (int)status;
                            <option value="@val">@name</option>
                        }
                    </select>
                </div>

                <!-- Branch Filter -->
                <div class="col-md-3 mb-2">
                    <label for="BrandId" class="form-label">فرع الحجز</label>
                    <select class="form-select" name="BrandId" id="BrandId">
                        <option value="">-- الكل --</option>
                        @foreach (var branch in branches)
                        {
                            <option value="@branch.Id">@branch.BranchName</option>
                        }
                    </select>
                </div>

                <!-- Filter Button (Optional, but to trigger AJAX) -->
                <div class="col-md-3 mb-2 d-flex align-items-end">
                    <button type="button" id="filterButton" class="btn btn-primary w-100">فلتر</button>
                </div>
            </div>
        </form>


        <!--begin::Table container-->
        <div class="table-responsive">
            <table id="appointmentsTable"
                   class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-1 text-center">
                <thead>
                    <tr class="fw-bold text-muted bg-light">
                        <th>رقم الحجز</th>
                        <th>ماركة السيارة</th>
                        <th>موديل السيارة</th>
                        <th>سنة الموديل</th>
                        <th>نوع الخدمة</th>
                        <th>تاريخ التقديم</th>
                        <th>تاريخ الحجز</th>
                        <th>وقت الحجز</th>
                        <th>إسم الفرع</th>
                        <th>حالة الحجز</th>
                        <th class="text-end">الإجراءات</th>
                    </tr>
                </thead>
            </table>
  

        </div>
        <!--end::Table container-->
    </div>
    <!--end::Body-->

</div>




<!-- Modal for assign Appointment -->
<div class="modal fade" id="assignAppointmentModal" tabindex="-1" aria-labelledby="appointmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="appointmentModalLabel">جدولة موعد الحجز</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Appointment Form -->
                <form id="appointmentForm">
                    <input type="hidden" id="appointmentId" name="AppointmentId" value="">
                    <div class="row">
                        <div class="col-12">
                            <div class="card shadow-sm mb-4">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6 mb-4">
                                            <label for="branch" class="form-label">الفرع</label>
                                            <select id="branch" name="branch" class="select2 form-select form-select-lg" required>
                                                <option hidden disabled selected> -- اختر الفرع -- </option>
                                                @foreach (var branch in branches)
                                                {
                                                    <option value="@branch.Id">@branch.BranchName</option>
                                                }
                                            </select>
                                        </div>

                                        <div class="col-md-6 mb-4">
                                            <label for="supervisor" class="form-label">المشرف</label>
                                            <select id="supervisor" name="supervisor" class="select2 form-select form-select-lg" required>
                                                <option hidden disabled selected> -- اختر المشرف -- </option>
                                                <!-- Options will be loaded dynamically -->
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-4">
                                            <label for="datePicker" class="form-label">تاريخ الحجز</label>
                                            <input type="text" id="datePicker" class="form-control form-control-lg" required />
                                        </div>
                                        <div class="col-md-6 mb-4">
                                            <label for="timePicker" class="form-label">وقت الحجز</label>
                                            <input type="text" id="timePicker" class="form-control form-control-lg" required />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Submit Buttons -->
                    <div class="row mt-4">
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                            <button type="submit" class="btn btn-lg w-100" style="background-color: #253F8E; color: white;">تعيين</button>
                        </div>
                        <div class="col-lg-4 col-md-4 col-sm-6 mb-3">
                            <input type="reset" class="btn btn-warning btn-lg w-100" value="إعادة الضبط">
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>








@section Scripts {
    <!-- Flatpickr Arabic locale -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ar.js"></script>

    <script type="text/javascript">
                $(document).ready(function () {

            // تهيئة جدول الداتا
            var table = $('#appointmentsTable').DataTable({
                processing: true,
                serverSide: true,
                searching: true,
                ajax: {
                    url: '@Url.Action("LoadAppointments", "Appointment", new { area = "Admin" })',
                    type: 'POST',
                    data: function (d) {
                        d.ServiceType = $('#ServiceType').val();
                        d.Status = $('#Status').val();
                        d.BrandId = $('#BrandId').val();
                    }
                },
                columns: [
                    { data: "id" },
                    { data: "brand" },
                    { data: "model" },
                    { data: "modelYear" },
                    { data: "service" },
                    { data: "createdAtDate" },
                    { data: "scheduledDate" },
                    { data: "scheduledTime" },
                    { data: "branch" },
                    {
                        data: "status",
                        orderable: false,
                        render: function (data) {
                            return data; // HTML جاهز كبادج من السيرفر
                        }
                    },
                    {
                        data: "id",
                        orderable: false,
                        render: function (data, type, row) {
                            return `
                                <a href="/Admin/Appointment/Details/${data}" class="details-btn btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1">
                                    <i class="ki-duotone ki-eye fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </a>
                                <a href="/Admin/ApplicationUser/ActivityReport/${row.customerApplicationUserId}"
                                   class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1"
                                   title="تقرير نشاط العميل">
                                    <i class="ki-duotone ki-chart fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                </a>
                                <button class="assign-btn btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1"
                                        data-id="${data}" data-bs-toggle="modal" data-bs-target="#assignAppointmentModal">
                                    <i class="ki-duotone ki-calendar-edit fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" data-id="${data}" class="btn btn-cancel btn-icon btn-bg-light btn-active-color-primary btn-sm">
                                    <i class="ki-duotone ki-cross-circle fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>`;
                        }
                    }
                ],
                language: {
                    url: '/js/datatables/i18n/ar.json'
                }
            });

            // زر الفلترة
            $('#filterButton').on('click', function () {
                table.ajax.reload();
            });

            // حفظ مثيلات flatpickr للتحكم لاحقًا
            var datePickerInstance = flatpickr("#datePicker", {
                locale: "ar",
                dateFormat: "Y-m-d",
                defaultDate: new Date(),
                disableMobile: true,
                allowInput: true,
            });

            var timePickerInstance = flatpickr("#timePicker", {
                enableTime: true,
                noCalendar: true,
                dateFormat: "h:i K",  // 12 ساعة مع AM/PM
                time_24hr: false,
                locale: {
                    ...flatpickr.l10ns.ar,
                    amPM: ["ص", "م"] // AM = ص, PM = م
                },
                disableMobile: true,
                allowInput: true,
            });

            function convertTo24Hour(time12h) {
                // time12h مثال: "02:30 ص" أو "11:45 م"
                const [time, ampm] = time12h.split(' ');
                let [hours, minutes] = time.split(':').map(Number);

                if (ampm === "م" && hours < 12) {
                    hours += 12;
                }
                if (ampm === "ص" && hours === 12) {
                    hours = 0;
                }

                // تحويل للأصفار لوقت 24 ساعة
                const hoursStr = hours.toString().padStart(2, '0');
                const minutesStr = minutes.toString().padStart(2, '0');

                return `${hoursStr}:${minutesStr}`;
            }

            // عند فتح المودال: إعادة تعيين الحقول وتهيئة الفلاتر
            $('#assignAppointmentModal').on('show.bs.modal', function () {
                $('#appointmentForm')[0].reset();
                $('#supervisor').empty().append('<option hidden disabled selected> -- اختر المشرف -- </option>');
                datePickerInstance.clear();
                datePickerInstance.setDate(new Date());
                timePickerInstance.clear();
            });

            // تحميل المشرفين عند اختيار الفرع
            $('#branch').on('change', function () {
                var branchId = $(this).val();
                if (!branchId) return;

                $.ajax({
                    url: "@Url.Action("GetSupervisorsByBranch", "Appointment", new { area = "Admin" })/" + branchId,
                    type: 'GET',
                    data: { branchId: branchId },
                    success: function (data) {
                        var $supervisor = $('#supervisor');
                        $supervisor.empty();
                        $supervisor.append('<option hidden disabled selected> -- اختر المشرف -- </option>');
                        $.each(data, function (i, supervisor) {
                            $supervisor.append('<option value="' + supervisor.id + '">' + supervisor.name + '</option>');
                        });
                    },
                    error: function () {
                        alert('فشل تحميل المشرفين.');
                    }
                });
            });

            // تعيين قيمة appointmentId عند الضغط على زر التعيين
            $(document).on('click', '.assign-btn', function () {
                const appointmentId = $(this).data('id');
                $('#appointmentId').val(appointmentId);
            });

            // إرسال بيانات التعيين مع دمج التاريخ والوقت
            $('#appointmentForm').on('submit', function (e) {
                e.preventDefault();

                let scheduledDate = $('#datePicker').val(); // مثال: 2025-07-31
                let scheduledTime12h = $('#timePicker').val(); // مثال: 02:30 م أو 11:15 ص

                let scheduledTime24h = convertTo24Hour(scheduledTime12h);


                // دمج التاريخ والوقت بصيغة ISO 8601
                let combinedDateTime = scheduledDate + 'T' + scheduledTime24h + ":00";

                let dto = {
                    appointmentId: parseInt($('#appointmentId').val()),
                    scheduledDate: combinedDateTime,
                    branchId: parseInt($('#branch').val()),
                    supervisorId: parseInt($('#supervisor').val())
                };

                $.ajax({
                    url: "@Url.Action("AssignAppointment", "Appointment", new { area = "Admin" })",
                    type: 'PUT',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify(dto),
                    success: function (response) {
                         if (response.success) {
                                    Swal.fire({
                            icon: 'success',
                            title: 'تم التعيين!',
                            text: 'تم جدولة الحجز بنجاح.',
                            confirmButtonText: 'موافق',
                            timer: 3000
                        });
                        $('#assignAppointmentModal').modal('hide');
                        $('#appointmentForm')[0].reset();
                                    table.ajax.reload();
                                } else {
                                      $('#assignAppointmentModal').modal('hide');
                                      $('#appointmentForm')[0].reset();
                                    Swal.fire('لم يتم التعيين!', response.message || 'حدث خطأ أثناء تعيين الموعد.', 'warning');
                                }
                    },
                    error: function (xhr) {
                        Swal.fire({
                            icon: 'error',
                            title: 'حدث خطأ!',
                            text: 'حدث خطأ أثناء إرسال البيانات. الرجاء المحاولة لاحقاً.',
                            confirmButtonText: 'حسناً',
                            timer: 3000
                        });
                        console.error(xhr.responseText);
                    }
                });
            });

            // إلغاء موعد
            $(document).on('click', '.btn-cancel', function (e) {
                e.preventDefault();
                const id = $(this).data('id');

                Swal.fire({
                    title: 'هل أنت متأكد؟',
                    text: "سيتم إلغاء الموعد!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'نعم، قم بالإلغاء!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "@Url.Action("CancelAppointment", "Appointment", new { area = "Admin" })/" + id,
                            type: 'PUT',
                            success: function (response) {
                               if (response.success) {
                                    Swal.fire('تم الإلغاء!', 'تم إلغاء الموعد بنجاح.', 'success');
                                    table.ajax.reload();
                                } else {
                                    Swal.fire('لم يتم الإلغاء!', response.message || 'حدث خطأ أثناء إلغاء الموعد.', 'warning');
                                }
                            },
                            error: function (xhr) {
                                Swal.fire('خطأ!', 'حدث خطأ أثناء إلغاء الموعد.', 'error');
                                console.error(xhr.responseText);
                            }
                        });
                    }
                });
            });

            // تحميل تفاصيل الموعد عند الضغط على زر التفاصيل (إذا كنت تستخدم أزرار لها ids تبدأ بـ viewDetailsBtn-)
            $('[id^="viewDetailsBtn-"]').on('click', function () {
                var appointmentId = $(this).data('id');
                $.ajax({
                    url: "@Url.Action("GetAppointmentDetails", "Appointment", new { area = "Admin" })",
                    type: 'GET',
                    data: { id: appointmentId },
                    success: function (response) {
                        $('#appointmentDetailsContent').html(response);
                    },
                    error: function () {
                        alert('خطأ في جلب تفاصيل الموعد.');
                    }
                });
            });

        });

    </script>
}




