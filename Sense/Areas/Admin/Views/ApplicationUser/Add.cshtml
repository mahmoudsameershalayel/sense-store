@using Sense.Domain.Enums
@using Sense.Application.DTOs.AuthDTOs
@using System.ComponentModel.DataAnnotations
@model UserForRegisterDto

@{
}

<form asp-controller="ApplicationUser" asp-action="Add" method="POST" class="form">
    <div class="container-xxl">
        <div class="card card-flush mb-10">
            <div class="card-header">
                <h3 class="card-title">املأ بيانات العميل</h3>
            </div>
            <div class="card-body pt-0">

                <div class="row mb-5">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label required">الإسم الأول</label>
                        <input type="text" asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger fs-7"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label required">إسم العائلة</label>
                        <input type="text" asp-for="LastName" step="any" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger fs-7"></span>
                    </div>
                </div>


                 <div class="row mb-5">
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label required">رقم الهاتف</label>
                        <input type="text" asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger fs-7"></span>
                    </div>
                </div>

                 <div class="row mb-5">
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label required">كلمة المرور</label>
                        <input type="password" asp-for="Password" step="any" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger fs-7"></span>
                    </div>
                </div>

                <!-- Submit & Reset Buttons -->
                <div class="d-flex gap-3 mt-6">
                    <button type="submit" class="btn btn-primary">
                        <i class="ki-duotone ki-check fs-2"></i> إنشاء
                    </button>
                    <button type="reset" class="btn btn-light-warning">
                        <i class="ki-duotone ki-refresh fs-2"></i> إعادة الضبط
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

