@{
    var totalCustomers = ViewBag.TotalCustomers;
    var totalOrders = ViewBag.TotalOrders;
    var totalOrdersProfit = ViewBag.TotalOrdersProfit;
    var totalProviders = ViewBag.TotalProviders;
}
@section Styles
{
    <style type="text/css">
        body {
            overflow-x: hidden;
        }
    </style>
}

@*
    Legacy (maintenance-center era): bookings widgets (accepted/rejected/pending, totals).
    Hidden since the project became a pure e-commerce marketplace — see git history for the original markup.
*@

<!-- =================== Main Statistics Row =================== -->
<div class="row g-5 gx-xl-10 mt-1 mb-5 mb-xl-10">
    <!-- إيرادات الطلبات -->
    <div class="col-md-6 col-xl-3">
        <div class="card card-flush bgi-no-repeat bgi-size-cover bgi-position-x-end h-100"
             style="background-color: #061C42; background-image:url('/assets/media/patterns/vector-1.png')">
            <div class="card-header pt-5">
                <div class="card-title d-flex flex-column">
                    <div class="d-flex align-items-center mb-2">
                        <span class="fs-2hx fw-bold text-white lh-1">
                            @totalOrdersProfit.ToString("N2")
                            <svg class="riyal-svg currency" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 78.917 78.917" width="15" height="15" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-0.125em"><path d="M32.501,16.458H9.021L9,66.958c0,2.48-2.019,4.5-4.5,4.5s-4.5-2.02-4.5-4.5l0.025-55.005c0.003-2.479,2.021-4.495,4.5-4.495h27.977c13.51,0,24.5,10.991,24.5,24.5v23c0,2.48-2.02,4.5-4.5,4.5s-4.5-2.02-4.5-4.5v-23C48.001,23.412,41.048,16.458,32.501,16.458z M74.417,7.458c-2.481,0-4.5,2.019-4.5,4.5l-0.021,50.5h-23.48c-8.547,0-15.5-6.953-15.5-15.5v-23c0-2.481-2.019-4.5-4.5-4.5s-4.5,2.019-4.5,4.5v23c0,13.509,10.99,24.5,24.5,24.5h27.977c2.479,0,4.498-2.016,4.5-4.495l0.024-55.005C78.917,9.478,76.898,7.458,74.417,7.458z" /></svg>
                        </span>
                    </div>
                    <span class="text-white opacity-75 fw-semibold fs-6">إجمالي إيرادات المتجر</span>
                </div>
            </div>
            <div class="card-body d-flex flex-column justify-content-end">
                <div class="progress h-8px w-100 bg-white bg-opacity-50 rounded">
                    <div class="progress-bar bg-white" role="progressbar" style="width: 72%;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- الطلبات -->
    <div class="col-md-6 col-xl-3">
        <div class="card card-flush h-100 shadow-sm hover-elevate-up">
            <div class="card-header pt-5">
                <div class="card-title d-flex flex-column">
                    <div class="d-flex align-items-center mb-2">
                        <i class="ki-outline ki-basket fs-2hx text-success me-3"></i>
                        <span class="fs-2hx fw-bold text-gray-900 lh-1">@totalOrders</span>
                    </div>
                    <span class="text-gray-500 fw-semibold fs-6">إجمالي الطلبات الواردة للمتجر</span>
                </div>
            </div>
        </div>
    </div>

    <!-- العملاء -->
    <div class="col-md-6 col-xl-3">
        <div class="card card-flush h-100 shadow-sm hover-elevate-up">
            <div class="card-header pt-5">
                <div class="card-title d-flex flex-column">
                    <div class="d-flex align-items-center mb-2">
                        <i class="ki-outline ki-people fs-2hx text-primary me-3"></i>
                        <span class="fs-2hx fw-bold text-gray-900 lh-1">@totalCustomers</span>
                    </div>
                    <span class="text-gray-500 fw-semibold fs-6">إجمالي العملاء</span>
                </div>
            </div>
        </div>
    </div>

    <!-- المزودون -->
    <div class="col-md-6 col-xl-3">
        <div class="card card-flush h-100 shadow-sm hover-elevate-up">
            <div class="card-header pt-5">
                <div class="card-title d-flex flex-column">
                    <div class="d-flex align-items-center mb-2">
                        <i class="ki-outline ki-user fs-2hx text-info me-3"></i>
                        <span class="fs-2hx fw-bold text-gray-900 lh-1">@totalProviders</span>
                    </div>
                    <span class="text-gray-500 fw-semibold fs-6">إجمالي المزودين</span>
                </div>
            </div>
        </div>
    </div>
</div>
