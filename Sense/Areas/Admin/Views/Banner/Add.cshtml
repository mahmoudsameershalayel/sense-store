@using Sense.Application.DTOs.BannerDTOs
@model BannerForCreateUpdateDto


<form asp-controller="Banner" asp-action="Add" method="POST" class="form">
    <div class="container-xxl">
        <div class="card card-flush mb-10">
            <div class="card-header">
                <h3 class="card-title">املأ بيانات البانر</h3>
            </div>
            <div class="card-body pt-0">
                <!-- Product Name and Price -->
                <div class="row mb-5">
                    <div class="col-md-6">
                        <label asp-for="TitleAr" class="form-label required">العنوان</label>
                        <input type="text" asp-for="TitleAr" class="form-control" />
                        <span asp-validation-for="TitleAr" class="text-danger fs-7"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SubTitleAr" class="form-label required">العنوان الفرعي</label>
                        <input type="text" asp-for="SubTitleAr" class="form-control" />
                        <span asp-validation-for="SubTitleAr" class="text-danger fs-7"></span>
                    </div>
                </div>

                <!-- Quantity and Category -->
                <div class="row mb-5">
                    <div class="col-md-6">
                        <label asp-for="SortId" class="form-label required">ترتيب البانر</label>
                        <input type="number" asp-for="SortId" class="form-control" />
                        <span asp-validation-for="SortId" class="text-danger fs-7"></span>
                    </div>
                   
                </div>

                <!-- Description -->
                <div class="mb-5">
                    <label asp-for="SummaryAr" class="form-label">الوصف(إختياري)</label>
                    <textarea asp-for="SummaryAr" rows="4" class="form-control" placeholder="(إختياري)"></textarea>
                </div>

                <!-- Checkbox: Is Spare Part -->
                <div class="form-check form-check-custom form-check-solid mb-5">
                    <input class="form-check-input" type="checkbox" asp-for="ShowText" id="showText" />
                    <label class="form-check-label" for="showText">
                        هل تريد إظهار النص؟
                    </label>
                </div>
                <span asp-validation-for="ShowText" class="text-danger fs-7"></span>

                <!-- Submit & Reset Buttons -->
                <div class="d-flex gap-3 mt-6">
                    <button type="submit" class="btn btn-primary">
                        <i class="ki-duotone ki-check fs-2"></i> إنشاء
                    </button>
                    <button type="reset" class="btn btn-light-warning">
                        <i class="ki-duotone ki-refresh fs-2"></i> إعادة الضبط
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

