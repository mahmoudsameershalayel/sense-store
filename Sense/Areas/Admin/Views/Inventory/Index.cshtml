@using Sense.Domain.Enums
@using Sense.Application.DTOs.InventoryDTOs
@using Sense.Application.DTOs.ProductDTOs
@model List<InventoryActionDto>
@{
    var message = TempData["Message"];
}
@functions {
    public string GetInventoryActionDisplayName(InventoryAction? action)
    {
        return action switch
        {
            InventoryAction.Sold => "تم البيع",
            InventoryAction.Restocked => "إضافة للمخزون",
            InventoryAction.Returned => "تم الإرجاع",
            _ => action.ToString()
        };
    }
}
<div class="container-xxxl flex-grow-1 container-p-y">
    <!-- Basic Bootstrap Table -->
    <div class="card mb-xl-8">
        <div class="card-header border-0 pt-5">
            <h3 class="card-title align-items-start flex-column">
                <span class="card-label fw-bold fs-3 mb-1">سجلات المخزون</span>
                <span class="text-muted mt-1 fw-semibold fs-7">يحتوي هذا الجدول على جميع حركات المخزون.</span>
            </h3>
            <div class="card-toolbar" title="اضغط لإضافة منتج">
                <button class="btn btn-primary text-white" data-bs-toggle="modal" data-bs-target="#inventoryModal">
                    <i class="ki-duotone ki-plus fs-2"></i>حركة مخزون جديدة
                </button>
            </div>
        </div>

        <div class="table-responsive text-nowrap">
            <table class="table align-middle table-striped">
                <thead class="table-light">
                    <tr>
                        <th class="text-center">الرقم المرجعي</th>
                        <th class="text-center">المنتج</th>
                        <th class="text-center">الكمية</th>
                        <th class="text-center">نوع الحركة</th>
                        <th class="text-center">التاريخ</th>
                        <th class="text-center">الوقت</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.Id</td>
                            <td class="text-center">@item.Item?.Name</td>
                            <td class="text-center">@item.StockVal</td>
                            <td class="text-center">@GetInventoryActionDisplayName(item.Action)</td>
                            <td class="text-center">@item.CreatedAtDate</td>
                            <td class="text-center">@item.CreatedAtTime</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!--/ Basic Bootstrap Table -->
</div>

<!-- Inventory Action Modal -->
<div class="modal fade" id="inventoryModal" tabindex="-1" aria-labelledby="inventoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="inventoryModalLabel">إجراء حركة مخزون</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <form id="inventoryActionForm">
                    <!-- Product Selection -->
                    <div class="mb-3">
                        <label for="productSelect" class="form-label">اختر المنتج</label>
                        <select class="form-select" id="productSelect" required>
                            <option value="">-- اختر المنتج --</option>
                            @* You can dynamically fill this *@
                            @foreach (var item in ViewBag.Products as List<ProductDto>)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Action Type -->
                    <div class="mb-3">
                        <label for="actionType" class="form-label">نوع الحركة</label>
                        <select class="form-select" id="actionType" required>
                            <option value="">-- اختر نوع الحركة --</option>
                            @foreach (var action in Enum.GetValues(typeof(InventoryAction)).Cast<InventoryAction>())
                            {
                                <option value="@((int)action)">
                                    @GetInventoryActionDisplayName(action)
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Stock Value -->
                    <div class="mb-3">
                        <label for="stockVal" class="form-label">الكمية</label>
                        <input type="number" class="form-control" id="stockVal" placeholder="أدخل الكمية" min="1" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary" id="saveInventoryAction">حفظ</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.29/dist/sweetalert2.all.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js"></script>
    <script>
        $(document).ready(function () {
              $("#saveInventoryAction").on("click", function () {
            const productId = $("#productSelect").val();
            const actionType = $("#actionType").val();
            const stockVal = $("#stockVal").val();

            if (!productId || !actionType || !stockVal) {
                Swal.fire('خطأ', 'يرجى تعبئة جميع الحقول', 'error');
                return;
            }

            const payload = {
                ItemId: parseInt(productId),
                 Action: parseInt(actionType),
                StockVal: parseInt(stockVal)
            };

            $.ajax({
                url: '@Url.Action("CreateAction", "Inventory", new { area = "Admin" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (response) {
                    Swal.fire('تم', response.message, 'success');
                    $("#inventoryModal").modal('hide');
                    setTimeout(() => location.reload(), 1000);
                },
                error: function (xhr) {
                    Swal.fire('خطأ', xhr.responseText || 'حدث خطأ أثناء الحفظ', 'error');
                }
            });
        });
            $(".btn-delete").on("click", function (e) {
                $this = $(this);
                var id = $(this).attr("data-id");
                Swal.fire({
                    title: 'Are you sure?',
                    text: "All orders that have this city will removed!!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "@Url.Action("Delete", "City", new { area = "Admin" })/" + id,
                            type: 'DELETE',
                            success: function (result) {
                                Swal.fire(
                                    'Deleted!',
                                    'Your file has been deleted.',
                                    'success'
                                )
                                console.log($this.closest("tr").remove());
                            }
                        });
                    }
                })
                e.preventDefault();
            });
            $(".btn-pge").on("click", function (e) {
                $this = $(this);
                var pg = $(this).attr("data-pg");
                if (result.isConfirmed) {
                    $.ajax({
                        url: "@Url.Action("Index", "City", new { area = "Admin" })/" + pg,
                        type: 'POST'

                    });
                }
            })
            e.preventDefault();
        });

        document.addEventListener("DOMContentLoaded", function () {
            var message = '@message';
            if (message) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: message,
                    showConfirmButton: false,
                    timer: 1500
                });
            }
        });
    </script>
}