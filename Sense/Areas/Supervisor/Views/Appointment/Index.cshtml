@using Sense.Domain.Enums
@using Sense.Application.DTOs.AppointmentDTOs
@using System.ComponentModel.DataAnnotations
@using Sense.Application.DTOs.ServiceDTOs
@using Sense.Infrastructure.Extensions
@model List<AppointmentDto>
@{
    var message = TempData["Message"];
    var errorMessage = TempData["ErrorMessage"];

    var branches = ViewBag.Branches;
    var services = ViewBag.Services as List<ServiceDto>;

    var totalPages = ViewBag.TotalPages;
    var currentPage = ViewBag.CurrentPage;
    var serviceType = Context.Request.Query["ServiceType"];
    var appointmentStatus = Context.Request.Query["Status"];
    var brandId = Context.Request.Query["BrandId"];
}
<!--begin::Tables Widget 10-->
<div class="card mb-xl-8">
    <!--begin::Header-->
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">جدول الحجوزات</span>
            <span class="text-muted mt-1 fw-semibold fs-7">يحتوي هذا الجدول على جميع بيانات الحجوزات والعمليات عليها.</span>
        </h3>

    </div>
    <!--end::Header-->
    <!--begin::Body-->
    <div class="card-body pt-3">
        <!-- Add AJAX functionality to the form -->
        <form id="filterForm" method="get" asp-action="Index" class="mb-4">
            <div class="row gx-5 gy-2">
                <!-- Service Type Filter -->
                <div class="col-md-3 mb-2">
                    <label for="ServiceType" class="form-label">نوع الخدمة</label>
                    <select class="form-select" name="ServiceType" id="ServiceType">
                        <option value="">-- الكل --</option>
                        @if(services != null)
                        {
                            @foreach (var service in services)
                            {
                                <option value="@service.Id">@service.TitleAr</option>
                            }
                        }
                    </select>
                </div>

                <!-- Status Filter -->
                <div class="col-md-3 mb-2">
                    <label for="Status" class="form-label">حالة الحجز</label>
                    <select class="form-select" name="Status" id="Status">
                        <option value="">-- الكل --</option>
                        @foreach (var status in Enum.GetValues(typeof(AppointmentStatus)))
                        {
                            var display = status.GetType()
                            .GetField(status.ToString())
                            ?.GetCustomAttributes(typeof(DisplayAttribute), false)
                            .FirstOrDefault() as DisplayAttribute;
                            var name = display?.Name ?? status.ToString();
                            var val = (int)status;
                            <option value="@val">@name</option>
                        }
                    </select>
                </div>

               

                <!-- Filter Button (Optional, but to trigger AJAX) -->
                <div class="col-md-3 mb-2 d-flex align-items-end">
                    <button type="button" id="filterButton" class="btn btn-primary w-100">فلتر</button>
                </div>
            </div>
        </form>


        <div class="table-responsive">
            <table id="appointmentsTable"
                   class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-1 text-center">
                <thead>
                    <tr class="fw-bold text-muted bg-light">
                        <th>رقم الحجز</th>
                        <th>موديل السيارة</th>
                        <th>ماركة السيارة</th>
                        <th>نوع الخدمة</th>
                        <th>تاريخ التقديم</th>
                        <th>تاريخ الحجز</th>
                        <th>وقت الحجز</th>
                        <th>إسم الفرع</th>
                        <th>حالة الحجز</th>
                        <th class="text-end">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- DataTables will fill this -->
                </tbody>
            </table>
        </div>
    </div>
    <!--end::Body-->

</div>


<!-- Modal for reject Appointment -->
<div class="modal fade" id="rejectAppointmentModal" tabindex="-1" aria-labelledby="appointmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="appointmentModalLabel">رفض إستلام السيارة</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Appointment Form -->
                <form id="appointmentForm">
                    <input type="hidden" id="appointmentId" name="AppointmentId" value="">
                    <div class="row">
                        <div class="col-12">
                            <div class="card shadow-sm mb-4">
                                <div class="card-body">
                                    <div class="row">
                                        <label for="rejectReason" class="form-label">سبب الرفض</label>
                                        <textarea class="form-control" id="rejectReason" rows="4" name="rejectReason"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                    <!-- Submit Buttons -->
                    <div class="row mt-4">
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                            <button type="submit" class="btn btn-lg w-100" style="background-color: red; color: white;">رفض</button>
                        </div>
                        <div class="col-lg-4 col-md-4 col-sm-6 mb-3">
                            <input type="reset" class="btn btn-warning btn-lg w-100" value="إعادة الضبط">
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>






@section Scripts {
    <script>
        $(document).ready(function () {

            var table =  $('#appointmentsTable').DataTable({
            processing: true,
            serverSide: true,
            searching: true,
            ajax: {
                url: '@Url.Action("LoadAppointments", "Appointment", new { area = "Supervisor" })',
                type: 'POST',
                data: function (d) {
                    d.ServiceType = $('#ServiceType').val();
                    d.Status = $('#Status').val();
                }
            },
            columns: [
                { data: "id" },
                { data: "modelYear" },
                { data: "brand" },
                { data: "service" },
                { data: "createdAtDate" },
                { data: "scheduledDate" },
                { data: "scheduledTime" },
                { data: "branch" },
                {
                    data: "status",
                    orderable: false,
                    render: function (data) {
                        return data;
                    }
                },
                {
                    data: "id",
                    orderable: false,
                    render: function (data) {
                        return `
                            <a href="/SenseAPI/Supervisor/Appointment/Details/${data}"
                               class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1">
                                 <i class="ki-duotone ki-eye fs-2">
                                     <span class="path1"></span>
                                     <span class="path2"></span>
                                 </i>
                            </a>
                            <button class="btn btn-accept btn-icon btn-bg-light btn-active-color-primary btn-sm me-1"
                                    data-id="${data}">
                                <i class="ki-duotone ki-car fs-2">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                </i>
                            </button>
                            <button class="btn reject-btn btn-icon btn-bg-light btn-active-color-primary btn-sm"
                                    data-id="${data}"
                                    data-bs-toggle="modal"
                                    data-bs-target="#rejectAppointmentModal">
                                <i class="ki-duotone ki-cross-circle fs-2">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                </i>
                            </button>
                        `;
                    }
                }
            ],
            language: {
                url: '/js/datatables/i18n/ar.json'
            }
        });

                // إعادة تحميل الجدول عند الضغط على زر فلترة
        $('#filterButton').on('click', function () {
            table.ajax.reload();
        });


            // Event listener for "View Details" button click
            $('[id^="viewDetailsBtn-"]').on('click', function (e) {
                var appointmentId = $(this).data('id');

                // Perform an AJAX request to get the appointment details
                $.ajax({
                    url: "@Url.Action("GetAppointmentDetails", "Appointment", new { area = "Supervisor" })",
                    type: 'GET',
                    data: { id: appointmentId },
                    success: function (response) {
                        // Populate the modal content with the response data (appointment details)
                        $('#appointmentDetailsContent').html(response);
                    },
                    error: function () {
                        alert('Error fetching appointment details.');
                    }
                });
            });


        $(document).on("click", ".btn-accept", function (e) {
                e.preventDefault();
                const $this = $(this);
                const id = $this.attr("data-id");

                Swal.fire({
                    title: 'هل أنت متأكد؟',
                    text: "سيتم إستلام السيارة!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'نعم، قم بالإستلام!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: `/SenseAPI/Supervisor/Appointment/ReceiveAppointment/${id}`,
                            type: 'PUT',
                            success: function () {
                                Swal.fire(
                                    'تم الإستلام!',
                                    'تم إستلام السيارة بنجاح.',
                                    'success'
                                );
                                 table.ajax.reload();
                            },
                            error: function (xhr) {
                               let message = 'حدث خطأ أثناء إستلام السيارة.';
                                try {
                                    // If API returns JSON with a message
                                    const json = JSON.parse(xhr.responseText);
                                    if (json.result && json.result.message) {
                                        message = json.result.message;
                                    } else if (json.message) {
                                        message = json.message;
                                    }
                                } catch (e) {
                                    // responseText was not JSON
                                }
                                  Swal.fire(
                                    'خطأ!',
                                    message,
                                    'error'
                                 );
                            }
                        });
                    }
                });
            });



            $(document).on('click', '.reject-btn', function () {
                const appointmentId = $(this).data('id');
                $('#appointmentId').val(appointmentId);
            });

            $('#appointmentForm').on('submit', function (e) {
                e.preventDefault();

                const id = $('#appointmentId').val();
                let formData = new FormData();
                formData.append("AppointmentId", $('#appointmentId').val()); // Add hidden input in form
                formData.append("RejectReason", $('#rejectReason').val());

                $.ajax({
                    url: "@Url.Action("RejectAppointment", "Appointment", new { area = "Supervisor" })",
                    type: 'PUT',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        Swal.fire({
                            icon: 'success',
                            title: 'تم الرفض!',
                            text: 'تم رفض إستلام السيارة بنجاح.',
                            confirmButtonText: 'موافق',
                            timer: 3000
                        });
                        $('#rejectAppointmentModal').modal('hide');
                            $('#appointmentForm')[0].reset();  // إعادة تعيين الفورم هنا
                            table.ajax.reload();
                    },
                    error: function (xhr) {
                        Swal.fire({
                            icon: 'error',
                            title: 'حدث خطأ!',
                            text: 'حدث خطأ أثناء إرسال البيانات. الرجاء المحاولة لاحقاً.',
                            confirmButtonText: 'حسناً',
                            timer: 3000
                        });
                        console.error(xhr.responseText);
                    }
                });
            });
        });


    </script>
}



