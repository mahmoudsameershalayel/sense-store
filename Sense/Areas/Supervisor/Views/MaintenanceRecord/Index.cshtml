@section Scripts {
    <script>
        $(document).ready(function () {
              var table = $('#maintenanceTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '@Url.Action("LoadMaintenanceRecords", "MaintenanceRecord", new { area = "Supervisor" })',
                type: 'POST',
                 data: function (d) {
                      d.StartDate = $('#scheduledDateStart').val();
                      d.EndDate = $('#scheduledDateEnd').val();
                  }
            },
            columns: [
                { data: 'id' },
                { data: 'customerName' },
                { data: 'supervisorName' },
                { data: 'startDate' },
                { data: 'startTime' },
                { data: 'endDate' },
                { data: 'endTime' },
                { data: "status" },
                {
                    data: 'id',
                    render: function (data, type, row) {
                        return `
                            <a href="/Supervisor/MaintenanceRecord/Details/${data}" class="btn btn-sm btn-primary me-1">
                              <i class="ki-duotone ki-information fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                               </i>
                            </a>
                            <button class="btn btn-sm btn-warning add-btn me-1" data-id="${data}" data-bs-toggle="modal" data-bs-target="#addInvoiceModal">
                                    <i class="ki-duotone ki-document fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                            </button>
                            <button class="btn btn-sm btn-success btn-complete" data-id="${data}"> 
                            <i class="ki-duotone ki-check-square fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                            </button>
                        `;
                    },
                    orderable: false,
                    searchable: false
                }
            ],
            language: {
               url: "/js/datatables/i18n/ar.json"
            }
        });

        $('#filterButton').on('click', function () {
    table.ajax.reload();
});

            $(document).on('click', '.btn-complete', function () {
              var maintenanceRecordId = $(this).data('id');
              openInvoicesModal(maintenanceRecordId);
            });
          function openInvoicesModal(maintenanceRecordId) {
              $.ajax({
                url: '/Supervisor/Invoice/GetInvoicesByMaintenanceRecord',
                type: 'GET',
                data: { maintenanceRecordId: maintenanceRecordId },
                success: function (invoices) {
                  if (invoices.length === 0) {
                    $('#invoicesContainer').html('<p>·«  ÊÃœ ›Ê« Ì— „— »ÿ….</p>');
                    $('#invoicesModal').modal('show');
                    return;
                  }

                  let html = '<form id="laborCostForm">';
                  html += '<input type="hidden" name="maintenanceRecordId" value="' + maintenanceRecordId + '" />';
                  html += '<table class="table table-bordered">';
                  html += '<thead><tr><th>—ﬁ„ «·›« Ê—…</th><th>«·„»·€</th><th>«·‰Ê⁄</th></tr></thead><tbody>';

                  invoices.forEach(function (invoice) {
                     html += `<tr>
                           <td>${invoice.invoiceNo}#</td>
                           <td>${invoice.invoiceAmount.toFixed(2)}</td>
                           <td>${invoice.invoiceType}</td>
                         </tr>`;
                  });

                  html += '</tbody></table>';
                  html += '<div class="text-end mt-3">';
                  html += '<button type="submit" class="btn btn-primary">«‰ Â  «·’Ì«‰…</button>';
                  html += '</div>';
                  html += '</form>';

                  $('#invoicesContainer').html(html);
                  $('#invoicesModal').modal('show');
                },
                error: function () {
                  alert('ÕœÀ Œÿ√ √À‰«¡  Õ„Ì· «·›Ê« Ì—.');
                }
              });
}

// Update total dynamically when labor cost changes
$('#invoicesContainer').on('input', '.labor-cost', function () {
  var row = $(this).closest('tr');
  var invoiceAmount = parseFloat(row.find('td:nth-child(2)').text());
  var laborCost = parseFloat($(this).val()) || 0;
  var total = invoiceAmount + laborCost;
  row.find('td:nth-child(4)').text(total.toFixed(2));
});

// Submit labor costs form
$('#invoicesContainer').on('submit', '#laborCostForm', function (e) {
  e.preventDefault();

  var formData = $(this).serialize(); // serialized form data with maintenanceRecordId and laborCosts dictionary

  $.ajax({
    url: '/Supervisor/Invoice/SaveLaborCosts',
    type: 'POST',
    data: formData,
    success: function (response) {
      if (response.success) {
      Swal.fire({
    icon: 'success',
    title: ' „ «·Õ›Ÿ »‰Ã«Õ',
    timer: 1500,
    showConfirmButton: false
}).then(() => {
     table.ajax.reload();
            $('#invoicesModal').modal('hide');
});
      } else {
        Swal.fire({
          icon: 'error',
          title: 'ÕœÀ Œÿ√ √À‰«¡ «·Õ›Ÿ',
          confirmButtonText: 'Õ”‰«'
        });
      }
    },
    error: function () {
      Swal.fire({
        icon: 'error',
        title: 'ÕœÀ Œÿ√ ›Ì «·Œ«œ„',
        confirmButtonText: 'Õ”‰«'
      });
    }
  });
});

          


            $(document).on('click', '.add-btn', function () {
                const maintenanceRecordId = $(this).data('id');

                $('#maintenanceRecordId').val(maintenanceRecordId);
            });

            $('#invoiceForm').on('submit', function (e) {
            e.preventDefault();

            const formData = {
                maintenanceRecordId: parseInt($('#maintenanceRecordId').val()),
                invoiceNo: parseInt($('#invoiceNo').val()),
                invoiceAmount: parseFloat($('#invoiceAmount').val()),
                invoiceType: parseInt($('#invoiceType').val())
            };

            console.log(JSON.stringify(formData));

            $.ajax({
                url: "@Url.Action("Add", "Invoice", new { area = "Supervisor" })",
                type: 'POST',
                data: JSON.stringify(formData),
                contentType: 'application/json',
                success: function (response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: ' „ «·≈÷«›… ≈·Ï «·›« Ê—… »‰Ã«Õ!',
                            text: ' „ ⁄„·Ì… «·≈÷«›… »‰Ã«Õ.',
                            confirmButtonText: '„Ê«›ﬁ',
                            timer: 3000
                        });
                        table.ajax.reload();
                        $('#invoiceForm')[0].reset();
                        $('#addInvoiceModal').modal('hide');
                    } else {
                        Swal.fire({
                            icon: 'warning',
                            title: '·„   „ ⁄„·Ì… «·≈÷«›…',
                            text: response.message || '«·—Ã«¡ «· √ﬂœ „‰ «·»Ì«‰«  Ê ≈⁄«œ… «·„Õ«Ê·….',
                            confirmButtonText: 'Õ”‰«',
                            timer: 3000
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'ÕœÀ Œÿ√!',
                        text: 'ÕœÀ Œÿ√ √À‰«¡ «·≈÷«›…. «·—Ã«¡ «·„Õ«Ê·… ·«Õﬁ«.',
                        confirmButtonText: 'Õ”‰«',
                        timer: 3000
                    });
                }
            });
        });
        });
    </script>
}



