@{
    var supervisorBookings = ViewBag.SupervisorBookings;
    var scheduledBookings = ViewBag.ScheduledBookings;
    var maintenanceRecords = ViewBag.MaintenanceRecords;
    var invoices = ViewBag.Invoices;
}
@section Styles
{
    <style type="text/css">
        body {
            overflow-x: hidden;
        }
    </style>
}
<!--begin::Row-->
<div class="row g-5 gx-xl-10 mb-5 mb-xl-10">
    <!--begin::Col-->
    <div class="col-md-6 col-lg-6 col-xl-6 col-xxl-3 mb-md-5 mb-xl-10">
        <div class="card card-flush bgi-no-repeat bgi-size-cover bgi-position-x-end h-md-50 mb-5 mb-xl-10"
             style="background-color: #F1416C; background-image:url('/assets/media/patterns/vector-1.png')">
            <div class="card-header pt-5">
                <div class="card-title d-flex flex-column">
                    <div class="d-flex align-items-center mb-2">
                        <i class="ki-outline ki-calendar fs-2hx text-white me-3"></i>
                        <span class="fs-2hx fw-bold text-white">@supervisorBookings</span>
                    </div>
                    <span class="text-white opacity-75 fw-semibold fs-6">إجمالي الحجوزات الموكلة</span>
                </div>
                <div class="card-toolbar">
                    <span class="badge badge-light fw-bold py-2 px-3">@scheduledBookings حجوزات مجدولة</span>
                </div>
            </div>
            <div class="card-body d-flex flex-column justify-content-end">
                <div class="progress h-8px w-100 bg-white bg-opacity-50 rounded">
                    <div class="progress-bar bg-white" role="progressbar" style="width: 72%;"></div>
                </div>
            </div>
        </div>
        <div class="card card-flush h-md-50 mb-5 mb-xl-10 shadow-sm hover-elevate-up">
            <div class="card-header pt-5">
                <div class="card-title d-flex flex-column">
                    <div class="d-flex align-items-center mb-2">
                        <i class="ki-outline ki-document fs-2hx text-primary me-3"></i>
                        <span class="fs-2hx fw-bold text-gray-900">@invoices</span>
                    </div>
                    <span class="text-gray-500 fw-semibold fs-6">إجمالي الفواتير</span>
                </div>
            </div>
        </div>
    </div>
    <!--end::Col-->
    <!--begin::Col-->
    <div class="col-md-6 col-lg-6 col-xl-6 col-xxl-3 mb-md-5 mb-xl-10">
        <div class="card card-flush h-md-50 mb-5 mb-xl-10 shadow-sm hover-elevate-up">
            <div class="card-header pt-5">
                <div class="card-title d-flex flex-column">
                    <div class="d-flex align-items-center mb-2">
                        <i class="ki-outline ki-wrench fs-2hx text-primary me-3"></i>
                        <span class="fs-2hx fw-bold text-gray-900">@maintenanceRecords</span>
                    </div>
                    <span class="text-gray-500 fw-semibold fs-6">إجمالي سجلات الصيانة</span>
                </div>
            </div>
        </div>
        
       
    </div>
    <!--end::Col-->
</div>
