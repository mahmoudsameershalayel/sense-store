@using Sense.Domain.Enums
@using Sense.Domain.DBEntities
@model List<ServiceListingTbl>
@{
    var message = TempData["Message"];
    var errorMessage = TempData["ErrorMessage"];
}

<div class="card mb-xl-8">
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1">خدماتي</span>
            <span class="text-muted mt-1 fw-semibold fs-7">إدارة الخدمات المنشورة في المتجر.</span>
        </h3>
        <div class="card-toolbar" title="اضغط لإضافة خدمة">
            <a asp-area="ServiceProvider" asp-controller="ServiceListing" asp-action="Add" class="btn btn-sm btn-light btn-active-primary">
                <i class="ki-duotone ki-plus fs-2"></i>خدمة جديدة
            </a>
        </div>
    </div>
    <div class="card-body pt-3">
        <div class="alert alert-info d-flex align-items-center gap-2">
            <i class="fas fa-info-circle"></i>
            <span>تُنشر الخدمة مباشرة بعد إضافة بياناتها ورفع صورتها، دون انتظار موافقة الإدارة.</span>
        </div>

        <div class="table-responsive">
            <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                <thead>
                    <tr class="fw-bold text-muted bg-light">
                        <th class="ps-4 min-w-200px rounded-start">الخدمة</th>
                        <th>السعر</th>
                        <th>تاريخ الإضافة</th>
                        <th>الحالة</th>
                        <th class="text-end rounded-end">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var canEdit = item.Status != ServiceListingStatus.Archived;
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="symbol symbol-50px m-5">
                                        <img src="@item.ImageURL" alt="" />
                                    </div>
                                    <div class="d-flex justify-content-start flex-column">
                                        <span class="text-gray-900 fw-bold fs-6">@item.Name</span>
                                    </div>
                                </div>
                            </td>
                            <td>@item.Price</td>
                            <td>@item.CreatedAt?.ToString("yyyy-MM-dd")</td>
                            <td>
                                @switch (item.Status)
                                {
                                    case ServiceListingStatus.Draft:
                                        <span class="badge badge-light-secondary">مسودة</span>
                                        break;
                                    case ServiceListingStatus.PendingReview:
                                        <span class="badge badge-light-warning">بانتظار إكمال النشر</span>
                                        break;
                                    case ServiceListingStatus.Approved:
                                        <span class="badge badge-light-info">جاهزة للنشر</span>
                                        break;
                                    case ServiceListingStatus.Rejected:
                                        <span class="badge badge-light-danger">مرفوضة</span>
                                        break;
                                    case ServiceListingStatus.Published:
                                        <span class="badge badge-light-success">منشورة</span>
                                        break;
                                    case ServiceListingStatus.Unpublished:
                                        <span class="badge badge-light-dark">غير منشورة</span>
                                        break;
                                    case ServiceListingStatus.Archived:
                                        <span class="badge badge-dark">مؤرشفة</span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                @if (canEdit)
                                {
                                    <a asp-area="ServiceProvider" asp-controller="ServiceListing" asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-icon btn-sm btn-light-warning me-1" title="تعديل الخدمة">
                                        <i class="ki-duotone ki-pencil fs-2">
                                            <span class="path1"></span>
                                            <span class="path2"></span>
                                        </i>
                                    </a>
                                    <a asp-area="ServiceProvider" asp-controller="ServiceListing" asp-action="UploadImage" asp-route-id="@item.Id"
                                       class="btn btn-icon btn-sm btn-light-info" title="ارفع صورة للخدمة">
                                        <i class="ki-duotone ki-switch fs-2">
                                            <span class="path1"></span>
                                            <span class="path2"></span>
                                        </i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-bottom-left",
                "timeOut": "2500"
            };

            @if (message != null)
            {
                <text>toastr.success('@message');</text>
            }
            @if (errorMessage != null)
            {
                <text>toastr.error('@errorMessage');</text>
            }

        });
    </script>
}
