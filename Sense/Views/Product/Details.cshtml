@using Sense.Application.DTOs.ProductDTOs
@model ProductDto
@{
    ViewData["Title"] = Model.Name;
    var otherProducts = ViewBag.OtherProducts as List<ProductDto>;
    var isOutOfStock = Model.QuantityAvaliable <= 0;
}
@section Styles
{
    <style type="text/css">
        .sf-product-media {
            position: relative;
            background-color: #fff;
            padding: 24px;
        }

            .sf-product-media img {
                width: 100%;
                max-height: 460px;
                object-fit: contain;
                display: block;
            }

        .sf-product-title {
            color: var(--sf-ink);
            font-size: 1.6rem;
            font-weight: 800;
            line-height: 1.5;
            margin: 0 0 10px;
        }

        .sf-product-price {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--sf-ink);
            font-size: 1.7rem;
            font-weight: 800;
        }

        .sf-price-note {
            color: var(--sf-muted);
            font-size: 0.82rem;
        }

        .sf-stock-line {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-size: 0.9rem;
            font-weight: 700;
        }

            .sf-stock-line::before {
                content: "";
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background-color: currentColor;
            }

        .sf-stock-line--in {
            color: var(--sf-success);
        }

        .sf-stock-line--out {
            color: var(--sf-muted);
        }

        .sf-desc {
            color: var(--sf-muted);
            line-height: 2;
            font-size: 0.95rem;
        }

        .sf-mini-card {
            display: flex;
            flex-direction: column;
            height: 100%;
            background: #fff;
            border: 1px solid var(--sf-border);
            border-radius: var(--sf-radius);
            overflow: hidden;
            text-decoration: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

            .sf-mini-card:hover {
                border-color: #c4ccdb;
                box-shadow: var(--sf-shadow-md);
            }

            .sf-mini-card img {
                width: 100%;
                aspect-ratio: 4 / 3;
                object-fit: contain;
                padding: 12px;
                border-bottom: 1px solid var(--sf-border);
                background: #fff;
            }

        .sf-mini-card__body {
            padding: 12px 14px 14px;
        }

        .sf-mini-card__name {
            color: var(--sf-ink);
            font-size: 0.9rem;
            font-weight: 700;
            line-height: 1.55;
            margin: 0 0 8px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            min-height: 2.8em;
        }
    </style>
}

<!-- ترويسة الصفحة -->
<div class="sf-page-head" dir="rtl">
    <div class="container">
        <ul class="sf-breadcrumb">
            <li><a href="/">الرئيسية</a></li>
            <li><a href="/Product/Index">المتجر</a></li>
            @if (Model.Category?.Name != null)
            {
                <li>@Model.Category.Name</li>
            }
        </ul>
        <h1>@Model.Name</h1>
    </div>
</div>

<section class="sf-section sf-section--muted" dir="rtl">
    <div class="container">
        <div class="row align-items-stretch g-4">

            <!-- صورة المنتج -->
            <div class="col-lg-6">
                <div class="sf-panel sf-product-media h-100 d-flex align-items-center justify-content-center">
                    <img src="@Model.ImageURL" alt="@Model.Name" />
                </div>
            </div>

            <!-- تفاصيل المنتج -->
            <div class="col-lg-6">
                <div class="sf-panel p-4 p-lg-4 h-100 d-flex flex-column">

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @if (Model.Category?.Name != null)
                        {
                            <span class="sf-chip">@Model.Category.Name</span>
                        }
                        @if (Model.Brand?.Name != null)
                        {
                            <span class="sf-chip"><i class="bi bi-award"></i>@Model.Brand.Name</span>
                        }
                        @if (Model.Model?.Name != null)
                        {
                            <span class="sf-chip">@Model.Model.Name</span>
                        }
                        @if (Model.ProviderId != null && !string.IsNullOrWhiteSpace(Model.ProviderName))
                        {
                            <a href="/Providers/Details/@Model.ProviderId" class="sf-chip" style="text-decoration:none;">
                                <i class="bi bi-shop"></i> @Model.ProviderName
                            </a>
                        }
                    </div>

                    <h2 class="sf-product-title">@Model.Name</h2>

                    <div class="mb-2">
                        <span class="sf-stock-line @(isOutOfStock ? "sf-stock-line--out" : "sf-stock-line--in")">
                            @(isOutOfStock ? "غير متوفر حالياً" : "متوفر في المخزون — جاهز للطلب")
                        </span>
                    </div>

                    <div class="d-flex align-items-baseline gap-3 flex-wrap py-3 my-2 border-top border-bottom" style="border-color: var(--sf-border) !important;">
                        <span class="sf-product-price">
                            @Model.Price.ToString("N0", new System.Globalization.CultureInfo("ar-SA"))
                            <svg class="riyal-svg" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 78.917 78.917" width="20" height="20" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-0.125em;color:var(--sf-muted);"><path d="M32.501,16.458H9.021L9,66.958c0,2.48-2.019,4.5-4.5,4.5s-4.5-2.02-4.5-4.5l0.025-55.005c0.003-2.479,2.021-4.495,4.5-4.495h27.977c13.51,0,24.5,10.991,24.5,24.5v23c0,2.48-2.02,4.5-4.5,4.5s-4.5-2.02-4.5-4.5v-23C48.001,23.412,41.048,16.458,32.501,16.458z M74.417,7.458c-2.481,0-4.5,2.019-4.5,4.5l-0.021,50.5h-23.48c-8.547,0-15.5-6.953-15.5-15.5v-23c0-2.481-2.019-4.5-4.5-4.5s-4.5,2.019-4.5,4.5v23c0,13.509,10.99,24.5,24.5,24.5h27.977c2.479,0,4.498-2.016,4.5-4.495l0.024-55.005C78.917,9.478,76.898,7.458,74.417,7.458z" /></svg>
                        </span>
                        <span class="sf-price-note">السعر شامل الضريبة</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div class="sf-desc mb-4">
                            @Html.Raw(Model.Description?.Replace("\n", "<br>"))
                        </div>
                    }

                    <!-- زر الإضافة إلى السلة -->
                    <form method="post" action="/Cart/Add" class="mb-4">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <button type="submit"
                                data-product-id="@Model.Id"
                                class="sf-btn sf-btn--primary add-to-cart-btn w-100"
                                @(isOutOfStock ? "disabled" : "")
                                title="@(isOutOfStock ? "غير متوفر" : "أضف إلى السلة")">
                            <i class="bi bi-cart-plus"></i>
                            @(isOutOfStock ? "غير متوفر حالياً" : "أضف إلى السلة")
                        </button>
                    </form>

                    <div class="sf-assurance mt-auto">
                        <div class="sf-assurance__item">
                            <i class="bi bi-patch-check"></i>
                            <span>منتج أصلي</span>
                        </div>
                        <div class="sf-assurance__item">
                            <i class="bi bi-shield-lock"></i>
                            <span>دفع آمن</span>
                        </div>
                        <div class="sf-assurance__item">
                            <i class="bi bi-headset"></i>
                            <span>دعم متخصص</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- منتجات أخرى -->
        @if (otherProducts != null && otherProducts.Any())
        {
            <div class="mt-5">
                <div class="sf-section-head">
                    <div class="sf-section-head__titles">
                        <span class="sf-kicker">قد يعجبك أيضاً</span>
                        <h3 class="sf-title">منتجات مشابهة</h3>
                    </div>
                    <a href="/Product/Index" class="sf-section-head__action">
                        عرض جميع المنتجات
                        <i class="bi bi-arrow-left"></i>
                    </a>
                </div>

                <div class="row g-3">
                    @foreach (var product in otherProducts)
                    {
                        <div class="col-6 col-md-4 col-lg-3">
                            <a href="/Product/Details?id=@product.Id" class="sf-mini-card">
                                <img src="@product.ImageURL" alt="@product.Name" loading="lazy" />
                                <div class="sf-mini-card__body">
                                    <p class="sf-mini-card__name">@product.Name</p>
                                    <div class="sf-price" style="font-size:0.98rem;">
                                        @product.Price.ToString("N0", new System.Globalization.CultureInfo("ar-SA"))
                                        <svg class="riyal-svg" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 78.917 78.917" width="13" height="13" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-0.125em;color:var(--sf-muted);"><path d="M32.501,16.458H9.021L9,66.958c0,2.48-2.019,4.5-4.5,4.5s-4.5-2.02-4.5-4.5l0.025-55.005c0.003-2.479,2.021-4.495,4.5-4.495h27.977c13.51,0,24.5,10.991,24.5,24.5v23c0,2.48-2.02,4.5-4.5,4.5s-4.5-2.02-4.5-4.5v-23C48.001,23.412,41.048,16.458,32.501,16.458z M74.417,7.458c-2.481,0-4.5,2.019-4.5,4.5l-0.021,50.5h-23.48c-8.547,0-15.5-6.953-15.5-15.5v-23c0-2.481-2.019-4.5-4.5-4.5s-4.5,2.019-4.5,4.5v23c0,13.509,10.99,24.5,24.5,24.5h27.977c2.479,0,4.498-2.016,4.5-4.495l0.024-55.005C78.917,9.478,76.898,7.458,74.417,7.458z" /></svg>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@section Scripts
{
    <script type="text/javascript">
        // AJAX call for Add to Cart
        $('.add-to-cart-btn').on('click', function (e) {
            e.preventDefault();

            if ($(this).is(':disabled')) {
                return;
            }

            var productId = $(this).data('product-id');

            $.ajax({
                type: "POST",
                url: "@Url.Action("AddToCart", "Product")",
                data: { productId: productId },
                success: function (response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'تمت إضافة المنتج إلى السلة',
                            text: 'يمكنك متابعة التسوق أو إتمام الطلب من السلة.',
                            confirmButtonText: 'حسناً',
                            timer: 3000
                        });

                        updateCartItemCount();
                    } else {
                        Swal.fire({
                            icon: 'info',
                            title: 'المنتج موجود في السلة',
                            text: 'يمكنك تعديل الكمية من صفحة سلة التسوق.',
                            confirmButtonText: 'حسناً',
                            timer: 3000
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'حدث خطأ!',
                        text: 'حدث خطأ أثناء إضافة المنتج. الرجاء المحاولة لاحقاً.',
                        confirmButtonText: 'حسناً',
                        timer: 3000
                    });
                }
            });
        });
    </script>
}
