@using Sense.Application.DTOs.ServiceDTOs
@model List<ServiceDto>

@section Styles
{
    <style type="text/css">
        .contact-banner {
            position: relative;
            width: 100%;
            height: 150px;
            background: url('https://media.istockphoto.com/id/499178422/photo/new-auto-parts.jpg?s=612x612&w=0&k=20&c=JFj6CcYMubYwTFV7WeDwgRUq1ED6r2dLcKyle7BF93U=') no-repeat center center/cover;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-align: center;
        }

            .contact-banner::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.5);
                z-index: 1;
            }

        .contact-banner-text {
            position: relative;
            z-index: 2;
        }

            .contact-banner-text h1 {
                font-size: 3rem;
                color: white;
                margin: 0;
                padding: 0;
            }

            .contact-banner-text p {
                font-size: 1.25rem;
            }

        .hover-shadow:hover {
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
            transition: box-shadow 0.3s ease-in-out;
        }

        @@media (max-width: 991.98px) {
            .solution-content {
                padding: 2rem 1rem;
            }
        }

        .service-image-wrapper {
            width: 100%;
            height: 150px; /* Set a fixed height */
            overflow: hidden;
            border-radius: 10px;
        }

            .service-image-wrapper img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.3s ease, opacity 0.3s ease;
            }
    </style>
}

<div class="contact-banner">
    <div class="contact-banner-text">
        <h1>
            الخدمات
        </h1>

    </div>
</div>

<!-- Start Safety Area -->
<section style="background-color:#fff !important" class="safety-area pt-100 pb-70">
    <div class="container">
        <div class="row">
            @foreach (var item in Model)
            {
                <a href="/Service/Details?id=@item.Id" class="col-lg-4 col-sm-6">
                    <div class="single-safety overly-one">
                        <div class="overly-two">
                            <div class="service-image-wrapper mb-3">
                                <img src="@item.ImageURL" alt="@item.TitleAr" class="img-fluid" />
                            </div>
                            <div>
                                <h3 style="color:#253F8E;">@item.TitleAr</h3>
                            </div>
                            <p>@item.SummaryAr</p>
                        </div>
                    </div>
                </a>
            }

        </div>
    </div>


</section>
