@model Sense.Models.ServiceProviderRegistration.ServiceProviderRegistrationViewModel

@section Styles
{
    <link rel="stylesheet" href="~/assets/css/business-description-editor.css" asp-append-version="true" />
    <style>
        .service-provider-registration-hero {
            background: linear-gradient(135deg, #061c42 0%, #253f8e 100%);
            color: #fff;
            padding: 58px 0;
        }

        .service-provider-registration-card {
            border: 0;
            border-radius: 18px;
            box-shadow: 0 16px 45px rgba(6, 28, 66, 0.11);
        }

            .service-provider-registration-card .form-control {
                min-height: 48px;
                border-radius: 10px;
            }

            .service-provider-registration-card textarea.form-control {
                min-height: 145px;
                resize: vertical;
            }

            .service-provider-registration-card .form-label {
                color: #061c42;
                font-weight: 700;
            }

        .service-provider-registration-submit {
            min-height: 50px;
            background-color: #253f8e;
            border-color: #253f8e;
            border-radius: 999px;
        }

            .service-provider-registration-submit:hover,
            .service-provider-registration-submit:focus {
                background-color: #061c42;
                border-color: #061c42;
            }

        /*
                 * Checkbox and label layout
                 * Keeps the checkbox beside the label in RTL layout.
                 */
        .service-provider-registration-consent {
            display: flex !important;
            flex-direction: row;
            align-items: center;
            justify-content: flex-start;
            flex-wrap: nowrap;
            gap: 0.65rem;
            width: 100%;
            direction: rtl;
        }

            .service-provider-registration-consent .form-check-input {
                position: static;
                float: none;
                flex: 0 0 auto;
                width: 1.15rem;
                height: 1.15rem;
                margin: 0;
                cursor: pointer;
            }

            .service-provider-registration-consent .form-check-label {
                display: inline-block;
                flex: 1 1 auto;
                width: auto;
                margin: 0;
                color: #061c42;
                line-height: 1.8;
                cursor: pointer;
            }
    </style>
}

<section class="service-provider-registration-hero text-center">
    <div class="container">
        <p class="mb-2 opacity-75">
            انضم إلى شركاء Sense Store
        </p>

        <h1 class="text-white mb-3">
            سجّل كمزوّد خدمة
        </h1>

        <p class="mb-0">
            أنشئ حساب مزود الخدمة وفعّله فوراً باستخدام رمز التحقق المرسل إلى بريدك الإلكتروني.
        </p>
    </div>
</section>

<section class="py-5 bg-light">
    <div class="container" style="max-width: 900px;">
        <div class="card service-provider-registration-card">
            <div class="card-body p-4 p-lg-5">

                <div class="mb-4">
                    <h2 class="h4 mb-2" style="color: #061c42;">
                        بيانات حساب مزود الخدمة
                    </h2>

                    <p class="text-muted mb-0">
                        جميع الحقول مطلوبة. سنرسل رمز تحقق إلى بريدك الإلكتروني قبل تسجيل الدخول.
                    </p>
                </div>

                <form asp-controller="ServiceProviderRegistration"
                      asp-action="Index"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <label asp-for="FullName"
                                   class="form-label">
                            </label>

                            <input asp-for="FullName"
                                   class="form-control"
                                   autocomplete="name"
                                   placeholder="اسم الشخص المسؤول" />

                            <span asp-validation-for="FullName"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BusinessName"
                                   class="form-label">
                            </label>

                            <input asp-for="BusinessName"
                                   class="form-control"
                                   autocomplete="organization"
                                   placeholder="اسم النشاط الذي يقدم الخدمة" />

                            <span asp-validation-for="BusinessName"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email"
                                   class="form-label">
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   autocomplete="email"
                                   placeholder="name@example.com" />

                            <span asp-validation-for="Email"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber"
                                   class="form-label">
                            </label>

                            <input asp-for="PhoneNumber"
                                   class="form-control"
                                   autocomplete="tel"
                                   dir="ltr"
                                   placeholder="05xxxxxxxx" />

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password"
                                   class="form-label">
                            </label>

                            <input asp-for="Password"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="Password"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword"
                                   class="form-label">
                            </label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="col-12">
                            <label asp-for="BusinessDescription"
                                   class="form-label">
                            </label>

                            <div class="business-description-editor-field">
                                <textarea asp-for="BusinessDescription"
                                          class="form-control js-business-description-editor"
                                          data-editor-label="محرر وصف الخدمات"
                                          placeholder="عرّفنا بالخدمات التي ترغب في تقديمها"></textarea>
                            </div>

                            <span asp-validation-for="BusinessDescription"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="col-12">
                            <label asp-for="ProfileImage"
                                   class="form-label">
                            </label>

                            <input asp-for="ProfileImage"
                                   type="file"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                            <div class="form-text">
                                JPG أو PNG أو WEBP، بحد أقصى 5 ميجابايت.
                            </div>

                            <span asp-validation-for="ProfileImage"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="col-12">
                            <div class="service-provider-registration-consent">
                                <input asp-for="AcceptedTerms"
                                       class="form-check-input"
                                       required />

                                <label asp-for="AcceptedTerms"
                                       class="form-check-label">
                                    أقر بصحة البيانات وأوافق على
                                    <a asp-controller="ServiceProviderRegistration"
                                       asp-action="Terms"
                                       target="_blank"
                                       rel="noopener noreferrer">شروط الانضمام كمزوّد خدمة</a>.
                                </label>
                            </div>

                            <span asp-validation-for="AcceptedTerms"
                                  class="text-danger small d-block mt-1">
                            </span>
                        </div>

                        <div class="col-12">
                            <button type="submit"
                                    class="btn btn-primary service-provider-registration-submit w-100">
                                إنشاء حساب مزود الخدمة
                            </button>
                        </div>

                    </div>
                </form>

            </div>
        </div>
    </div>
</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <partial name="_BusinessDescriptionEditorScripts" />
}
