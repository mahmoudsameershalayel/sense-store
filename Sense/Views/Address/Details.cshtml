@using Sense.Application.DTOs.AddressDTOs
@model AddressDto

@{
    ViewData["Title"] = "تفاصيل العنوان";
}

@section Styles
{
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

    <style type="text/css">
        .contact-banner {
            position: relative;
            width: 100%;
            height: 150px;
            background: url('@Url.Content("~/assets/img/freemaintenance.jpg")') no-repeat center center/cover;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-align: center;
        }

            .contact-banner::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.5);
                z-index: 1;
            }

        .contact-banner-text {
            position: relative;
            z-index: 2;
        }

            .contact-banner-text h1 {
                font-size: 3rem;
                color: white;
                margin: 0;
                padding: 0;
            }

            .contact-banner-text p {
                font-size: 1.25rem;
            }
    </style>
}

<div class="contact-banner">
    <div class="contact-banner-text">
        <h1>
            تفاصيل العنوان
        </h1>
    </div>
</div>
<section id="store" class="section py-5" dir="rtl">
    <div class="container py-5">

        <div class="card shadow-lg border-0 mb-4">
            <div class="card-body">
                <div class="row gy-3">
                    <div class="col-md-6">
                        <strong>المدينة:</strong> <span class="text-muted">@Model.City</span>
                    </div>
                    <div class="col-md-6">
                        <strong>الشارع:</strong> <span class="text-muted">@Model.Street</span>
                    </div>
                    <div class="col-md-6">
                        <strong>الحي السكني:</strong> <span class="text-muted">@Model.Neighborhood</span>
                    </div>
                    <div class="col-12">
                        <strong>تفاصيل إضافية:</strong>
                        <div class="text-muted border rounded p-2">@Model.Address</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-light d-flex align-items-center">
                <i class="fas fa-map me-2 text-primary"></i>
                <h5 class="mb-0">موقع العنوان على الخريطة</h5>
            </div>
            <div class="card-body p-0">
                <div id="map" style="height: 400px; border-radius: 0 0 .5rem .5rem;"></div>
            </div>
        </div>
    </div>
</section>
@section Scripts
{
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

    <script type="text/javascript">
        const lat = @Model.LocationLat;
        const lng = @Model.LocationLong;

        const map = L.map('map').setView([lat, lng], 16);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        L.marker([lat, lng])
            .addTo(map)
            .bindPopup("العنوان المحدد")
            .openPopup();
    </script>
}


