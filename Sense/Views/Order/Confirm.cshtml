@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.29/dist/sweetalert2.all.min.js"></script>
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script type="text/javascript">
        let map;
        let marker;

        // Guest checkout: address is kept locally until the user signs in
        var isAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
        var PENDING_ADDRESS_KEY = 'sensePendingAddress';
        var SELECT_ADDRESS_KEY = 'senseSelectAddressId';

        function renderGuestAddress() {
            var card = $('#guestAddressCard');
            if (!card.length) return;

            var saved = localStorage.getItem(PENDING_ADDRESS_KEY);
            if (!saved) {
                card.hide();
                return;
            }

            try {
                var a = JSON.parse(saved);
                var text = a.city + '، ' + a.street;
                if (a.neighborhood) text += ' - الحي: ' + a.neighborhood;
                $('#guestAddressText').text(text);
                card.show();
            } catch (e) {
                localStorage.removeItem(PENDING_ADDRESS_KEY);
                card.hide();
            }
        }

        $(document).on('click', '#removeGuestAddressBtn', function () {
            localStorage.removeItem(PENDING_ADDRESS_KEY);
            renderGuestAddress();
        });

        // Payment card selection handler
        document.querySelectorAll('.payment-card').forEach(card => {
            card.addEventListener('click', function() {
                // Remove selected class from all cards
                document.querySelectorAll('.payment-card').forEach(c => c.classList.remove('selected'));

                // Add selected class to clicked card
                this.classList.add('selected');

                // Check the radio button
                this.querySelector('input[type="radio"]').checked = true;
            });
        });

        // Initialize map only when modal is fully shown
        $('#addressModal').on('shown.bs.modal', function () {
            setTimeout(() => {
                if (!map) {
                    map = L.map('map').setView([31.9522, 35.2332], 9);

                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '&copy; OpenStreetMap contributors'
                    }).addTo(map);

                    map.on('click', function (e) {
                        const lat = e.latlng.lat;
                        const lng = e.latlng.lng;
                        $('#locationLat').val(lat);
                        $('#locationLong').val(lng);

                        if (marker) {
                            marker.setLatLng([lat, lng]);
                        } else {
                            marker = L.marker([lat, lng]).addTo(map);
                        }
                    });
                } else {
                    map.invalidateSize();
                }
            }, 200);
        });

        // Client-side validation for address form
        function validateAddressForm() {
            const city = $('#city').val().trim();
            const street = $('#street').val().trim();
            const lat = $('#locationLat').val();
            const lng = $('#locationLong').val();

            if (!city) {
                Swal.fire('تنبيه', 'يرجى إدخال المدينة', 'warning');
                return false;
            }

            if (!street) {
                Swal.fire('تنبيه', 'يرجى إدخال الشارع', 'warning');
                return false;
            }

            if (!lat || !lng) {
                Swal.fire('تنبيه', 'يرجى تحديد الموقع على الخريطة', 'warning');
                return false;
            }

            return true;
        }

        // Submit new address
        $('#addressForm').submit(function (e) {
            e.preventDefault();

            if (!validateAddressForm()) {
                return;
            }

            var formData = {
                city: $('#city').val(),
                street: $('#street').val(),
                neighborhood: $('#neighborhood').val(),
                address: $('#addressDetails').val(),
                locationLat: $('#locationLat').val(),
                locationLong: $('#locationLong').val()
            };

            // Guests: keep the address locally; it is saved to the account right after login
            if (!isAuthenticated) {
                localStorage.setItem(PENDING_ADDRESS_KEY, JSON.stringify(formData));

                const modalEl = document.getElementById('addressModal');
                const modalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                modalInstance.hide();

                renderGuestAddress();
                this.reset();

                Swal.fire({
                    title: 'تم حفظ العنوان',
                    text: 'سيُضاف العنوان إلى حسابك تلقائياً بعد تسجيل الدخول.',
                    icon: 'success',
                    timer: 2000,
                    showConfirmButton: false
                });
                return;
            }

            // Show loading state
            const submitBtn = $(this).find('button[type="submit"]');
            const originalText = submitBtn.html();
            submitBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> جاري الإضافة...');

            $.ajax({
                url: '@Url.Action("Add", "Address")',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function (res) {
                   submitBtn.prop('disabled', false).html(originalText);

                   if (res.success) {

                       // Append the new address to the select list and select it (no page reload)
                       var created = res.data || res.Data;
                       if (created) {
                           var id = created.id ?? created.Id;
                           var city = created.city ?? created.City;
                           var street = created.street ?? created.Street;
                           var neighborhood = created.neighborhood ?? created.Neighborhood;

                           var text = city + ', ' + street;
                           if (neighborhood) text += ' - الحي: ' + neighborhood;

                           $('#addressId')
                               .append($('<option>', { value: id, text: text }))
                               .val(id);
                       }

                       $('#addressForm')[0].reset();
                       if (marker) {
                           map.removeLayer(marker);
                           marker = null;
                       }
                       $('#locationLat, #locationLong').val('');

                       // Close the modal, then show the toast only after it is fully
                       // hidden — firing Swal mid-transition leaves the backdrop stuck
                       const modalEl = document.getElementById('addressModal');
                       const modalInstance =
                           bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);

                       $(modalEl).one('hidden.bs.modal', function () {
                           $('.modal-backdrop').remove();
                           $('body').removeClass('modal-open').css({ overflow: '', 'padding-right': '' });

                           Swal.fire({
                               title: 'تم',
                               text: 'تم إضافة العنوان بنجاح',
                               icon: 'success',
                               timer: 1500,
                               showConfirmButton: false
                           });
                       });

                       modalInstance.hide();

                   } else {
                       Swal.fire('خطأ', res.message || 'حدث خطأ أثناء إضافة العنوان', 'error');
                   }
               },
               error: function () {
                   submitBtn.prop('disabled', false).html(originalText);
                   Swal.fire('خطأ', 'تعذر التواصل مع السيرفر. حاول لاحقاً.', 'error');
               }
            });
        });

        // Client-side validation for checkout form
        function validateCheckoutForm() {
            const addressId = $('#addressId').val();
            const phoneNumber = $('#orderPhoneNumber').val().trim();
            const paymentMethod = $('input[name="PaymentMethod"]:checked').val();

            if (!addressId) {
                Swal.fire('تنبيه', 'يرجى اختيار عنوان التوصيل', 'warning');
                $('#addressId').focus();
                return false;
            }

            if (!phoneNumber) {
                Swal.fire('تنبيه', 'يرجى إدخال رقم الهاتف للتواصل', 'warning');
                $('#orderPhoneNumber').focus();
                return false;
            }

            if (!paymentMethod) {
                Swal.fire('تنبيه', 'يرجى اختيار طريقة الدفع', 'warning');
                return false;
            }

            return true;
        }
        var couponCodeFromServer = '@(ViewBag.CouponCode ?? "")';

        // Submit checkout
        $('#checkoutForm').submit(function (e) {
            e.preventDefault();

            if (!validateCheckoutForm()) {
                return;
            }

            // Show loading overlay
            $('#loadingOverlay').addClass('active');

            // Disable submit button
            const submitBtn = $('.submit-order-btn');
            const originalText = submitBtn.html();
            submitBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> جاري إرسال الطلب...');

            const orderDto = {
                AddressId: parseInt($('#addressId').val()),
                PhoneNumber: $('#orderPhoneNumber').val().trim(),
                PaymentMethod: parseInt($('input[name="PaymentMethod"]:checked').val()),
                OrderMemo: $('#orderMemo').val() || null,
                CouponCode: couponCodeFromServer || null,      // get from ViewBag
                CouponDisValue: parseFloat($('#couponDisValue')?.val()) || null
            };

            $.ajax({
                url: '@Url.Action("CheckOut", "Order")',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(orderDto),
                success: function (res) {
                    $('#loadingOverlay').removeClass('active');
                    submitBtn.prop('disabled', false).html(originalText);

                    if (res.success) {
                        Swal.fire({
                            title: 'تم',
                            text: res.message || 'تم إرسال الطلب بنجاح',
                            icon: 'success',
                            confirmButtonText: 'عرض الطلب',
                            confirmButtonColor: '#48bb78'
                        }).then(() => {
                            window.location.href = '@Url.Action("Details", "Order")/' + res.data.id;
                        });
                    } else {
                        Swal.fire('خطأ', res.message || 'حدث خطأ أثناء إرسال الطلب', 'error');
                    }
                },
                error: function () {
                    $('#loadingOverlay').removeClass('active');
                    submitBtn.prop('disabled', false).html(originalText);
                    Swal.fire('خطأ', 'تعذر التواصل مع السيرفر. حاول لاحقاً.', 'error');
                }
            });
        });

        // After login: push the guest's pending address to the account, then select it
        function syncPendingAddress() {
            if (!isAuthenticated) {
                renderGuestAddress();
                return;
            }

            // An address created from the pending one is selected after the reload
            var selectId = localStorage.getItem(SELECT_ADDRESS_KEY);
            if (selectId) {
                localStorage.removeItem(SELECT_ADDRESS_KEY);
                if ($('#addressId option[value="' + selectId + '"]').length) {
                    $('#addressId').val(selectId);
                }
            }

            var pending = localStorage.getItem(PENDING_ADDRESS_KEY);
            if (!pending) return;

            var formData;
            try {
                formData = JSON.parse(pending);
            } catch (e) {
                localStorage.removeItem(PENDING_ADDRESS_KEY);
                return;
            }

            $.ajax({
                url: '@Url.Action("Add", "Address")',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function (res) {
                    if (res.success) {
                        localStorage.removeItem(PENDING_ADDRESS_KEY);

                        var created = res.data || res.Data;
                        var newId = created && (created.id || created.Id);
                        if (newId) {
                            localStorage.setItem(SELECT_ADDRESS_KEY, newId);
                        }

                        window.location.reload();
                    }
                }
            });
        }

        $(document).ready(function() {
            syncPendingAddress();

            // Checkout Section Entrance Animations
            // Animate checkout card
            $('.checkout-main-card').addClass('animate-slide-in-right');

            // Stagger animate form sections
            $('.address-selection-wrapper, .payment-methods-wrapper, .order-notes-wrapper').each(function(index) {
                const $section = $(this);
                setTimeout(() => {
                    $section.addClass('stagger-animation visible');
                }, index * 150);
            });

            // Animate payment cards
            $('.payment-card').each(function(index) {
                const $card = $(this);
                setTimeout(() => {
                    $card.addClass('bounce-in-animation');
                }, 300 + (index * 100));
            });
        });

        // Warn before leaving with unsaved changes
        let formChanged = false;
        $('#checkoutForm input, #checkoutForm textarea, #checkoutForm select').on('change', function() {
            formChanged = true;
        });

        $(window).on('beforeunload', function(e) {
            if (formChanged && $('#addressId').val() && $('input[name="PaymentMethod"]:checked').val()) {
                e.preventDefault();
                return 'لديك بيانات لم يتم إرسالها. هل أنت متأكد من المغادرة؟';
            }
        });

        // Clear warning flag on form submit
        $('#checkoutForm').on('submit', function() {
            formChanged = false;
        });
    </script>
}
