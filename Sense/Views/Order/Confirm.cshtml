@using Sense.Application.DTOs.AddressDTOs

@{
    var addresses = ViewBag.Addresses;
    var totalProducts = ViewBag.TotalProducts;
    var deliveryFee = ViewBag.DeliveryFee;
    var total = ViewBag.Total;
}
@section Styles
{
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

    <style>
        /* ===== CSS Custom Properties ===== */
        :root {
            --primary-blue: #253F8E;
            --primary-blue-dark: #1a2f6b;
            --primary-gold: #FFD700;
            --gold-dark: #c2932c;
            --success-green: #48bb78;
            --success-green-dark: #38a169;
            --text-primary: #2d3748;
            --text-secondary: #718096;
            --border-light: #e2e8f0;
            --bg-light: #f7fafc;
            --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.05);
            --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.08);
            --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.12);
        }

        /* ===== Smooth Scroll Behavior ===== */
        html {
            scroll-behavior: smooth;
        }

        @@media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }
        }

        /* ===== Page Animation ===== */
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes slideDown {
            from {
                opacity: 0;
                max-height: 0;
            }
            to {
                opacity: 1;
                max-height: 500px;
            }
        }

        @@keyframes pulse {
            0%, 100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.05);
            }
        }

        @@keyframes shimmer {
            0% {
                background-position: -1000px 0;
            }
            100% {
                background-position: 1000px 0;
            }
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        @@keyframes markerDrop {
            0% {
                transform: translateY(-100px);
                opacity: 0;
            }
            100% {
                transform: translateY(0);
                opacity: 1;
            }
        }

        @@keyframes slideInFromRight {
            from {
                transform: translateX(50px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @@keyframes slideInFromLeft {
            from {
                transform: translateX(-50px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        .animate-slide-in-right {
            animation: slideInFromRight 0.6s ease forwards;
        }

        .animate-slide-in-left {
            animation: slideInFromLeft 0.6s ease forwards;
        }

        .stagger-animation {
            opacity: 0;
        }

        .stagger-animation.visible {
            animation: fadeInUp 0.5s ease forwards;
        }

        @@keyframes bounceIn {
            0% {
                transform: scale(0.3);
                opacity: 0;
            }
            50% {
                transform: scale(1.05);
            }
            70% {
                transform: scale(0.9);
            }
            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        .bounce-in-animation {
            animation: bounceIn 0.5s ease;
        }

        /* ===== Main Card ===== */
        .checkout-main-card {
            animation: fadeInUp 0.6s ease-out;
            border-radius: 20px;
            border: none;
            overflow: hidden;
            box-shadow: var(--shadow-lg);
        }

        /* ===== Checkout Progress Indicator ===== */
        .checkout-progress {
            padding: 2rem;
            background: linear-gradient(135deg, #ffffff 0%, var(--bg-light) 100%);
            border-bottom: 2px solid var(--border-light);
        }

        .progress-steps {
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
            max-width: 600px;
            margin: 0 auto;
        }

        .progress-steps::before {
            content: '';
            position: absolute;
            top: 25px;
            left: 50px;
            right: 50px;
            height: 3px;
            background: var(--border-light);
            z-index: 0;
        }

        .progress-step {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.75rem;
            position: relative;
            z-index: 1;
            flex: 1;
        }

        .step-circle {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            transition: all 0.3s ease;
            background: white;
            border: 3px solid var(--border-light);
            color: var(--text-secondary);
        }

        .progress-step.completed .step-circle {
            background: linear-gradient(135deg, var(--success-green) 0%, var(--success-green-dark) 100%);
            border-color: var(--success-green);
            color: white;
        }

        .progress-step.active .step-circle {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%);
            border-color: var(--primary-blue);
            color: white;
            box-shadow: 0 4px 16px rgba(37, 63, 142, 0.4);
            animation: pulse 2s infinite;
        }

        .step-label {
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--text-secondary);
            text-align: center;
        }

        .progress-step.active .step-label {
            color: var(--primary-blue);
            font-weight: 700;
        }

        .progress-step.completed .step-label {
            color: var(--success-green);
        }

        /* ===== Order Summary Card ===== */
        .checkout-summary-card {
            background: linear-gradient(135deg, #ffffff 0%, var(--bg-light) 100%);
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border-light);
        }

        .summary-header {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--primary-blue);
            margin-bottom: 1rem;
            padding-bottom: 0.75rem;
            position: relative;
        }

        .summary-header::after {
            content: '';
            position: absolute;
            bottom: 0;
            right: 0;
            width: 60px;
            height: 3px;
            background: linear-gradient(90deg, var(--primary-gold) 0%, var(--gold-dark) 100%);
            border-radius: 2px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.75rem 0;
            border-bottom: 1px solid rgba(226, 232, 240, 0.5);
        }

        .summary-row:last-child {
            border-bottom: none;
        }

        .summary-label {
            font-size: 0.95rem;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .summary-value {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        .summary-total {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%);
            margin: 1rem -1.5rem -1.5rem;
            padding: 1rem 1.5rem;
            border-radius: 0 0 16px 16px;
        }

        .summary-total .summary-label,
        .summary-total .summary-value {
            color: white;
            font-size: 1.1rem;
        }

        .summary-total .summary-value {
            font-size: 1.35rem;
        }

        .riyal-icon {
            width: 18px;
            height: 18px;
            fill: currentColor;
        }

        /* ===== Form Section Headers ===== */
        .section-header {
            font-size: 1rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .section-header i {
            color: var(--primary-blue);
            font-size: 1.1rem;
        }

        /* ===== Address Selection ===== */
        .address-selection-wrapper {
            margin-bottom: 2rem;
        }

        .modern-select {
            border-radius: 12px;
            border: 2px solid var(--border-light);
            padding: 0.75rem 1rem;
            font-size: 1rem;
            color: var(--text-primary);
            transition: border-color 0.2s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.2s ease;
            background-color: white;
        }

        .modern-select:focus {
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 4px rgba(37, 63, 142, 0.1);
            outline: none;
        }

        .address-controls {
            display: flex;
            gap: 1rem;
            align-items: flex-start;
        }

        .address-controls .modern-select {
            flex: 1;
        }

        .add-address-btn {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 0.75rem 1.5rem;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.2s ease;
            white-space: nowrap;
            box-shadow: 0 4px 12px rgba(37, 63, 142, 0.3);
        }

        .add-address-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(37, 63, 142, 0.4);
        }

        .add-address-btn:active {
            transform: translateY(0);
        }

        /* ===== Payment Method Cards ===== */
        .payment-methods {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .payment-card {
            position: relative;
            border: 2px solid var(--border-light);
            border-radius: 12px;
            padding: 1.25rem;
            cursor: pointer;
            transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
            background: white;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 0.75rem;
        }

        .payment-card:hover {
            transform: scale(1.02);
            box-shadow: var(--shadow-md);
        }

        .payment-card input[type="radio"] {
            position: absolute;
            opacity: 0;
            width: 0;
            height: 0;
        }

        .payment-card.selected {
            border-color: var(--primary-blue);
            background: var(--bg-light);
            box-shadow: 0 4px 16px rgba(37, 63, 142, 0.15);
        }

        .payment-icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            transition: all 0.3s ease;
        }

        .payment-card.selected .payment-icon {
            transform: scale(1.1);
        }

        .payment-card[data-method="1"] .payment-icon {
            background: rgba(72, 187, 120, 0.1);
            color: var(--success-green);
        }

        .payment-card[data-method="2"] .payment-icon {
            background: rgba(255, 215, 0, 0.1);
            color: var(--gold-dark);
        }

        .payment-card[data-method="3"] .payment-icon {
            background: rgba(37, 63, 142, 0.1);
            color: var(--primary-blue);
        }

        .payment-name {
            font-weight: 700;
            font-size: 1rem;
            color: var(--text-primary);
        }

        .payment-description {
            font-size: 0.75rem;
            color: var(--text-secondary);
            line-height: 1.3;
        }

        .payment-checkmark {
            position: absolute;
            top: 8px;
            left: 8px;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: var(--primary-blue);
            color: white;
            display: none;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
        }

        .payment-card.selected .payment-checkmark {
            display: flex;
        }

        /* ===== Payment note ===== */
        .payment-coming-soon {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin: -1rem 0 2rem;
        }

        .payment-coming-soon i {
            color: var(--gold-dark);
        }

        /* ===== Form Inputs ===== */
        .modern-textarea {
            width: 100%;
            border-radius: 10px;
            border: 2px solid var(--border-light);
            padding: 0.75rem 1rem;
            font-size: 1rem;
            color: var(--text-primary);
            transition: border-color 0.2s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.2s ease;
            min-height: 100px;
            resize: vertical;
            font-family: 'Almarai', sans-serif;
        }

        .modern-textarea:focus {
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 4px rgba(37, 63, 142, 0.1);
            outline: none;
        }

        .modern-textarea::placeholder {
            color: #a0aec0;
        }

        .order-notes-wrapper {
            margin-bottom: 2rem;
        }

        /* ===== Action Buttons ===== */
        .action-buttons {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .submit-order-btn {
            background: linear-gradient(135deg, var(--success-green) 0%, var(--success-green-dark) 100%);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 1rem 2rem;
            font-size: 1.15rem;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.2s ease;
            box-shadow: 0 8px 24px rgba(72, 187, 120, 0.3);
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .submit-order-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.5s;
        }

        .submit-order-btn:hover::before {
            left: 100%;
        }

        .submit-order-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(72, 187, 120, 0.4);
        }

        .submit-order-btn:active {
            transform: translateY(0);
        }

        .submit-order-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        .back-to-cart-btn {
            background: transparent;
            color: var(--primary-blue);
            border: 2px solid var(--primary-blue);
            border-radius: 12px;
            padding: 1rem 2rem;
            font-size: 1.15rem;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .back-to-cart-btn:hover {
            background: var(--primary-blue);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(37, 63, 142, 0.3);
        }

        /* ===== Modal Styles ===== */
        .address-modal .modal-content {
            border-radius: 20px;
            border: none;
            overflow: hidden;
        }

        .address-modal .modal-header {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%);
            color: white;
            padding: 1.5rem;
            border: none;
            position: relative;
        }

        .address-modal .modal-title {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-weight: 700;
            font-size: 1.25rem;
        }

        .address-modal .btn-close {
            filter: brightness(0) invert(1);
            position: absolute;
            top: 1.25rem;
            left: 1.25rem;
            margin: 0;
        }

        .address-modal .modal-body {
            padding: 2rem;
        }

        .address-modal .card {
            border-radius: 16px;
            border: 1px solid var(--border-light);
            box-shadow: var(--shadow-sm);
        }

        .address-modal .card-header {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%);
            color: white;
            border: none;
            padding: 1rem 1.5rem;
            font-weight: 700;
            border-radius: 16px 16px 0 0 !important;
        }

        .address-modal .form-control,
        .address-modal textarea {
            border-radius: 10px;
            border: 2px solid var(--border-light);
            padding: 0.75rem 1rem;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .address-modal .form-control:focus,
        .address-modal textarea:focus {
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 4px rgba(37, 63, 142, 0.1);
            outline: none;
        }

        .address-modal .form-label {
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
        }

        #map {
            height: 350px;
            border-radius: 12px;
            border: 2px solid var(--border-light);
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.06);
            overflow: hidden;
        }

        .address-modal .modal-action-buttons .btn {
            white-space: nowrap;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .address-modal .btn-primary {
            background: var(--primary-blue);
            border: none;
            border-radius: 10px;
            padding: 0.75rem 1.5rem;
            font-weight: 700;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(37, 63, 142, 0.3);
        }

        .address-modal .btn-primary:hover {
            background: var(--primary-blue-dark);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(37, 63, 142, 0.4);
        }

        .address-modal .btn-warning {
            background: var(--primary-gold);
            border: none;
            border-radius: 10px;
            padding: 0.75rem 1.5rem;
            font-weight: 700;
            color: white;
            transition: all 0.3s ease;
        }

        .address-modal .btn-warning:hover {
            background: var(--gold-dark);
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(255, 215, 0, 0.4);
        }

        /* ===== Loading Overlay ===== */
        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }

        .loading-overlay.active {
            display: flex;
        }

        .loading-spinner {
            background: white;
            padding: 2rem;
            border-radius: 16px;
            text-align: center;
            box-shadow: var(--shadow-lg);
        }

        .loading-spinner i {
            font-size: 3rem;
            color: var(--primary-blue);
            animation: spin 1s linear infinite;
        }

        .loading-spinner p {
            margin-top: 1rem;
            font-weight: 600;
            color: var(--text-primary);
        }

        /* ===== Responsive Styles ===== */
        @@media (max-width: 768px) {
            .checkout-progress {
                padding: 1.5rem 1rem;
            }

            .progress-steps {
                flex-direction: column;
                gap: 1.5rem;
            }

            .progress-steps::before {
                display: none;
            }

            .step-circle {
                width: 40px;
                height: 40px;
                font-size: 1rem;
            }

            .step-label {
                font-size: 0.8rem;
            }

            .checkout-summary-card {
                padding: 1.25rem;
            }

            .checkout-main-card .card-body {
                padding: 1.5rem;
            }

            .summary-header {
                font-size: 1.1rem;
            }

            .address-controls {
                flex-direction: column;
                gap: 0.75rem;
            }

            .add-address-btn {
                width: 100%;
                min-height: 48px;
            }

            .payment-methods {
                grid-template-columns: 1fr;
                gap: 0.75rem;
            }

            .payment-card {
                flex-direction: row;
                text-align: right;
                padding: 1rem;
                min-height: 64px;
                touch-action: manipulation;
            }

                .payment-card:active {
                    transform: scale(0.98);
                }

            .payment-icon {
                width: 40px;
                height: 40px;
                font-size: 1.25rem;
            }

            .modern-select,
            .modern-textarea,
            .submit-order-btn,
            .back-to-cart-btn {
                font-size: 16px; /* Prevent zoom on iOS */
            }

            .modern-select,
            .modern-textarea {
                min-height: 48px;
            }

            .submit-order-btn,
            .back-to-cart-btn {
                padding: 1rem;
                min-height: 48px;
                touch-action: manipulation;
            }

                .submit-order-btn:active,
                .back-to-cart-btn:active {
                    transform: scale(0.95);
                    opacity: 0.9;
                }

            #map {
                height: 250px;
            }

            .address-modal .modal-body {
                padding: 1.5rem;
            }
        }

        @@media (max-width: 576px) {
            .summary-row {
                font-size: 0.9rem;
            }

            .summary-total .summary-value {
                font-size: 1.2rem;
            }
        }

        @@media (max-width: 480px) {
            .checkout-main-card .card-body {
                padding: 1rem;
            }

            .checkout-summary-card {
                padding: 1rem;
            }

            .modern-select,
            .modern-textarea {
                font-size: 16px;
                min-height: 48px;
                padding: 0.875rem 1rem;
            }

            .address-controls {
                gap: 0.75rem;
            }

            .add-address-btn {
                min-height: 48px;
                width: 100%;
            }

            .checkout-progress {
                padding: 1rem 0.5rem;
            }

            .step-circle {
                width: 36px;
                height: 36px;
            }

            .step-label {
                font-size: 0.75rem;
                margin-top: 0.5rem;
            }

            .summary-row {
                margin-bottom: 0.75rem;
            }
        }

        @@media (min-width: 481px) and (max-width: 640px) {
            .checkout-main-card .card-body {
                padding: 1.5rem;
            }

            .checkout-summary-card {
                padding: 1.25rem;
            }

            .step-circle {
                width: 42px;
                height: 42px;
            }

            .step-label {
                font-size: 0.85rem;
            }
        }

        @@media (orientation: landscape) and (max-height: 600px) {
            .checkout-progress {
                padding: 0.75rem 1rem;
            }

            .progress-steps {
                flex-direction: row;
                gap: 1rem;
            }

            .step-circle {
                width: 32px;
                height: 32px;
                font-size: 0.9rem;
            }

            .step-label {
                font-size: 0.7rem;
                margin-top: 0.25rem;
            }

            .checkout-summary-card {
                padding: 1rem;
            }

            .checkout-main-card .card-body {
                padding: 1rem;
            }

            .payment-methods {
                grid-template-columns: repeat(3, 1fr);
                gap: 0.5rem;
            }

            .payment-card {
                padding: 0.75rem;
                min-height: auto;
            }

            .modern-textarea {
                min-height: 80px;
            }

            .submit-order-btn,
            .back-to-cart-btn {
                padding: 0.75rem 1.5rem;
                font-size: 1rem;
            }
        }

        /* Form States */
        .modern-select:focus,
        .modern-textarea:focus {
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 3px rgba(37, 63, 142, 0.1);
            outline: none;
        }

        .modern-select.input-error,
        .modern-textarea.input-error {
            border-color: #e53e3e;
            animation: shake 0.4s ease;
        }

        .modern-select.input-success,
        .modern-textarea.input-success {
            border-color: var(--success-green);
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            50% { transform: translateX(5px); }
            75% { transform: translateX(-5px); }
        }

        /* Loading States */
        .btn-loading {
            opacity: 0.7;
            pointer-events: none;
            position: relative;
        }

            .btn-loading::after {
                content: '';
                position: absolute;
                width: 16px;
                height: 16px;
                border: 2px solid transparent;
                border-top-color: currentColor;
                border-radius: 50%;
                animation: spin 0.8s linear infinite;
                top: 50%;
                left: 50%;
                margin: -8px 0 0 -8px;
            }

        .skeleton-loader {
            background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
            border-radius: 8px;
        }

        .progress-bar {
            height: 4px;
            background: var(--border-light);
            border-radius: 2px;
            overflow: hidden;
        }

            .progress-bar::before {
                content: '';
                display: block;
                height: 100%;
                background: linear-gradient(90deg, var(--primary-blue), var(--primary-gold));
                width: 0%;
                transition: width 0.3s ease;
            }

        .overlay-loading {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }

        .toast-notification {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%) translateY(-100px);
            background: white;
            padding: 1rem 1.5rem;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
            animation: slideDownToast 0.4s ease forwards;
            z-index: 10000;
        }

        @@keyframes slideDownToast {
            to {
                transform: translateX(-50%) translateY(0);
            }
        }

        /* ===== Utility Classes ===== */
        .fade-in {
            animation: fadeInUp 0.6s ease-out;
        }

        .highlight-new {
            animation: pulse 0.5s ease-out;
            background-color: rgba(72, 187, 120, 0.1);
        }

        /* ===== Custom Scrollbar ===== */
        .address-modal .modal-body::-webkit-scrollbar {
            width: 8px;
        }

        .address-modal .modal-body::-webkit-scrollbar-track {
            background: var(--bg-light);
        }

        .address-modal .modal-body::-webkit-scrollbar-thumb {
            background: var(--primary-blue);
            border-radius: 4px;
        }
    </style>
}

<div class="container my-5">
