            background: #ffffff;
        }

        .company-header {
            text-align: center;
            margin-bottom: 30px;
        }

            .company-header img {
                max-height: 80px;
                margin-bottom: 10px;
            }

        .section {
            margin-bottom: 25px;
        }

            .section h4 {
                border-bottom: 1px solid #ddd;
                padding-bottom: 5px;
                margin-bottom: 15px;
                color: #007bff;
            }

            .section p {
                margin: 5px 0;
            }

        table {
            width: 100%;
