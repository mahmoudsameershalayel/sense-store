@section Scripts {
<script src="~/assets/plugins/custom/leaflet/leaflet.bundle.js"></script>
<script>
    // Check for required dependencies
    if (typeof jQuery === 'undefined') {
        console.error('jQuery is required but not loaded');
        return;
    }
    if (typeof Swal === 'undefined') {
        console.error('SweetAlert2 is required but not loaded');
        return;
    }
    const RIYAL_SVG = '<svg class="riyal-svg currency" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 78.917 78.917" width="15" height="15" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-0.125em"><path d="M32.501,16.458H9.021L9,66.958c0,2.48-2.019,4.5-4.5,4.5s-4.5-2.02-4.5-4.5l0.025-55.005c0.003-2.479,2.021-4.495,4.5-4.495h27.977c13.51,0,24.5,10.991,24.5,24.5v23c0,2.48-2.02,4.5-4.5,4.5s-4.5-2.02-4.5-4.5v-23C48.001,23.412,41.048,16.458,32.501,16.458z M74.417,7.458c-2.481,0-4.5,2.019-4.5,4.5l-0.021,50.5h-23.48c-8.547,0-15.5-6.953-15.5-15.5v-23c0-2.481-2.019-4.5-4.5-4.5s-4.5,2.019-4.5,4.5v23c0,13.509,10.99,24.5,24.5,24.5h27.977c2.479,0,4.498-2.016,4.5-4.495l0.024-55.005C78.917,9.478,76.898,7.458,74.417,7.458z" /></svg>';
    let pointsInfo = null;
    let originalTotal = @Model.OrderNetValue;
    let existingPointsTransaction = null;
    let addressMap;
    let addressMarker;
    let pointsLoadRetryCount = 0;
    const MAX_RETRY_ATTEMPTS = 3;

    // Load points information when page loads
    $(document).ready(function() {
        loadPointsInfoWithRetry();
    });

    function loadPointsInfoWithRetry() {
        loadPointsInfo();
    }

    // Initialize map when modal is shown
    $('#addressMapModal').on('shown.bs.modal', function () {
        if (!window.addressMapInitialized) {
            initAddressMap();
            window.addressMapInitialized = true;
        } else if (addressMap) {
            // Invalidate size to fix rendering issues
            setTimeout(() => {
                addressMap.invalidateSize();
                // Re-center map on mobile
                if (addressMarker && window.innerWidth <= 768) {
                    addressMap.setView(addressMarker.getLatLng(), 14);
                }
            }, 100);
        }
    });

    // Handle modal close to prevent memory leaks
    $('#addressMapModal').on('hidden.bs.modal', function () {
        if (addressMap) {
            addressMap.invalidateSize();
        }
    });

    // Initialize address map with geocoding fallback
    function initAddressMap() {
        const latStr = '@Model.Address?.LocationLat';
        const lngStr = '@Model.Address?.LocationLong';
        const lat = parseFloat(latStr);
        const lng = parseFloat(lngStr);

        // Check if coordinates are valid
        const hasValidCoords = !isNaN(lat) && !isNaN(lng) && lat !== 0 && lng !== 0;

        if (hasValidCoords) {
            // Use provided coordinates
            createMap(lat, lng);
        } else {
            // Try geocoding with city name
            const city = '@Model.Address?.City';
            if (city && city.trim() !== '') {
                geocodeCity(city);
            } else {
                // Default to Riyadh center
                createMap(24.7136, 46.6753);
            }
        }
    }

    // Geocode city name using Nominatim API
    function geocodeCity(city) {
        // Show loading spinner
        const mapContainer = $('#orderAddressMap');
        mapContainer.html('<div class="map-loading"><i class="fas fa-spinner fa-spin"></i><div style="margin-top: 10px;">جاري تحميل الموقع...</div></div>');

        $.ajax({
            url: 'https://nominatim.openstreetmap.org/search',
            method: 'GET',
            data: {
                format: 'json',
                q: city + ', Saudi Arabia',
                limit: 1
            },
            headers: {
                'User-Agent': 'SenseApp/1.0'
            },
            timeout: 5000,
            success: function(response) {
                if (response && response.length > 0) {
                    const lat = parseFloat(response[0].lat);
                    const lng = parseFloat(response[0].lon);
                    createMap(lat, lng);
                } else {
                    console.log('No geocoding results found, using default location');
                    createMap(24.7136, 46.6753);
                }
            },
            error: function(xhr, status, error) {
                console.error('Geocoding error:', error);
                createMap(24.7136, 46.6753);
            }
        });
    }

    // Create and initialize the map
    function createMap(lat, lng) {
        // Clear loading spinner
        $('#orderAddressMap').html('');

        // Initialize map centered on the coordinates
        addressMap = L.map('orderAddressMap').setView([lat, lng], 15);

        // Add OpenStreetMap tiles
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            maxZoom: 19
        }).addTo(addressMap);

        // Create custom marker icon
        const customIcon = L.divIcon({
            html: '<i class="fas fa-map-marker-alt" style="color: #dc3545; font-size: 32px;"></i>',
            iconSize: [32, 32],
            iconAnchor: [16, 32],
            popupAnchor: [0, -32],
            className: 'custom-marker-icon'
        });

        // Add marker with popup
        addressMarker = L.marker([lat, lng], { icon: customIcon }).addTo(addressMap);

        const city = '@Model.Address?.City' || '';
        const street = '@Model.Address?.Street' || '';
        const neighborhood = '@Model.Address?.Neighborhood' || '';

        const popupContent = `
            <div class="address-marker-popup">
                <strong>📍 عنوان التوصيل</strong>
                ${city && street ? `<div>${city}, ${street}</div>` : ''}
                ${neighborhood ? `<div>الحي: ${neighborhood}</div>` : ''}
            </div>
        `;

        addressMarker.bindPopup(popupContent).openPopup();
    }

    function loadPointsInfo() {
        // Show loading skeleton
        $('#pointsLoadingState').show();
        $('.points-content').hide();
        
        $.ajax({
            url: '@Url.Action("InfoOrder", "Points")?orderId=@Model.Id',
            method: 'GET',
            timeout: 10000,
            success: function(response) {
                pointsLoadRetryCount = 0; // Reset on success
                $('#pointsLoadingState').hide();
                $('.points-content').show();
                
                if (response.result.code === 200) {
                    pointsInfo = response.data;
                    updatePointsUI();
                    announceToScreenReader('تم تحميل معلومات النقاط بنجاح');
                    if (pointsInfo.data.alreadyRedeemed) {
                        loadExistingTransaction();
                    }
                }
            },
            error: function(xhr, status, error) {
                $('#pointsLoadingState').hide();
                
                // Retry logic for network errors
                if ((status === 'timeout' || status === 'error') && pointsLoadRetryCount < MAX_RETRY_ATTEMPTS) {
                    pointsLoadRetryCount++;
                    console.log(`Retrying points load (attempt ${pointsLoadRetryCount}/${MAX_RETRY_ATTEMPTS})...`);
                    setTimeout(loadPointsInfo, 2000 * pointsLoadRetryCount); // Exponential backoff
                } else {
                    showPointsLoadError(status, error);
                }
            }
        });
    }
    
    function showPointsLoadError(status, error) {
        const errorMessages = {
            'timeout': 'انتهت مهلة الاتصال. يرجى التحقق من اتصال الإنترنت والمحاولة مرة أخرى.',
            'error': 'حدث خطأ في تحميل معلومات النقاط. يرجى تحديث الصفحة.',
            'parsererror': 'خطأ في معالجة البيانات. يرجى المحاولة لاحقاً.'
        };
        
        const message = errorMessages[status] || 'حدث خطأ غير متوقع';
        
        $('#pointsRedemptionSection').show();
        $('.points-content').html(`
            <div class="alert alert-warning text-center" style="margin: 20px; padding: 20px; border-radius: 12px;">
                <i class="fas fa-exclamation-triangle" style="font-size: 48px; color: #ffc107; margin-bottom: 15px;"></i>
                <h5 style="margin-bottom: 10px;">تعذر تحميل معلومات النقاط</h5>
                <p style="margin-bottom: 15px;">${message}</p>
                <button onclick="loadPointsInfo()" class="btn btn-primary">
                    <i class="fas fa-redo me-2"></i>إعادة المحاولة
                </button>
            </div>
        `);
    }
    
    function loadExistingTransaction() {
        // This would ideally call an API to get existing transaction details
        // For now, we'll simulate this by checking if there's a transaction
        // In a real implementation, you'd want to add an endpoint to get transaction details
        $.ajax({
            url: '@Url.Action("GetTransactionByOrder", "Points")?orderId=@Model.Id',
            method: 'GET',
            success: function(response) {
                if (response.result && response.result.code === 200 && response.data) {
                    // Show the existing discount
                    const discountAmount = response.data.amountDeducted;
                    const newTotal = originalTotal - discountAmount;
                    
                    $('#pointsDiscountAmount').text(discountAmount.toFixed(2));
                    $('#pointsDiscountRow').show();
                    $('#finalTotal').html(newTotal.toFixed(2) + ' ' + RIYAL_SVG);
                }
            },
            error: function(xhr) {
                // If endpoint doesn't exist, ignore the error
                console.log('Transaction details endpoint not available');
            }
        });
    }
    
    function updatePointsUI() {
        if (!pointsInfo) return;
        
        $('#currentPoints').text(pointsInfo.data.currentPoints);
        $('#minPoints').text(pointsInfo.data.minRedeemPoints);
        $('#maxPoints').text(pointsInfo.data.maxRedeemPoints);
        $('#pointsToRedeem').attr('max', Math.min(pointsInfo.data.currentPoints, pointsInfo.data.maxRedeemPoints));
        $('#conversionRate').html(`معدل التحويل: 1 نقطة = ${pointsInfo.data.pointsToSARRate.toFixed(2)} ${RIYAL_SVG}`);
        
        // Server-side eligibility check
        if (pointsInfo.isEligible === false) {
            if (pointsInfo.data.alreadyRedeemed) {
                showAlreadyRedeemedMessage();
            } else {
                $('#pointsRedemptionSection').hide();
            }
            return;
        }
        
        if (pointsInfo.data.canRedeem && !pointsInfo.data.alreadyRedeemed) {
            $('#pointsRedemptionSection').show();
            $('#redeemBtn').prop('disabled', false);
        } else {
            if (pointsInfo.data.alreadyRedeemed) {
                showAlreadyRedeemedMessage();
            } else {
                $('#pointsRedemptionSection').hide();
            }
        }
    }
    
    function showAlreadyRedeemedMessage() {
        $('#pointsRedemptionSection').show();
        $('.points-form').html(`
            <div class="alert-centered">
                <i class="fas fa-info-circle me-2"></i>
                تم استرداد النقاط مسبقاً لهذا الطلب
            </div>
        `);
    }
    
    // Debounce function for performance
    function debounce(func, wait) {
        let timeout;
        return function executedFunction(...args) {
            const later = () => {
                clearTimeout(timeout);
                func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
        };
    }

    // Handle points input change with debounced real-time preview
    const updateDiscountPreview = debounce(function() {
        const points = parseInt($('#pointsToRedeem').val()) || 0;
        if (points > 0 && pointsInfo && pointsInfo.data) {
            const discountAmount = points * pointsInfo.data.pointsToSARRate;
            $('#discountAmount').text(discountAmount.toFixed(2));
            $('#discountPreview').show();
        } else {
            $('#discountPreview').hide();
        }
    }, 300);

    $('#pointsToRedeem').on('input', updateDiscountPreview);
    
    // Handle points redemption form submission
    $('#pointsRedemptionForm').on('submit', function(e) {
        e.preventDefault();
        
        const pointsToRedeem = parseInt($('#pointsToRedeem').val());
        
        // Comprehensive validation
        if (!pointsToRedeem || isNaN(pointsToRedeem) || pointsToRedeem <= 0) {
            Swal.fire({
                icon: 'warning',
                title: 'تحذير',
                text: 'يرجى إدخال عدد صحيح من النقاط',
                confirmButtonText: 'حسناً',
                confirmButtonColor: '#3085d6'
            });
            return;
        }
        
        if (pointsToRedeem < pointsInfo.data.minRedeemPoints) {
            Swal.fire({
                icon: 'warning',
                title: 'تحذير',
                text: `الحد الأدنى لاسترداد النقاط هو ${pointsInfo.data.minRedeemPoints} نقطة`,
                confirmButtonText: 'حسناً',
                confirmButtonColor: '#3085d6'
            });
            return;
        }
        
        if (pointsToRedeem > pointsInfo.data.maxRedeemPoints) {
            Swal.fire({
                icon: 'warning',
                title: 'تحذير',
                text: `الحد الأقصى لاسترداد النقاط هو ${pointsInfo.data.maxRedeemPoints} نقطة`,
                confirmButtonText: 'حسناً',
                confirmButtonColor: '#3085d6'
            });
            return;
        }
        
        if (pointsToRedeem > pointsInfo.data.currentPoints) {
            Swal.fire({
                icon: 'warning',
                title: 'رصيد غير كافٍ',
                text: `رصيدك الحالي: ${pointsInfo.data.currentPoints} نقطة فقط`,
                confirmButtonText: 'حسناً',
                confirmButtonColor: '#3085d6'
            });
            return;
        }
        
        // Show confirmation dialog before redemption
        Swal.fire({
            title: 'تأكيد الاسترداد',
            html: `
                <p>هل أنت متأكد من استرداد <strong>${pointsToRedeem}</strong> نقطة؟</p>
                <p>سيتم خصم <strong>${(pointsToRedeem * pointsInfo.data.pointsToSARRate).toFixed(2)}</strong> ${RIYAL_SVG} من الفاتورة</p>
            `,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'نعم، استرداد',
            cancelButtonText: 'إلغاء',
            confirmButtonColor: '#28a745',
            cancelButtonColor: '#6c757d'
        }).then((result) => {
            if (result.isConfirmed) {
                redeemPoints(pointsToRedeem);
            }
        });
    });
    
    // Optimize for mobile touch interactions
    if ('ontouchstart' in window) {
        // Add haptic feedback simulation for mobile
        $('#redeemBtn, .btn-redeem').on('touchstart', function() {
            $(this).addClass('touch-active');
        }).on('touchend touchcancel', function() {
            $(this).removeClass('touch-active');
        });
        
        // Prevent accidental double-tap zoom on number input
        $('#pointsToRedeem').on('touchend', function(e) {
            e.preventDefault();
            $(this).focus();
        });
    }
    
    // Accessibility helper function
    function announceToScreenReader(message) {
        $('#pointsStatusMessage').text(message);
        setTimeout(() => $('#pointsStatusMessage').text(''), 3000);
    }
    
    function redeemPoints(pointsToRedeem) {
        const redeemData = {
            pointsToRedeem: pointsToRedeem,
            orderId: @Model.Id
        };
        
        $('#redeemBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>جاري الاسترداد...');
        
        $.ajax({
            url: '@Url.Action("Redeem", "Points")',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(redeemData),
            success: function(response) {
                if (response.result.code === 200) {
                    const discountAmount = response.data.amountDeducted;
                    const newTotal = originalTotal - discountAmount;

                    // Update UI
                    $('#pointsDiscountAmount').text(discountAmount.toFixed(2));
                    $('#pointsDiscountRow').show();
                    $('#finalTotal').html(newTotal.toFixed(2) + ' ' + RIYAL_SVG);
                    $('#currentPoints').text(response.data.remainingPoints);

                    showAlreadyRedeemedMessage();

                    announceToScreenReader('تم استرداد النقاط بنجاح');

                    Swal.fire({
                        icon: 'success',
                        title: 'تم الاسترداد بنجاح!',
                        html: `تم خصم ${discountAmount.toFixed(2)} ${RIYAL_SVG} من إجمالي الفاتورة`,
                        confirmButtonText: 'ممتاز!'
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'خطأ',
                        text: response.result.message || 'حدث خطأ أثناء استرداد النقاط',
                        confirmButtonText: 'حسناً'
                    });
                }
            },
            error: function(xhr) {
                Swal.fire({
                    icon: 'error',
                    title: 'خطأ',
                    text: 'حدث خطأ أثناء الاتصال بالخادم',
                    confirmButtonText: 'حسناً'
                });
            },
            complete: function() {
                $('#redeemBtn').prop('disabled', false).html('<i class="fas fa-gift me-2"></i>استرداد النقاط');
            }
        });
    }
</script>
}
