                <div class="text-end mt-3">
                    <h5 class="text-success text-end"><strong><i class="fas fa-coins"></i> إجمالي الكاش باك المستلم:</strong> @((int)Model.TotalCashbackReceived)</h5>
                </div>
            </div>
        }
    </div>
</div>

<!-- Address Map Modal -->
<div class="modal fade" id="addressMapModal" tabindex="-1" aria-labelledby="addressMapModalLabel" aria-hidden="true">
