@using Sense.Application.DTOs.OfferCashbackDTOs
@model List<CashbackOfferDto>
@section Styles
{
    <style type="text/css">
        .contact-banner {
            position: relative;
            width: 100%;
            height: 150px;
            background: url('@Url.Content("~/assets/img/cashback.jpg")') no-repeat center center/cover;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-align: center;
        }

            .contact-banner::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.5);
                z-index: 1;
            }

        .contact-banner-text {
            position: relative;
            z-index: 2;
        }

            .contact-banner-text h1 {
                font-size: 3rem;
                color: white;
                margin: 0;
                padding: 0;
            }

            .contact-banner-text p {
                font-size: 1.25rem;
            }
    </style>
}
<div class="contact-banner">
    <div class="contact-banner-text">
        <h1>
            عروض الكاش باك
        </h1>

    </div>
</div>
<section id="store" class="section py-5" dir="rtl">

    <!-- Cashback Offer Page -->
    <div class="container py-5">
        <div class="row justify-content-center">
            @foreach (var offer in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-body text-center">
                            <h3 class="card-title">عرض كاش باك</h3>
                            <p class="card-text">استمتع بعرض كاش باك بنسبة <strong>@offer.CashbackVal</strong> على الخدمات المحددة!</p> <!-- Arabic Text -->
                            <p>يبدأ العرض من: <strong>@offer.StartDate</strong></p>
                            <p>ينتهي العرض في: <strong>@offer.EndDate</strong></p>
                            <p>نوع العرض: <strong>@offer.CashbackType</strong></p>
                            @if (offer.IsActive == true)
                            {
                                <p class="text-success">

                                    <strong>نشط</strong>
                                </p>
                            }
                            else
                            {
                                <p class="text-danger">

                                    <strong>معطل</strong>
                                </p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>