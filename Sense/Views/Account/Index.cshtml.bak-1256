<!-- Modal for Address Booking -->
<div class="modal fade" id="addressModal" tabindex="-1" aria-labelledby="addressModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addressModalLabel">≈÷«›… ⁄‰Ê«‰</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addressForm">
                    <div class="row">
                        <div class="col-12">
                            <div class="card shadow-sm mb-4">
                                <h5 class="card-header" style="background-color: #253F8E; color: white;">«„·√ »Ì«‰«  ⁄‰Ê«‰ﬂ</h5>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6 mb-4">
                                            <label for="city" class="form-label">«·„œÌ‰…</label>
                                            <input type="text" class="form-control" id="city" name="city">
                                        </div>
                                        <div class="col-md-6 mb-4">
                                            <label for="street" class="form-label">«·‘«—⁄</label>
                                            <input type="text" class="form-control" id="street" name="street">
                                        </div>
                                    </div>
                                   
                                    <div class="row">
                                        <div class="col-md-6 mb-4">
                                            <label for="neighborhood" class="form-label">«·ÕÌ «·”ﬂ‰Ì</label>
                                            <input type="text" class="form-control" id="neighborhood" name="neighborhood">
                                        </div>
                                        <div class="col-md-6 mb-4">
                                            <label for="addressDetails" class="form-label"> ›«’Ì· ≈÷«›Ì…</label>
                                            <textarea class="form-control" id="addressDetails" name="address" rows="4"></textarea>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">«Œ — «·„Êﬁ⁄ ⁄·Ï «·Œ—Ìÿ…</label>
                                        <div id="map" style="height: 300px;"></div>
                                    </div>
                                    <input type="hidden" id="locationLat" name="locationLat" />
                                    <input type="hidden" id="locationLong" name="locationLong" />
                                </div>
                            </div>
                        </div>
                    </div>


                    <!-- Submit Buttons -->
                    <div class="row mt-4">
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                            <button type="submit" class="btn btn-lg w-100" style="background-color: #253F8E; color: white;">≈÷«›…</button>
                        </div>
                        <div class="col-lg-4 col-md-4 col-sm-6 mb-3">
                            <input type="reset" class="btn btn-warning btn-lg w-100" value="≈⁄«œ… «·÷»ÿ">
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>  
</div>


<!-- Modal for Appointment Booking -->
<div class="modal fade" id="appointmentModal" tabindex="-1" aria-labelledby="appointmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="appointmentModalLabel">ÕÃ“ „Ê⁄œ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Appointment Form -->
                <form id="appointmentForm">
                    <div class="row">
                        <div class="col-12">
                            <div class="card shadow-sm mb-4">
                                <h5 class="card-header" style="background-color: #253F8E; color: white;">«„·√ »Ì«‰«  ”Ì«— ﬂ</h5>
                                <div class="card-body">
                                    <div class="mb-4">
                                        <label for="vehicleBrand" class="form-label">„«—ﬂ… «·”Ì«—…</label>
                                        <select id="vehicleBrand" class="select2 form-select form-select-lg">
                                            <option hidden disabled selected> -- «Œ — «·„«—ﬂ… -- </option>
                                            @foreach (var item in brands)
                                            {
                                                <option value="@item.Id">
                                                    @item.Name
                                                </option>
                                            }

                                        </select>
                                    </div>
                                    <div class="mb-4">
                                        <label for="vehicleModel" class="form-label">„ÊœÌ· «·”Ì«—…</label>
