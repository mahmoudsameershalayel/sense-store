<!-- Upload Profile Image Modal -->
<div class="modal fade" id="uploadProfileImageModal" tabindex="-1" aria-labelledby="uploadProfileImageModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editProfileModalLabel">—›⁄ ’Ê—… «·„·› «·‘Œ’Ì</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>

            </div>
            <div class="modal-body">
                <div class="alert alert-info m-3 text-right">
                    <h5 class="alert-heading mb-2">
                        <i class="fas fa-info-circle ml-2"></i>
                         ⁄·Ì„«  —›⁄ «·’Ê—…:
                    </h5>
                    <ul class="list-unstyled mb-0">
                        <li>ï ÌÃ» √‰  ﬂÊ‰ «·’Ê—… »’Ì€… JPEG , PNG √Ê JPG </li>
                        <li>ï «·Õœ «·√ﬁ’Ï ·ÕÃ„ ﬂ· „·›: 5 „ÌÃ«»«Ì  (5000 ﬂÌ·Ê»«Ì )</li>
                    </ul>
                </div>
                <form id="uploadProfileImageForm" enctype="multipart/form-data">
                    <input type="hidden" value="@user.Id" id="userId">
                    <div class="mb-3">
                        <label for="image">’Ê—… «·„·› «·‘Œ’Ì :</label>
                        <input type="file" class="form-control" id="image">
                    </div>
                    <button type="submit" class="btn btn-primary">—›⁄ «·’Ê—…</button>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script type="text/javascript">
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        connection.start()
            .then(() => {
                console.log("Connected to chat hub");

                // Load previous messages
                connection.invoke("GetPreviousMessages")
                    .then(messages => {
                        messages.forEach(msg => {
                            appendMessage(msg, msg.isSender);
                        });
                    })
                    .catch(err => console.error("Failed to load messages: " + err.toString()));
            })
            .catch(err => console.error(err.toString()));

        // Send message to tech support
        document.getElementById("sendButton").addEventListener("click", () => {
            const messageInput = document.getElementById("messageInput");
            const message = messageInput.value.trim();
            if (!message) return;

            connection.invoke("SendMessageToTechSupport", message)
                .catch(err => console.error(err.toString()));
            const now = new Date();
            const formattedTimestamp = now.getFullYear() + "-" +
                String(now.getMonth() + 1).padStart(2, '0') + "-" +
                String(now.getDate()).padStart(2, '0') + " " +
                String(now.getHours()).padStart(2, '0') + ":" +
                String(now.getMinutes()).padStart(2, '0') + ":" +
                String(now.getSeconds()).padStart(2, '0');
            appendMessage({ message: message, timestamp: formattedTimestamp }, true);
            messageInput.value = '';
        });

        // Receive messages from tech support
        connection.on("ReceiveSupportMessage", function (msg) {
            console.log(msg);
            appendMessage(msg, false);
        });

        // Show who is assigned to chat
        connection.on("ChatAssigned", function (techSupportName) {
            const infoDiv = document.createElement("div");
            infoDiv.classList.add("system-message");
            infoDiv.innerText = `You are now chatting with ${techSupportName}`;
            document.getElementById("messagesList").appendChild(infoDiv);
        });

        function appendMessage(msg, isSender) {
            const msgBox = document.getElementById("messagesList");

            const msgDiv = document.createElement("div");
            msgDiv.classList.add("message", isSender ? "sent" : "received");

            msgDiv.innerHTML = `
                <div class="content">${msg.message}</div>
                <div class="timestamp">${msg.timestamp}</div>
            `;

            msgBox.appendChild(msgDiv);
            msgBox.scrollTop = msgBox.scrollHeight;
        }


        $(document).ready(function () {
            $(".btn-activate-offer").on("click", function (e) {
                e.preventDefault();
                const $this = $(this);
                const id = $this.attr("data-offer-id");

                Swal.fire({
                    title: 'Â· √‰  „ √ﬂœø',
                    text: "”Ì „  ›⁄Ì· ⁄—÷ «·’Ì«‰…!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: '‰⁄„° ﬁ„ »«· ›⁄Ì·!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "@Url.Action("Activate", "FreeMaintenanceOffer")/" + id,
                            type: 'PUT',
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire(
                                        ' „ «· ›⁄Ì·!',
                                        ' „  ›⁄Ì· «·⁄—÷ »‰Ã«Õ.',
                                        'success'
                                    );
                                    const $card = $this.closest(".card");

                                    $this.replaceWith(`<span class="text-success fw-semibold"> „  ›⁄Ì· «·⁄—÷</span>`);

                                    if ($card.find(".badge.bg-success").length === 0) {
                                        $card.prepend(`
                        <div class="position-absolute top-0 end-0 m-2">
                            <span class="badge bg-success rounded-circle p-3">
                                <i class="bi bi-check2-circle fs-4 text-white"></i>
                            </span>
                        </div>
                    `);
                                    }
                                } else {
                                    Swal.fire({
                                        icon: 'warning',
                                        title: '·„   „ ⁄„·Ì… «· ›⁄Ì·',
                                        text: '«·—Ã«¡ «· √ﬂœ „‰ ≈ﬂ„«· «·ÕÃÊ“«  «·„ÿ·Ê»… Ê ≈⁄«œ… «·„Õ«Ê·….',
                                        confirmButtonText: 'Õ”‰«',
                                        timer: 3000  // The alert will close after 3 seconds
                                    });
                                }
                            },
                            error: function (xhr) {
                                Swal.fire(
                                    'Œÿ√!',
                                    'ÕœÀ Œÿ√ √À‰«¡ «·≈‰ Â«¡ „‰ «·’Ì«‰….',
                                    'error'
                                );
                                console.error(xhr.responseText);
                            }
                        });
                    }
                });
            });


            $('#vehicleBrand').on('change', function () {
                var brandId = $(this).val();
                if (brandId) {
                    $.ajax({
                        url: "@Url.Action("GetModelsByBrandId", "Model")/" + brandId,
                        type: 'GET',
                        success: function (data) {
                            var $modelSelect = $('#vehicleModel');
                            $modelSelect.empty();
                            $modelSelect.append('<option hidden disabled selected> -- «Œ — «·„ÊœÌ· -- </option>');
                            $.each(data, function (i, item) {
                                $modelSelect.append('<option value="' + item.id + '">' + item.name + '</option>');
                            });
                        },
                        error: function () {
                            alert('›‘· ›Ì  Õ„Ì· „ÊœÌ·«  Â–Â «·„«—ﬂ…');
                        }
                    });
                }
            });



            // Handle form submission
            $('#appointmentForm').on('submit', function (e) {
                e.preventDefault(); // Prevent the default form submission

                var formData = {
                    BrandId: $('#vehicleBrand').val(),
                    ModelId: $('#vehicleModel').val(),
                    ModelYear: $('#vehicleModelYear').val(),
                    ServiceId: $('#serviceId').val(), // Send null if ServiceType is not selected
                    Details: $('#exampleFormControlTextarea1').val()
                };

                function getBadgeClass(status) {
                    switch (status) {
                        case "Completed": return "bg-success";
                        case "Pending": return "bg-warning text-dark";
                        case "Scheduled": return "bg-primary";
                        default: return "bg-danger";
                    }
                }

                $.ajax({
                    url: '@Url.Action("BookAppointment", "Appointment")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function (response) {
                        if (response.success) {
                            // If the appointment was successfully booked
                            Swal.fire({
                                icon: 'success',
                                title: ' „ «·ÕÃ“ »‰Ã«Õ',
                                text: ' „  ≈÷«›… «·„Ê⁄œ ≈·Ï ÃœÊ·ﬂ.',
                                confirmButtonText: 'Õ”‰«',
                                timer: 3000  // The alert will close after 3 seconds
                            }).then(function () {
                                $('#appointmentForm')[0].reset();
                                // Reload the appointments tbody from server
                                $.get('/Appointment/GetAppointmentsTable', function (data) {
                                    $('#appointmentsBody').html(data);
                                }).fail(function (xhr) {
                                    console.error("Failed to load appointment table:", xhr.responseText);
                                });
                            });
                        } else {
                            // If there was an issue with the booking (e.g., conflicting schedule)
                            Swal.fire({
                                icon: 'warning',
                                title: '·„ Ì „ «·ÕÃ“',
                                text: '·œÌﬂ ÕÃ“ ﬁÌœ «·«‰ Ÿ«— »‰›” »Ì«‰«  Â–« «·ÕÃ“ . Ì—ÃÏ „—«Ã⁄… ÕÃÊ“« ﬂ «·Õ«·Ì… ﬁ»· ≈‰‘«¡ ÕÃ“ ÃœÌœ „‘«»Â.',
                                confirmButtonText: 'Õ”‰«',
                                timer: 3000  // The alert will close after 3 seconds
                            });
                        }
                    },
                    error: function () {
                        // If there was an error while making the AJAX request
                        Swal.fire({
                            icon: 'error',
                            title: 'ÕœÀ Œÿ√!',
                            text: 'ÕœÀ Œÿ√ √À‰«¡ «·ÕÃ“. «·—Ã«¡ «·„Õ«Ê·… ·«Õﬁ«.',
                            confirmButtonText: 'Õ”‰«',
                            timer: 3000  // The alert will close after 3 seconds
                        });
                    }
                });

            });

            let map;
            let marker;
            $('#addressModal').on('shown.bs.modal', function () {
                if (!map) {
                    map = L.map('map').setView([23.8859, 45.0792], 6); // Center of Saudi Arabia, zoom level adjusted

                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '&copy; OpenStreetMap contributors'
                    }).addTo(map);

                    map.on('click', function (e) {
                        const lat = e.latlng.lat;
                        const lng = e.latlng.lng;

                        $('#locationLat').val(lat);
                        $('#locationLong').val(lng);

                        if (marker) {
                            marker.setLatLng([lat, lng]);
                        } else {
                            marker = L.marker([lat, lng]).addTo(map);
                        }
                    });
                }

                setTimeout(() => {
                    map.invalidateSize();
                }, 200); // Fix display issue when modal opens
            });
            $('#addressForm').on('submit', function (e) {
                console.log($('#address').val());
                e.preventDefault(); // Prevent default form submission

                // Collect form data
                var formData = {
                    city: $('#city').val(),
                    street: $('#street').val(),
                    neighborhood: $('#neighborhood').val(),
                    address: $('#addressDetails').val(),
                    locationLat: $('#locationLat').val(),
                    locationLong: $('#locationLong').val()
                };


                // Send data via AJAX
                $.ajax({
                    url: '@Url.Action("Add", "Address")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function (response) {
                        Swal.fire({
                            icon: 'success',
                            title: ' „ ≈—”«· «·⁄‰Ê«‰ »‰Ã«Õ',
                            confirmButtonText: '„Ê«›ﬁ',
                            timer: 3000
                        });
                        $('#addressForm')[0].reset(); // Reset form fields
                        const newRow = `
                                                                                                            <tr>
                                                                                                                <td>
                                                                                                                   ${response.data.id}
                                                                                                                </td>
                                                                                                                <td>
                                                                                                                   ${response.data.city}
                                                                                                                </td>
                                                                                                                <td>
                                                                                                                   ${response.data.street}
                                                                                                                </td>
                                                                                                                <td>
                                                                                                                   ${response.data.neighborhood}
                                                                                                                </td>
                                                                                                                        <td>
                                                                                                <a href="/Address/Details/${response.data.id}" class="btn info-btn btn-sm">
                                                                                                    <i class="fas fa-info-circle"></i>
                                                                                                </a>
                                                                                                        <a asp-route-id="${response.data.id}" data-id="${response.data.id}"
                                                                                                           class="btn btn-sm btn-danger btn-address-delete">
                                                                                                            <i class="fas fa-trash-alt"></i>
                                                                                                        </a>
                                                                                                    </td>
                                                                                                            </tr>
                                                                                                        `;

                        $('#addressesBody').append(newRow);

                    },
                    error: function (xhr, status, error) {
                        alert('ÕœÀ Œÿ√ √À‰«¡ «·≈—”«·: ' + error);
                    }
                });
            });


            // Handle the form submission
            $('#editProfileForm').on('submit', function (e) {
                e.preventDefault();  // Prevent the form from submitting normally

                // Get the form data
                var formData = {
                    fullName: $('#fullName').val(),
                    phoneNumber: $('#phoneNumber').val(),
                    phone1: "10",
                    phone2: "10"
                };

                // Send AJAX PUT request to update the profile
                $.ajax({
                    url: "@Url.Action("UpdateProfile", "Account")",  // Replace with the actual controller action
                    type: 'PUT',
                    data: JSON.stringify(formData),
                    contentType: 'application/json',
                    success: function (response) {
                        // Close the modal on success

                        $('#userFullName').text(response.fullName);
                        $('#userPhoneNumber').text(response.phoneNumber);


                        Swal.fire({
                            icon: 'success',
                            title: ' „  ÕœÌÀ «·„·› «·‘Œ’Ì »‰Ã«Õ!',
                            text: ' „  ÕœÌÀ »Ì«‰« ﬂ »‰Ã«Õ.',
                            confirmButtonText: '„Ê«›ﬁ',
                            timer: 3000  // The alert will close after 3 seconds

                        });
                    },
                    error: function (xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'ÕœÀ Œÿ√!',
                            text: 'ÕœÀ Œÿ√ √À‰«¡  ÕœÌÀ «·„·› «·‘Œ’Ì. «·—Ã«¡ «·„Õ«Ê·… ·«Õﬁ«.',
                            confirmButtonText: 'Õ”‰«',
                            timer: 3000  // The alert will close after 3 seconds
                        });
                    }
                });
            });


            // Handle form submission
            $('#uploadProfileImageForm').on('submit', function (e) {
                e.preventDefault();  // Prevent the form from submitting normally

                // Create a FormData object to hold the file and other form data
                var formData = new FormData();
                formData.append('image', $('#image')[0].files[0]);  // Use 'image' to match controller

                $.ajax({
                    url: '@Url.Action("UploadProfileImage", "Account")',
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: ' „ —›⁄ «·’Ê—… »‰Ã«Õ!',
                                text: ' „ —›⁄ «·’Ê—… «·‘Œ’Ì… »‰Ã«Õ.',
                                confirmButtonText: '„Ê«›ﬁ',
                                timer: 3000
                            });
                            $('#profileImage').attr('src', response.result); // or response.result.Data if needed
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'ÕœÀ Œÿ√!',
                                text: response.message || 'ÕœÀ Œÿ√ √À‰«¡ —›⁄ «·’Ê—….',
                                confirmButtonText: 'Õ”‰«',
                                timer: 3000
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'ÕœÀ Œÿ√!',
                            text: 'ÕœÀ Œÿ√ √À‰«¡ —›⁄ «·’Ê—…. «·—Ã«¡ «·„Õ«Ê·… ·«Õﬁ«.',
                            confirmButtonText: 'Õ”‰«',
                            timer: 3000
                        });
                    }
                });
            });

            $(document).on("click", ".btn-address-delete", function (e) {

                const $this = $(this);
                const id = $(this).attr("data-id");

                Swal.fire({
                    title: 'Â· √‰  „ √ﬂœø',
                    text: "”Ì „ Õ–› «·⁄‰Ê«‰ ‰Â«∆Ì«!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: '‰⁄„° «Õ–›Â!',
                    cancelButtonText: '≈·€«¡'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "@Url.Action("Delete", "Address")/" + id,
                            type: 'DELETE',
                            success: function (result) {
                                Swal.fire(
                                    ' „ «·Õ–›!',
                                    ' „ Õ–› «·⁄‰Ê«‰ »‰Ã«Õ.',
                                    'success'
                                );
                                $this.closest("tr").remove();
                            }
                        });
                    }
                });

                e.preventDefault();
            });
            $(".btn-pge").on("click", function (e) {
                $this = $(this);
                var pg = $(this).attr("data-pg");
                if (result.isConfirmed) {
                    $.ajax({
                        url: "@Url.Action("Index", "Brand", new { area = "Admin" })/" + pg,
                        type: 'POST'

                    });
                }
            });
        });


    </script>

}