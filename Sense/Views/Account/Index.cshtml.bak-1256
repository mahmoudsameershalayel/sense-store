                                            <textarea class="form-control" id="exampleFormControlTextarea1" rows="4"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                    <!-- Submit Buttons -->
                    <div class="row mt-4">
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                            <button type="submit" class="btn btn-lg w-100" style="background-color: #253F8E; color: white;">ÕÃ“</button>
                        </div>
                        <div class="col-lg-4 col-md-4 col-sm-6 mb-3">
                            <input type="reset" class="btn btn-warning btn-lg w-100" value="≈⁄«œ… «·÷»ÿ">
