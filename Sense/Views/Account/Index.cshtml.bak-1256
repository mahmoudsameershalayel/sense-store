@using System.ComponentModel.DataAnnotations
@using Sense.Domain.Enums
@using Sense.Application.DTOs.AppointmentDTOs
@using Sense.Application.DTOs.FreeMaintenanceOfferDTOs
@using Sense.Application.DTOs.OrderDTOs
@using Sense.Infrastructure.Extensions

@{
    var appointments = ViewBag.Appointments;
    var addresses = ViewBag.Addresses;
    var orders = ViewBag.Orders as List<OrderDto>;
    var maintenanceRecords = ViewBag.MaintenanceRecords;
    var freeMaintenanceOffers = ViewBag.FreeMaintenanceOffers as List<FreeMaintenanceOfferDto>;
    var brands = ViewBag.Brands;
    var user = ViewBag.User;
    var token = ViewBag.Token;
    var services = ViewBag.Services;
    var wallet = ViewBag.Wallet;
    var userMessages = ViewBag.UserMessages;
    var customer = ViewBag.Customer;

    var serviceType = Context.Request.Query["ServiceType"];
    var appointmentStatus = Context.Request.Query["Status"];
    var brandId = Context.Request.Query["BrandId"];

    var appointmentTotalPages = ViewBag.AppointmentTotalPages;
    var appointmentCurrentPage = ViewBag.AppointmentCurrentPage;

    var maintenanceTotalPages = ViewBag.MaintenanceTotalPages;
    var maintenanceCurrentPage = ViewBag.MaintenanceCurrentPage;

}

@section Styles
{
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <link href="https://cdn.jsdelivr.net/npm/animate.css@4.1.1/animate.min.css" rel="stylesheet" />

    <style type="text/css">
          .step-icon {
        transition: transform 0.3s ease-in-out;
        font-size: 1.5rem;
    }

    .step-icon.completed {
        color: #28a745;
        animation: popIn 0.4s ease;
    }

    @@keyframes popIn {
        0% { transform: scale(0); opacity: 0; }
        80% { transform: scale(1.2); opacity: 1; }
        100% { transform: scale(1); }
    }

    .progress {
        height: 8px;
        background-color: #e9ecef;
    }

    .progress-bar {
        transition: width 0.5s ease;
    }
        .chat-container {
            display: flex;
            flex-direction: column;
            max-width: 500px;
            width: 100%;
            height: 500px; 
            background-color: #fff;
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            padding: 20px;
            display: flex;
            flex-direction: column;
        }

        .messages-list {
            flex: 1;
            overflow-y: auto; /* show scrollbar always */
            padding: 15px 20px;
            margin-bottom: 20px;
            height: 400px;
            background-color: #fff; /* cleaner white background */
            border-radius: 15px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            border: 1px solid #ddd;
            scrollbar-width: thin;
            scrollbar-color: #888 #f0f0f0;
        }

            .messages-list::-webkit-scrollbar {
                width: 10px;
            }

            .messages-list::-webkit-scrollbar-track {
                background: #f0f0f0;
                border-radius: 10px;
            }

            .messages-list::-webkit-scrollbar-thumb {
                background-color: #888;
                border-radius: 10px;
                border: 2px solid #f0f0f0;
                transition: background-color 0.3s ease;
            }

                .messages-list::-webkit-scrollbar-thumb:hover {
                    background-color: #555;
                }

        .message {
            display: block;
            max-width: 75%;
            padding: 14px 18px;
            border-radius: 20px;
            margin-bottom: 12px;
            font-size: 15px;
            line-height: 1.4;
            position: relative;
            word-wrap: break-word;
            box-shadow: 0 1px 4px rgba(0,0,0,0.1);
            transition: background-color 0.3s ease;
        }

        .sent {
            background-color: #4A90E2; /* modern blue */
            color: white;
            margin-left: auto;
            border-radius: 20px 20px 0 20px;
            box-shadow: 0 3px 8px rgba(74, 144, 226, 0.4);
        }

            .sent:hover {
                background-color: #357ABD;
            }


        .received {
            background-color: #E2E2E2; /* light gray for received */
            color: #222;
            margin-right: auto;
            border-radius: 20px 20px 20px 0;
            box-shadow: 0 3px 8px rgba(0,0,0,0.1);
        }

        .timestamp {
            font-size: 0.75rem;
            color: #999;
            text-align: right;
            margin-top: 6px;
            display: block;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Input and send button */
        .input-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        #messageInput {
            flex-grow: 1;
            padding: 14px 20px;
            font-size: 16px;
            border: 1.5px solid #ccc;
            border-radius: 30px;
        }

      

            #messageInput:focus {
                outline: none;
                border-color: #4A90E2;
                box-shadow: 0 0 8px rgba(74, 144, 226, 0.5);
            }

        #sendButton {
            background-color: #4A90E2;
            color: white;
            padding: 14px 22px;
            border-radius: 50%;
            border: none;
            cursor: pointer;
        }

            #sendButton:hover {
                background-color: #357ABD;
                box-shadow: 0 5px 12px rgba(53, 122, 189, 0.8);
            }

            #sendButton:focus {
                outline: none;
            }
            /* FontAwesome send icon */
.send-btn i {
    font-size: 20px;
}

/* Smooth fade-in for messages */
.message {
    animation: fadeIn 0.4s ease-in-out;
}

@@keyframes fadeIn {
    0% {
        opacity: 0;
        transform: translateY(8px);
    }
    100% {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Responsive adjustments */
@@media (max-width: 600px) {
    .chat-container {
        max-width: 95%;
        padding: 15px;
    }
    #messageInput {
        font-size: 14px;
    }
    #sendButton {
        font-size: 14px;
        padding: 12px 18px;
    }
}

        /* FontAwesome Send icon */
        .send-btn i {
            font-size: 20px;
        }

        /* Scroll behavior */
        .messages-list::-webkit-scrollbar {
            width: 8px;
        }

        .messages-list::-webkit-scrollbar-thumb {
            background-color: #bbb;
            border-radius: 4px;
        }

        /* Smooth transition for new messages */
        .message {
            animation: fadeIn 0.5s ease-in-out;
        }

        @@keyframes fadeIn {
            0% {
                opacity: 0;
                transform: translateY(10px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Responsive styles for smaller screens */
        @@media (max-width: 600px) {
            .chat-container {
                max-width: 90%;
                padding: 15px;
            }

            #messageInput {
                font-size: 14px;
            }

            #sendButton {
                font-size: 14px;
            }
        }

        .contact-banner {
            position: relative;
            width: 100%;
            height: 200px;
            background: url('https://img.freepik.com/premium-photo/driving-saudi-man-driving-car-feeling-good_465992-3965.jpg ') no-repeat center center/cover;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-align: center;
        }

            .contact-banner::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.5);
                z-index: 1;
            }

        .contact-banner-text {
            position: relative;
            z-index: 2;
        }

            .contact-banner-text h1 {
                font-size: 3rem;
                color: white;
                margin: 0;
                padding: 0;
            }

            .contact-banner-text p {
                font-size: 1.25rem;
            }

        .custom-btn {
            background-color: #253F8E;
            color: #FFD700;
            border: 2px solid #253F8E;
        }

            .custom-btn:hover {
                background-color: transparent;
                color: #253F8E;
                border: 2px solid #253F8E;
                border-radius: 50px;
                padding: 0.5rem 1rem;
                transition: all 0.3s ease;
                text-decoration: none;
            }

        .info-btn {
            background-color: #253F8E;
            color: #FFD700;
            border: 2px solid #253F8E;
        }

            .info-btn:hover {
                background-color: transparent;
                color: #253F8E;
                border: 2px solid #253F8E;
                transition: all 0.3s ease;
                text-decoration: none;
            }


        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            background-color: #fff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
            direction: rtl;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

            table thead {
                background-color: #f8f9fa;
            }

                table thead th {
                    font-size: 14px;
                    font-weight: 600;
                    padding: 10px 12px;
                    white-space: nowrap;
                    text-align: center;
                    border-bottom: 1px solid #dee2e6;
                }

            table tbody td {
                font-size: 13px;
                padding: 8px 10px;
                vertical-align: middle;
                text-align: center;
            }

            table tbody tr {
                transition: background-color 0.2s ease;
                height: 40px;
            }

                table tbody tr:hover {
                    background-color: #f1f1f1;
                }

            /* Striped rows (if using .table-striped) */
            table.table-striped tbody tr:nth-of-type(odd) {
                background-color: #fcfcfc;
            }

            /* Smaller buttons inside tables */
            table .btn {
                font-size: 12px;
                padding: 5px 10px;
            }

        @@media (max-width: 768px) {
            table thead th,
            table tbody td {
                font-size: 12px;
                padding: 6px 8px;
            }

            table .btn {
                font-size: 11px;
                padding: 4px 8px;
            }
        }

        .chat-container {
            max-width: 500px;
            margin: auto;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 10px;
        }

        .messages-list {
            height: 300px;
            overflow-y: auto;
            border: 1px solid #ddd;
            padding: 10px;
            margin-bottom: 10px;
        }

        #messageInput {
            width: 70%;
            padding: 5px;
        }

        #sendButton {
            padding: 5px 10px;
        }
    </style>
}

<!-- Contact Banner Image -->
<div class="contact-banner">
    <div class="contact-banner-text">
        <h1>
            Õ”«»Ì
        </h1>
    </div>
</div>

<section id="contact" class="contact section m-5">
    <div class="container">
        <!-- Tabs Navigation -->
        <ul class="nav nav-tabs" id="appointmentTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="my-appointments-tab" data-bs-toggle="tab" data-bs-target="#my-appointments" type="button" role="tab">
                    „Ê«⁄ÌœÌ
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="maintenance-tab" data-bs-toggle="tab" data-bs-target="#invoices" type="button" role="tab">
                    ”Ã·«  «·’Ì«‰…
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="store-tab" data-bs-toggle="tab" data-bs-target="#orders" type="button" role="tab">
                    „‘ —Ì« Ì
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="address-tab" data-bs-toggle="tab" data-bs-target="#address" type="button" role="tab">
                    ⁄‰«ÊÌ‰Ì
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="wallet-tab" data-bs-toggle="tab" data-bs-target="#wallet" type="button" role="tab">
                    „Õ›Ÿ Ì
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#history" type="button" role="tab">
                    «·—”«∆·
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab">
                    „·›Ì «·‘Œ’Ì
                </button>
            </li>
        </ul>
    </div>

    <!-- Tabs Content -->
    <div class="tab-content mt-3" id="appointmentTabsContent">
        <div class="tab-pane fade show active" id="my-appointments" role="tabpanel">
            <div class="container py-5">
                <div class="row text-end">
                    <div class="col-md-6 mb-2">
                        <h1 class="fw-bold mb-4 text-end">„Ê«⁄ÌœÌ</h1>
                    </div>
                    <div class="col-md-6 mb-2 d-flex align-items-end justify-content-start" dir="ltr">
                        <button class="btn custom-btn mb-3" style="border-radius: 50px; padding: 0.5rem 1rem; text-decoration: none;" data-bs-toggle="modal" data-bs-target="#appointmentModal">
                            ÕÃ“ „Ê⁄œ
                        </button>
                    </div>
                </div>

                <form method="get" asp-action="Index" class="mb-4">
                    <div class="row text-end">

                        <!-- Service Type Filter -->
                        <div class="col-md-3 mb-2">
                            <label for="ServiceType">‰Ê⁄ «·Œœ„…</label>
                            <select class="form-select" name="ServiceType">
                                <option value="">-- «·ﬂ· --</option>
                                @foreach (var item in Enum.GetValues(typeof(ServiceType)))
                                {
                                    var field = item.GetType().GetField(item.ToString());
                                    var display = field.GetCustomAttributes(typeof(DisplayAttribute), false).FirstOrDefault() as DisplayAttribute;
                                    var name = display?.Name ?? item.ToString();
                                    var val = (int)item;
                                    <option value="@val">@name</option>
                                }
                            </select>
                        </div>

                        <!-- Status Filter -->
                        <div class="col-md-3 mb-2">
                            <label for="Status">Õ«·… «·ÕÃ“</label>
                            <select class="form-select" name="Status">
                                <option value="">-- «·ﬂ· --</option>
                                @foreach (var status in Enum.GetValues(typeof(AppointmentStatus)))
                                {
                                    var display = status.GetType()
                                    .GetField(status.ToString())
                                    ?.GetCustomAttributes(typeof(DisplayAttribute), false)
                                    .FirstOrDefault() as DisplayAttribute;
                                    var name = display?.Name ?? status.ToString();
                                    var val = (int)status;
                                    <option value="@val">@name</option>
                                }
                            </select>
                        </div>

                        <!-- Brand Filter -->
                        <div class="col-md-3 mb-2">
                            <label for="BrandId">„«—ﬂ… «·”Ì«—…</label>
                            <select class="form-select" name="BrandId">
                                <option value="">-- «·ﬂ· --</option>
                                @foreach (var brand in brands)
                                {
                                    <option value="@brand.Id">@brand.Name</option>
                                }
                            </select>
                        </div>

                        <!-- Filter Button -->
                        <div class="col-md-3 mb-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">›· —</button>
                        </div>
                    </div>
                </form>
                <div class="table-responsive shadow rounded-3">
                    <table class="table table-bordered table-hover align-middle text-center" id="myAppointmentsTable" dir="rtl">
                        <thead class="table-light">
                            <tr>
                                <th>—ﬁ„ «·ÕÃ“</th>
                                <th>„ÊœÌ· «·”Ì«—…</th>
                                <th>„«—ﬂ… «·”Ì«—…</th>
                                <th>‰Ê⁄ «·Œœ„…</th>
                                <th> «—ÌŒ «· ﬁœÌ„</th>
                                <th> «—ÌŒ «·ÕÃ“</th>
                                <th>Êﬁ  «·ÕÃ“</th>
                                <th>≈”„ «·›—⁄</th>
                                <th>Õ«·… «·ÕÃ“</th>
                                <th>«· ›«’Ì·</th>
                            </tr>
                        </thead>
                        <tbody id="appointmentsBody">
                            @foreach (var item in appointments)
                            {
                                <tr>
                                    <td>@item.Id#</td>
                                    <td>@item.ModelYear</td>
                                    <td>@item.Brand?.Name</td>
                                    <td>
                                        @item.Service?.TitleAr
                                    </td>
                                    <td>
                                        @item.CreatedAtDate
                                    </td>
                                    <td>
                                        @(string.IsNullOrEmpty(item.ScheduledDate) ? "·„ Ì „ «· ⁄ÌÌ‰" : item.ScheduledDate)
                                    </td>
                                    <td>
                                        @(string.IsNullOrEmpty(item.ScheduledTime) ? "·„ Ì „ «· ⁄ÌÌ‰" : item.ScheduledTime)
                                    </td>
                                    <td>
                                        @(string.IsNullOrEmpty(item.Branch?.BranchName) ? "·„ Ì „ «· ⁄ÌÌ‰" : item.Branch.BranchName)
                                    </td>
                                    <td>
                                        @{
                                            var badgeClass = item.Status switch
                                            {
                                                "Completed" => "bg-success",
                                                "Pending" => "bg-warning",
                                                "Scheduled" => "bg-primary",
                                                _ => "bg-danger"
                                            };
                                            var statusEnum = (AppointmentStatus)Enum.Parse(typeof(AppointmentStatus), item.Status);
                                            var arabicStatus = statusEnum.GetDisplayName();
                                        }
                                        <span class="badge @badgeClass fw-bold px-3 py-2">@arabicStatus</span>
                                    </td>
                                    <td>
                                        <a asp-controller="Appointment" asp-action="Details" asp-route-id="@item.Id" class="btn info-btn btn-sm">
                                            <i class="fas fa-info-circle"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Pagination Controls -->
            <div class="pagination-container text-center mt-3">
                <!-- Previous Page Button -->
                @if (appointmentCurrentPage > 1)
                {
                    <a href="@Url.Action("Index", new {
        pageNumber = appointmentCurrentPage - 1,
        pageSize = 5,
        ServiceType = serviceType,
        Status = appointmentStatus,
        BrandId = brandId
    })" class="btn btn-primary">
                        «·’›Õ… «·”«»ﬁ…
                    </a>
                }

                <!-- Page Number Display -->
                <span class="mx-2">’›Õ… @appointments.MetaData.CurrentPage „‰ @appointments.MetaData.TotalPages</span>

                <!-- Next Page Button -->
                @if (appointmentCurrentPage < appointmentTotalPages)
                {
                    <a href="@Url.Action("Index", new {
        pageNumber = appointmentCurrentPage + 1,
        pageSize = 5,
        ServiceType = serviceType,
        Status = appointmentStatus,
        BrandId = brandId
    })" class="btn btn-primary">
                        «·’›Õ… «· «·Ì…
                    </a>
                }
            </div>

        </div>

        <div class="tab-pane fade" id="profile" role="tabpanel">
            <div class="container py-5">
                <div class="d-flex justify-content-between mb-4">
                    <!-- Edit Profile button aligned to the left -->
                    <!-- Edit Profile Button -->
                    <button class="btn custom-btn mb-3" style="border-radius: 50px; padding: 0.5rem 1rem; text-decoration: none;"
                            data-bs-toggle="modal" data-bs-target="#editProfileModal">
                         ⁄œÌ· «·„·› «·‘Œ’Ì
                    </button>
                    <!-- Profile title centered -->
                    <h2 class="text-center mb-4 mx-auto">„·›Ì «·‘Œ’Ì</h2>
                    <!-- Upload Profile Image button aligned to the right -->
                    <button class="btn custom-btn mb-3" style="border-radius: 50px; padding: 0.5rem 1rem; text-decoration: none;" data-bs-toggle="modal" data-bs-target="#uploadProfileImageModal">—›⁄ ’Ê—… «·„·› «·‘Œ’Ì</button>
                </div>
                <div class="card p-4 shadow-sm">
                    <div class="text-center mb-4">
                        @if (!string.IsNullOrEmpty(user.ImageURL))
                        {
                            <img src="@user.ImageURL" id="profileImage" class="rounded-circle" style="width: 120px; height: 120px; object-fit: cover;" />
                        }
                        else
                        {
                            <img src="~/assets/img/2945860.png" id="profileImage" class="rounded-circle" style="width: 120px; height: 120px;" />

                        }

                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">«·«”„ «·ﬂ«„·</label>
                            <p class="form-control bg-light border-0" id="userFullName">@user.FullName</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">—ﬁ„ «·Â« ›</label>
                            <p class="form-control bg-light border-0" id="userPhoneNumber">@user.PhoneNumber</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Â« › ≈÷«›Ì 1</label>
                            <p class="form-control bg-light border-0">@user.Phone1</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Â« › ≈÷«›Ì 2</label>
                            <p class="form-control bg-light border-0">@user.Phone2</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">’·«ÕÌ« Ì</label>
                            <p class="form-control bg-light border-0">@user.UserType</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">‰ﬁ«ÿÌ</label>
                            <p class="form-control bg-light border-0">@user.MyPoints</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Õ«·… «·Õ”«»</label>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success fs-6">‰‘ÿ</span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-6">„⁄ÿ·</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="card p-4 shadow-sm">
                <div class="text-center mb-4">
                    ⁄—Ê÷ «·’Ì«‰… «·„Ã«‰Ì…
                </div>

                <div class="row g-4">
                    @foreach (var offer in freeMaintenanceOffers)
                    {
                        @await Component.InvokeAsync("IsFreeMaintenanceEligible", new { customerId = customer.Id, offer = offer });
                    }
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="invoices" role="tabpanel">
            <div class="container py-5">
                <div class="row text-end">
                    <div class="col-md-6 mb-2">
                        <h1 class="fw-bold mb-4 text-end">”Ã·«  «·’Ì«‰…</h1>
                    </div>

                </div>
                @*
                <form method="get" asp-action="Index" class="mb-4">
                <div class="row text-end">

                <!-- Service Type Filter -->
                <div class="col-md-3 mb-2">
                <label for="ServiceType">‰Ê⁄ «·Œœ„…</label>
                <select class="form-select" name="ServiceType">
                <option value="">-- «·ﬂ· --</option>
                @foreach (var item in Enum.GetValues(typeof(ServiceType)))
                {
                var field = item.GetType().GetField(item.ToString());
                var display = field.GetCustomAttributes(typeof(DisplayAttribute), false).FirstOrDefault() as DisplayAttribute;
                var name = display?.Name ?? item.ToString();
                var val = (int)item;
                <option value="@val">@name</option>
