@using Sense.Application.DTOs.AuthDTOs
@model UserForRegisterDto

@{
    var message = ViewBag.Message;
}

@section Styles
{
    <style>
        .contact-banner {
            position: relative;
            width: 100%;
            height: 150px;
            background-color: #061C42;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: #fff;
            margin-bottom: 20px;
        }

        .contact-banner-text {
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

            .contact-banner-text h1 {
                margin: 0;
                font-size: 3rem;
                font-weight: 700;
                color: #fff;
                line-height: 1;
            }

        .login {
            width: 40%;
            margin: 0 auto;
        }

        .auth-logo-only {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 24px;
        }

            .auth-logo-only img {
                max-height: 70px;
                max-width: 180px;
                object-fit: contain;
            }

        .auth-title {
            text-align: center;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .auth-subtitle {
            text-align: center;
            color: #6c757d;
            margin-bottom: 24px;
        }

        @@media (max-width: 768px) {

            .contact-banner {
                height: 120px;
            }

            .contact-banner-text h1 {
                font-size: 2.2rem;
            }

            .login {
                width: 80%;
            }

            .card {
                width: 100%;
                padding: 20px;
            }
        }

        @@media (max-width: 480px) {

            .contact-banner {
                height: 100px;
            }

            .contact-banner-text h1 {
                font-size: 1.8rem;
            }

            .login {
                width: 92%;
            }

            .card {
                padding: 15px;
            }

            .btn {
                font-size: 1rem;
                padding: 14px;
            }
        }
    </style>
}

<div class="contact-banner">
    <div class="contact-banner-text">
        <h1>إنشاء حساب جديد</h1>
    </div>
</div>

<section id="contact" class="contact section m-5">
    <div class="container login">
        <div class="authentication-wrapper authentication-basic container-p-y">
            <div class="authentication-inner">
                <div class="card">
                    <div class="card-body">

                        <div class="auth-logo-only">
                            <a href="/" style="text-decoration:none;">
                                @await Component.InvokeAsync("Branding", new { variant = "logo" })
                            </a>
                        </div>

                        <h4 class="auth-title">مرحباً بك</h4>

                        <p class="auth-subtitle">
                            أنشئ حسابك الآن لتتمكن من التسوق ومتابعة طلباتك بسهولة.
                        </p>

                        <form id="formAuthentication" class="mb-3" asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="POST">

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="firstName" class="form-label">الاسم الأول</label>
                                    <input type="text"
                                           class="form-control"
                                           id="firstName"
                                           name="FirstName"
                                           placeholder="أدخل الاسم الأول"
                                           asp-for="FirstName" />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="lastName" class="form-label">اسم العائلة</label>
                                    <input type="text"
                                           class="form-control"
                                           id="lastName"
                                           name="LastName"
                                           placeholder="أدخل اسم العائلة"
                                           asp-for="LastName" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="email" class="form-label">البريد الإلكتروني</label>
                                <input type="email"
                                       class="form-control"
                                       id="email"
                                       name="Email"
                                       placeholder="example@email.com"
                                       autocomplete="off"
                                       asp-for="Email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="mb-3 form-password-toggle">
                                <label for="password" class="form-label">كلمة المرور</label>

                                <div class="input-group input-group-merge">
                                    <input type="password"
                                           class="form-control"
                                           id="password"
                                           name="Password"
                                           placeholder="••••••••••"
                                           asp-for="Password" />
                                </div>

                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <button class="btn d-grid w-100"
                                        style="background-color: #253F8E; color: white;"
                                        type="submit">
                                    إنشاء الحساب
                                </button>
                            </div>
                        </form>

                        <div class="text-center">
                            <span>لديك حساب بالفعل؟</span>
                            <a asp-controller="Account"
                               asp-action="Login"
                               asp-route-returnUrl="@ViewData["ReturnUrl"]"
                               class="text-primary"
                               style="text-decoration: underline;">
                                تسجيل الدخول
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        @if (message != null)
        {
                <text>
                        Swal.fire({
                            icon: 'error',
                            title: 'خطأ في التسجيل',
                            text: '@message',
                            confirmButtonText: 'حسناً'
                        });
                </text>
        }
    </script>
}
