@using Sense.Application.DTOs.AuthDTOs
@model VerifyOtpDto

@section Styles
{
    <style>
        .contact-banner {
            position: relative;
            width: 100%;
            height: 150px;
            background-color: #061C42;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: #fff;
            margin-bottom: 20px;
        }

        .contact-banner-text {
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

            .contact-banner-text h1 {
                margin: 0;
                font-size: 3rem;
                font-weight: 700;
                color: #fff;
                line-height: 1;
            }

        .login {
            width: 40%;
            margin: 0 auto;
        }

        .otp-input {
            letter-spacing: 8px;
            font-size: 1.5rem;
            text-align: center;
        }

        .otp-boxes {
            display: flex;
            justify-content: center;
            gap: 10px;
            direction: ltr;
        }

        .otp-box {
            width: 48px;
            height: 56px;
            font-size: 1.5rem;
            text-align: center;
            padding: 0;
        }

        @@media (max-width: 480px) {
            .otp-box {
                width: 40px;
                height: 50px;
                font-size: 1.25rem;
            }
        }

        .auth-logo-only {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 24px;
        }

            .auth-logo-only img {
                max-height: 70px;
                max-width: 180px;
                object-fit: contain;
            }
        @@media (max-width: 768px) {
            .contact-banner {
                height: 120px;
            }

            .contact-banner-text h1 {
                font-size: 2.2rem;
            }

            .login {
                width: 80%;
            }
        }

        @@media (max-width: 480px) {
            .contact-banner {
                height: 100px;
            }

            .contact-banner-text h1 {
                font-size: 1.8rem;
            }

            .login {
                width: 92%;
            }
        }
    </style>
}

<div class="contact-banner">
    <div class="contact-banner-text">
        <h1>تأكيد البريد الإلكتروني</h1>
    </div>
</div>

<section id="verify-email" class="contact section m-5">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center mb-3" role="alert">
            @TempData["Error"]
        </div>
    }

    <div class="container login">
        <div class="authentication-wrapper authentication-basic container-p-y">
            <div class="authentication-inner">
                <div class="card">
                    <div class="card-body">

                        <div class="auth-logo-only">
                            <a href="/" style="text-decoration:none;">
                                @await Component.InvokeAsync("Branding", new { variant = "logo" })
                            </a>
                        </div>

                        <h4 class="auth-title text-center">أدخل رمز التحقق</h4>
                        <p class="auth-subtitle text-center">
                            تم إرسال رمز التحقق إلى <strong>@Model.Email</strong>
                        </p>

                        <form id="formVerifyEmail" class="mb-3" asp-controller="Account" asp-action="VerifyEmail" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="POST">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Email" />

                            <div class="mb-3">
                                <label class="form-label">رمز التحقق</label>
                                <div class="otp-boxes" id="otpBoxes">
                                    <input type="text" class="form-control otp-box" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                                    <input type="text" class="form-control otp-box" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                                    <input type="text" class="form-control otp-box" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                                    <input type="text" class="form-control otp-box" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                                    <input type="text" class="form-control otp-box" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                                    <input type="text" class="form-control otp-box" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                                </div>
                                <input type="hidden" id="otpCode" asp-for="OtpCode" />
                                <span asp-validation-for="OtpCode" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <button class="btn d-grid w-100"
                                        style="background-color: #253F8E; color: white;"
                                        type="submit">
                                    تأكيد الحساب
                                </button>
                            </div>

                            <div class="text-center">
                                <a href="#" id="resendOtpLink" class="text-primary" style="text-decoration: underline;">
                                    إعادة إرسال الرمز
                                </a>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {

    <script>
        (function () {
            var boxes = Array.prototype.slice.call(document.querySelectorAll("#otpBoxes .otp-box"));
            var hidden = document.getElementById("otpCode");

            function syncHidden() {
                hidden.value = boxes.map(function (b) { return b.value; }).join("");
            }

            boxes.forEach(function (box, index) {
                box.addEventListener("input", function () {
                    box.value = box.value.replace(/[^0-9]/g, "").slice(0, 1);
                    if (box.value && index < boxes.length - 1) {
                        boxes[index + 1].focus();
                    }
                    syncHidden();
                });

                box.addEventListener("keydown", function (e) {
                    if (e.key === "Backspace" && !box.value && index > 0) {
                        boxes[index - 1].focus();
                    }
                });

                box.addEventListener("paste", function (e) {
                    e.preventDefault();
                    var digits = (e.clipboardData || window.clipboardData).getData("text").replace(/[^0-9]/g, "").split("");
                    boxes.forEach(function (b, i) { b.value = digits[i] || ""; });
                    syncHidden();
                    var next = boxes[Math.min(digits.length, boxes.length - 1)];
                    next.focus();
                });
            });

            if (boxes[0]) boxes[0].focus();

            document.getElementById("formVerifyEmail").addEventListener("submit", syncHidden);
        })();

        document.getElementById("resendOtpLink").addEventListener("click", function (e) {
            e.preventDefault();

            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch("@Url.Action("ResendVerificationOtp", "Account")", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: "email=" + encodeURIComponent("@Model.Email") + "&__RequestVerificationToken=" + encodeURIComponent(token)
            })
            .then(res => res.json())
            .then(data => {
                Swal.fire({
                    icon: data.success ? "success" : "error",
                    title: data.success ? "تم الإرسال" : "خطأ",
                    text: data.message,
                    confirmButtonText: "حسناً"
                });
            });
        });
    </script>
}
