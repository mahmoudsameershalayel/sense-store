@using Sense.Application.DTOs.AuthDTOs
@model ResetPasswordDto

@section Styles
{
    <style type="text/css">
        .auth-logo-only {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 24px;
        }

            .auth-logo-only img {
                max-height: 70px;
                max-width: 180px;
                object-fit: contain;
            }

        .contact-banner {
            position: relative;
            width: 100%;
            height: 150px;
            background-color: #061C42;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-align: center;
        }

            .contact-banner::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.5);
                z-index: 1;
            }

        .contact-banner-text {
            position: relative;
            z-index: 2;
        }

            .contact-banner-text h1 {
                font-size: 3rem;
                color: white;
                margin: 0;
                padding: 0;
            }

        .reset-container {
            width: 40%;
            margin: 0 auto;
        }

        .password-toggle {
            cursor: pointer;
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #666;
        }

        .password-requirements {
            font-size: 0.85rem;
            color: #666;
            margin-top: 0.5rem;
        }

            .password-requirements ul {
                padding-right: 1.5rem;
                margin-bottom: 0;
            }

        @@media (max-width: 768px) {
            .contact-banner-text h1 {
                font-size: 2.5rem;
            }

            .reset-container {
                width: 80%;
            }
        }

        @@media (max-width: 480px) {
            .contact-banner-text h1 {
                font-size: 2rem;
            }

            .reset-container {
                width: 90%;
            }

            .contact-banner {
                height: 200px;
            }
        }
    </style>
}

<div class="contact-banner">
    <div class="contact-banner-text">
        <h1>تعيين كلمة مرور جديدة</h1>
    </div>
</div>

<section id="reset-password" class="contact section m-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center mb-3" role="alert">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center mb-3" role="alert">
            @TempData["Error"]
        </div>
    }

    <div class="container reset-container">
        <div class="authentication-wrapper authentication-basic container-p-y">
            <div class="authentication-inner">
                <div class="card">
                    <div class="card-body">

                        <div class="auth-logo-only">
                            <a href="/" style="text-decoration:none;">
                                @await Component.InvokeAsync("Branding", new { variant = "logo" })
                            </a>
                        </div>

                        <h4 class="mb-2">تعيين كلمة مرور جديدة</h4>
                        <p class="mb-4">أدخل كلمة المرور الجديدة</p>

                        <form id="formResetPassword" class="mb-3" asp-controller="Auth" asp-action="ResetPassword" method="POST">
                            <input type="hidden" asp-for="Email" />
                            <input type="hidden" asp-for="OtpCode" />

                            <div class="mb-3">
                                <label for="newPassword" class="form-label">كلمة المرور الجديدة</label>
                                <div class="input-group input-group-merge position-relative">
                                    <input type="password"
                                           id="newPassword"
                                           class="form-control"
                                           asp-for="NewPassword"
                                           placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;"
                                           autocomplete="new-password" />
                                    <span class="password-toggle" onclick="togglePassword('newPassword')">
                                        <i class="bi bi-eye" id="newPasswordIcon"></i>
                                    </span>
                                </div>
                                <span asp-validation-for="NewPassword" class="text-danger"></span>
                                <div class="password-requirements">
                                    <small>يجب أن تحتوي كلمة المرور على:</small>
                                    <ul>
                                        <li>على الأقل 6 أحرف</li>
                                        <li>حرف كبير وحرف صغير</li>
                                        <li>رقم واحد على الأقل</li>
                                    </ul>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="confirmPassword" class="form-label">تأكيد كلمة المرور</label>
                                <div class="input-group input-group-merge position-relative">
                                    <input type="password"
                                           id="confirmPassword"
                                           class="form-control"
                                           asp-for="ConfirmPassword"
                                           placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;"
                                           autocomplete="new-password" />
                                    <span class="password-toggle" onclick="togglePassword('confirmPassword')">
                                        <i class="bi bi-eye" id="confirmPasswordIcon"></i>
                                    </span>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <button class="btn d-grid w-100" style="background-color: #253F8E; color: white;" type="submit">
                                    تغيير كلمة المرور
                                </button>
                            </div>

                            <div class="text-center">
                                <a asp-controller="Account" asp-action="Login" class="text-primary" style="text-decoration: underline;">
                                    العودة لتسجيل الدخول
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <script type="text/javascript">
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(inputId + "Icon");

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }

        // Password strength indicator
        document.getElementById("newPassword").addEventListener("input", function() {
            const password = this.value;
            const requirements = document.querySelectorAll(".password-requirements li");

            // At least 6 characters
            if (password.length >= 6) {
                requirements[0].style.color = "green";
            } else {
                requirements[0].style.color = "#666";
            }

            // Has uppercase and lowercase
            if (/[a-z]/.test(password) && /[A-Z]/.test(password)) {
                requirements[1].style.color = "green";
            } else {
                requirements[1].style.color = "#666";
            }

            // Has number
            if (/\d/.test(password)) {
                requirements[2].style.color = "green";
            } else {
                requirements[2].style.color = "#666";
            }
        });
    </script>
}