@using Sense.Application.DTOs.AuthDTOs
@model ForgotPasswordDto

@section Styles
{
    <style type="text/css">
        .auth-logo-only {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 24px;
        }

            .auth-logo-only img {
                max-height: 70px;
                max-width: 180px;
                object-fit: contain;
            }

        .contact-banner {
            position: relative;
            width: 100%;
            height: 150px;
            background-color: #061C42;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-align: center;
        }

        .contact-banner::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1;
        }

        .contact-banner-text {
            position: relative;
            z-index: 2;
        }

        .contact-banner-text h1 {
            font-size: 3rem;
            color: white;
            margin: 0;
            padding: 0;
        }

        .reset-container {
            width: 40%;
            margin: 0 auto;
        }

        @@media (max-width: 768px) {
            .contact-banner-text h1 {
                font-size: 2.5rem;
            }
            .reset-container {
                width: 80%;
            }
        }

        @@media (max-width: 480px) {
            .contact-banner-text h1 {
                font-size: 2rem;
            }
            .reset-container {
                width: 90%;
            }
            .contact-banner {
                height: 200px;
            }
        }
    </style>
}

<div class="contact-banner">
    <div class="contact-banner-text">
        <h1>استعادة كلمة المرور</h1>
    </div>
</div>

<section id="reset-password" class="contact section m-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center mb-3" role="alert">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center mb-3" role="alert">
            @TempData["Error"]
        </div>
    }

    <div class="container reset-container">
        <div class="authentication-wrapper authentication-basic container-p-y">
            <div class="authentication-inner">
                <div class="card">
                    <div class="card-body">
                        <div class="auth-logo-only">
                            <a href="/" style="text-decoration:none;">
                                @await Component.InvokeAsync("Branding", new { variant = "logo" })
                            </a>
                        </div>

                        <h4 class="mb-2">نسيت كلمة المرور؟</h4>
                        <p class="mb-4">أدخل بريدك الإلكتروني وسنرسل لك رمز التحقق</p>

                        <form id="formForgotPassword" class="mb-3" asp-controller="Auth" asp-action="ForgotPassword" method="POST">
                            <div class="mb-3">
                                <label for="email" class="form-label">البريد الإلكتروني</label>
                                <input type="email"
                                       class="form-control"
                                       id="email"
                                       name="Email"
                                       placeholder="example@email.com"
                                       autocomplete="off"
                                       asp-for="Email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <button class="btn d-grid w-100" style="background-color: #253F8E; color: white;" type="submit">
                                    إرسال رمز التحقق
                                </button>
                            </div>

                            <div class="text-center">
                                <a asp-controller="Account" asp-action="Login" class="text-primary" style="text-decoration: underline;">
                                    العودة لتسجيل الدخول
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>