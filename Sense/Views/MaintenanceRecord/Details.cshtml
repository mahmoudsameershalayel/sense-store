}
@section Styles
{
    <style type="text/css">
        body {
            font-family: 'Arial', sans-serif;
            direction: rtl;
            text-align: right;
            margin: 0;
            padding: 0;
            background: #fff;
        }

        .a4-container {
            padding: 20mm;
            margin: auto;
            background: white;
            box-sizing: border-box;
        }

        .invoice-card {
            border: 1px solid #ccc;
            border-radius: 12px;
            box-shadow: 0 0 5px rgba(0,0,0,0.05);
            padding: 30px;
        }

        .contact-banner {
            position: relative;
            width: 100%;
            height: 150px;
            background: url('@Url.Content("~/assets/img/invoice.jpg")') no-repeat center center/cover;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-align: center;
        }

        .contact-banner::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1;
        }

        .contact-banner-text {
            position: relative;
            z-index: 2;
        }

        .contact-banner-text h1 {
            font-size: 3rem;
            color: white;
            margin: 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 6px 10px;
            text-align: center;
            font-size: 13px;
        }

        .badge {
            padding: 3px 10px;
            border-radius: 4px;
            color: #fff;
            font-size: 14px;
        }

        .bg-success {
            background-color: #28a745;
        }

        .bg-warning {
            background-color: #ffc107;
            color: #000;
        }

        .bg-danger {
            background-color: #dc3545;
        }

        .bg-secondary {
            background-color: #6c757d;
        }

        /* Points Redemption Section Styles - Centered and Justified */
        .points-redemption-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 30px 0;
            padding: 0 15px;
        }

        .points-redemption-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 20px;
            padding: 30px;
            color: white;
            box-shadow: 0 15px 35px rgba(102, 126, 234, 0.4);
            max-width: 800px;
            width: 100%;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .points-redemption-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            animation: pulse 4s ease-in-out infinite;
        }

        .pulse-animation {
            animation: pulse 4s ease-in-out infinite;
        }

        .points-content {
            position: relative;
            z-index: 2;
        }

        .points-header {
            text-align: center;
            margin-bottom: 25px;
        }

        .points-title {
            font-size: 1.8rem;
            font-weight: bold;
            margin-bottom: 10px;
            color: #fff;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

        .points-subtitle {
            font-size: 1rem;
            opacity: 0.9;
            margin-bottom: 20px;
        }

        .points-balance {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 25px;
            flex-wrap: wrap;
            gap: 20px;
        }

        .points-display {
            text-align: center;
        }

        .points-count {
            font-size: 3.5rem;
            font-weight: bold;
            color: #fff;
            text-shadow: 0 3px 6px rgba(0,0,0,0.3);
            margin-bottom: 5px;
            display: block;
        }

        .points-label {
            font-size: 1.2rem;
            opacity: 0.9;
            color: #f0f8ff;
        }

        .points-icon {
            font-size: 4rem;
            opacity: 0.6;
            color: #fff;
            margin: 0 30px;
        }

        .conversion-rate {
            background: rgba(255, 255, 255, 0.2);
            padding: 12px 20px;
            border-radius: 10px;
            text-align: center;
            margin-bottom: 20px;
            font-size: 1.1rem;
            font-weight: 500;
            backdrop-filter: blur(10px);
        }

        .points-form {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 15px;
            padding: 25px;
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .form-row-centered {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }

        .form-control-modern {
            background: rgba(255, 255, 255, 0.95);
            border: none;
            border-radius: 10px;
            padding: 15px 20px;
            color: #333;
            font-size: 1.1rem;
            min-width: 250px;
            text-align: center;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
        }

        .form-control-modern:focus {
            background: rgba(255, 255, 255, 1);
            box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.4);
            outline: none;
            transform: translateY(-2px);
        }

        .btn-redeem {
            background: linear-gradient(45deg, #ff6b6b, #ee5a24);
            border: none;
            border-radius: 25px;
            padding: 15px 35px;
            color: white;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            box-shadow: 0 6px 20px rgba(238, 90, 36, 0.4);
            min-width: 150px;
            cursor: pointer;
        }

        .btn-redeem:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(238, 90, 36, 0.6);
            color: white;
        }

        .btn-redeem:disabled {
            background: #6c757d;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .points-info {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            font-size: 0.95rem;
            opacity: 0.9;
            flex-wrap: wrap;
            gap: 10px;
        }

        .points-info span {
            background: rgba(255, 255, 255, 0.1);
            padding: 8px 12px;
            border-radius: 8px;
            text-align: center;
            flex: 1;
            min-width: 120px;
        }

        .discount-preview {
            background: rgba(255, 255, 255, 0.2);
            padding: 10px 15px;
            border-radius: 8px;
            text-align: center;
            margin-top: 10px;
            font-size: 1.1rem;
            font-weight: bold;
        }

        .alert-centered {
            text-align: center;
            padding: 20px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.9);
            color: #333;
            font-size: 1.1rem;
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .points-balance {
                flex-direction: column;
                text-align: center;
            }

            .points-icon {
                font-size: 3rem;
                margin: 15px 0;
            }

            .form-row-centered {
                flex-direction: column;
            }

            .form-control-modern {
                min-width: 100%;
            }

            .points-info {
                flex-direction: column;
                text-align: center;
            }
        }

        @@media print {
            @@page {
                size: A4 portrait;
                margin: 10mm;
            }

            html, body {
                width: 210mm;
                height: 297mm;
            }

            body {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            .kt-header, .kt-toolbar, .app-header, .app-footer, .kt-aside, .btn, .points-redemption-wrapper {
                display: none !important;
            }

            .a4-container {
                width: 210mm;
                min-height: 297mm;
                padding: 20mm;
                margin: 0;
                background: white;
            }

            .invoice-card {
                border: none;
                padding: 20px;
                box-shadow: none;
            }
        }
    </style>
}

