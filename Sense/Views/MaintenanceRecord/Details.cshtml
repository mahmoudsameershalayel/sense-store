@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
       @{
            decimal totalCost = Model.Invoices
            .Where(i => !(Model.IsFreeMaintenanceOfferActive && i.InvoiceType == "LaborCostInvoice"))
            .Sum(i => i.InvoiceAmount);
        }
    let pointsInfo = null;
    let originalTotal = @totalCost;
    
    // Load points information when page loads
    $(document).ready(function() {
        loadPointsInfo();
    });
    
    function loadPointsInfo() {
        $.ajax({
                url: '@Url.Action("InfoMaintenance", "Points")?maintenanceId=@Model.Id',
                method: 'GET',
                success: function(response) {
                    if (response.result.code === 200) {
                        pointsInfo = response.data;
                        updatePointsUI();
                        
                        // If already redeemed, check for existing transaction and show discount
                        if (pointsInfo.data.alreadyRedeemed) {
                            loadExistingTransaction();
                        }
                    }
                },
                error: function(xhr) {
                    console.log('Error loading points info:', xhr.responseText);
                }
            });
    }
    
