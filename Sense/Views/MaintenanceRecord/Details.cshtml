    // Handle points input change with real-time preview
    $('#pointsToRedeem').on('input', function() {
        const points = parseInt($(this).val()) || 0;
        if (points > 0 && pointsInfo && pointsInfo.data) {
            const discountAmount = points * pointsInfo.data.pointsToSARRate;
            $('#discountAmount').text(discountAmount.toFixed(2));
            $('#discountPreview').show();
        } else {
            $('#discountPreview').hide();
        }
    });
    
    // Handle points redemption form submission
    $('#pointsRedemptionForm').on('submit', function(e) {
        e.preventDefault();
        
        const pointsToRedeem = parseInt($('#pointsToRedeem').val());
        
        if (!pointsToRedeem || pointsToRedeem < pointsInfo.data.minRedeemPoints) {
            Swal.fire({
                icon: 'warning',
                title: ' Õ–Ì—',
                text: `«·Õœ «·√œ‰Ï ·«” —œ«œ «·‰ﬁ«ÿ ÂÊ ${pointsInfo.data.minRedeemPoints} ‰ﬁÿ…`,
                confirmButtonText: 'Õ”‰«'
            });
            return;
        }
        
        if (pointsToRedeem > pointsInfo.data.maxRedeemPoints) {
            Swal.fire({
                icon: 'warning',
                title: ' Õ–Ì—',
                text: `«·Õœ «·√ﬁ’Ï ·«” —œ«œ «·‰ﬁ«ÿ ÂÊ ${pointsInfo.data.maxRedeemPoints} ‰ﬁÿ…`,
                confirmButtonText: 'Õ”‰«'
            });
            return;
        }
        
        if (pointsToRedeem > pointsInfo.data.currentPoints) {
            Swal.fire({
                icon: 'warning',
                title: ' Õ–Ì—',
                text: '—’Ìœ «·‰ﬁ«ÿ €Ì— ﬂ«›Ì',
                confirmButtonText: 'Õ”‰«'
            });
            return;
        }
        
        redeemPoints(pointsToRedeem);
    });
    
