@using Sense.Domain.DBEntities
@using System.Globalization
@model ShoppingCartTbl
@{
    var total = ViewBag.Total ?? 0m;
    var deliveryFee = ViewBag.DeliveryFee ?? 0m;
}

<div class="mt-5 cart-summary-modern" id="cartSummary">
    <h4 class="cart-summary-header">ملخص السلة</h4>

    <div class="cart-summary-row">
        <span>عدد المنتجات:</span>
        <strong>@Model.Items.Count</strong>
    </div>

    <div class="cart-summary-row">
        <span>إجمالي السعر قبل الخصم:</span>
        <span id="originalTotal" data-raw-total="@total">
            @total.ToString("N0", CultureInfo.GetCultureInfo("ar-SA"))
            <svg class="riyal-svg currency" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1124.14 1256.39" width="17" height="19.2" style="display:inline-block;vertical-align:-0.125em">
                <path fill="currentColor" d="M699.62,1113.02h0c-20.06,44.48-33.32,92.75-38.4,143.37l424.51-90.24c20.06-44.47,33.31-92.75,38.4-143.37l-424.51,90.24Z"></path>
                <path fill="currentColor" d="M1085.73,895.8c20.06-44.47,33.32-92.75,38.4-143.37l-330.68,70.33v-135.2l292.27-62.11c20.06-44.47,33.32-92.75,38.4-143.37l-330.68,70.27V66.13c-50.67,28.45-95.67,66.32-132.25,110.99v403.35l-132.25,28.11V0c-50.67,28.44-95.67,66.32-132.25,110.99v525.69l-295.91,62.88c-20.06,44.47-33.33,92.75-38.42,143.37l334.33-71.05v170.26l-358.3,76.14c-20.06,44.47-33.32,92.75-38.4,143.37l375.04-79.7c30.53-6.35,56.77-24.4,73.83-49.24l68.78-101.97v-.02c7.14-10.55,11.3-23.27,11.3-36.97v-149.98l132.25-28.11v270.4l424.53-90.28Z"></path>
            </svg>
        </span>
    </div>

    <div class="cart-summary-row">
        <span>قيمة الخصم:</span>
        <span id="disVal" class="discount-badge">
            0
            <svg class="riyal-svg currency" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1124.14 1256.39" width="17" height="19.2" style="display:inline-block;vertical-align:-0.125em">
                <path fill="currentColor" d="M699.62,1113.02h0c-20.06,44.48-33.32,92.75-38.4,143.37l424.51-90.24c20.06-44.47,33.31-92.75,38.4-143.37l-424.51,90.24Z"></path>
                <path fill="currentColor" d="M1085.73,895.8c20.06-44.47,33.32-92.75,38.4-143.37l-330.68,70.33v-135.2l292.27-62.11c20.06-44.47,33.32-92.75,38.4-143.37l-330.68,70.27V66.13c-50.67,28.45-95.67,66.32-132.25,110.99v403.35l-132.25,28.11V0c-50.67,28.44-95.67,66.32-132.25,110.99v525.69l-295.91,62.88c-20.06,44.47-33.33,92.75-38.42,143.37l334.33-71.05v170.26l-358.3,76.14c-20.06,44.47-33.32,92.75-38.4,143.37l375.04-79.7c30.53-6.35,56.77-24.4,73.83-49.24l68.78-101.97v-.02c7.14-10.55,11.3-23.27,11.3-36.97v-149.98l132.25-28.11v270.4l424.53-90.28Z"></path>
            </svg>
        </span>
    </div>

    <div class="cart-summary-row">
        <span>رسوم التوصيل:</span>
        <input type="hidden" id="deliveryFeeRaw" value="@deliveryFee" />

        <strong class="text-primary">
            <span id="deliveryFeeValue">
                @deliveryFee.ToString("N0", CultureInfo.GetCultureInfo("ar-SA"))
            </span>
            <svg class="riyal-svg currency" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1124.14 1256.39" width="17" height="19.2" style="display:inline-block;vertical-align:-0.125em">
                <path fill="currentColor" d="M699.62,1113.02h0c-20.06,44.48-33.32,92.75-38.4,143.37l424.51-90.24c20.06-44.47,33.31-92.75,38.4-143.37l-424.51,90.24Z"></path>
                <path fill="currentColor" d="M1085.73,895.8c20.06-44.47,33.32-92.75,38.4-143.37l-330.68,70.33v-135.2l292.27-62.11c20.06-44.47,33.32-92.75,38.4-143.37l-330.68,70.27V66.13c-50.67,28.45-95.67,66.32-132.25,110.99v403.35l-132.25,28.11V0c-50.67,28.44-95.67,66.32-132.25,110.99v525.69l-295.91,62.88c-20.06,44.47-33.33,92.75-38.42,143.37l334.33-71.05v170.26l-358.3,76.14c-20.06,44.47-33.32,92.75-38.4,143.37l375.04-79.7c30.53-6.35,56.77-24.4,73.83-49.24l68.78-101.97v-.02c7.14-10.55,11.3-23.27,11.3-36.97v-149.98l132.25-28.11v270.4l424.53-90.28Z"></path>
            </svg>
        </strong>
    </div>

    <div class="coupon-section">
        <div class="input-group">
            <input type="text" class="form-control coupon-input" id="couponCode" placeholder="أدخل كود الخصم">
            <button class="btn coupon-apply-btn" id="applyCouponBtn" type="button">
                <i class="bx bx-check-circle"></i> تطبيق
            </button>
            <span class="spinner-border spinner-border-sm coupon-spinner ms-2" role="status" aria-hidden="true" style="display:none;" id="couponSpinner"></span>
        </div>
        <div id="couponResult" class="coupon-result text-success fw-bold" style="display:none;"></div>
    </div>

    <div class="cart-summary-total">
        <span>الإجمالي النهائي:</span>
        <strong>
            <span id="cart-total-value">
                @((total + deliveryFee).ToString("N0", CultureInfo.GetCultureInfo("ar-SA")))
            </span>
            <svg class="riyal-svg currency" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1124.14 1256.39" width="17" height="19.2" style="display:inline-block;vertical-align:-0.125em">
                <path fill="currentColor" d="M699.62,1113.02h0c-20.06,44.48-33.32,92.75-38.4,143.37l424.51-90.24c20.06-44.47,33.31-92.75,38.4-143.37l-424.51,90.24Z"></path>
                <path fill="currentColor" d="M1085.73,895.8c20.06-44.47,33.32-92.75,38.4-143.37l-330.68,70.33v-135.2l292.27-62.11c20.06-44.47,33.32-92.75,38.4-143.37l-330.68,70.27V66.13c-50.67,28.45-95.67,66.32-132.25,110.99v403.35l-132.25,28.11V0c-50.67,28.44-95.67,66.32-132.25,110.99v525.69l-295.91,62.88c-20.06,44.47-33.33,92.75-38.42,143.37l334.33-71.05v170.26l-358.3,76.14c-20.06,44.47-33.32,92.75-38.4,143.37l375.04-79.7c30.53-6.35,56.77-24.4,73.83-49.24l68.78-101.97v-.02c7.14-10.55,11.3-23.27,11.3-36.97v-149.98l132.25-28.11v270.4l424.53-90.28Z"></path>
            </svg>
        </strong>
    </div>

    <a asp-controller="Order" asp-action="Confirm" id="confirmBtn" class="btn checkout-btn-primary">
        <i class="bx bx-check-circle"></i> إتمام الشراء
    </a>
</div>
