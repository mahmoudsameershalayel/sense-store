                max-height: 36px !important;
                height: 36px !important;
                width: auto !important;
                object-fit: contain;
            }

            .mobile-nav .form-control {
                font-size: 11px !important;
                height: 34px !important;
                padding-right: 8px !important;
                padding-left: 8px !important;
                border-radius: 17px !important;
            }

            .mobile-nav .btn-primary {
                width: 34px !important;
                height: 34px !important;
                flex-shrink: 0 !important;
            }

            .mobile-nav .btn-primary i {
                font-size: 13px !important;
            }

            .mobile-nav .container {
                padding-left: 8px !important;
                padding-right: 8px !important;
            }

            .mobile-nav {
                padding: 8px 0 !important;
                min-height: 54px !important;
            }

            /* Ensure search form doesn't overflow */
            .mobile-nav form {
                display: flex !important;
                align-items: center !important;
                gap: 5px !important;
                width: 100% !important;
            }

            .mobile-nav .d-flex > div {
                max-width: calc(100% - 48px) !important;
            }
        }

        /* Tablet landscape specific optimizations */
        @@media (min-width: 768px) and (max-width: 991px) and (orientation: landscape) {
            .mobile-nav {
                padding: 8px 0 !important;
            }

            .mobile-nav .form-control {
                font-size: 13px !important;
            }
        }

        /* ===============================
           EXTRA SMALL SCREENS (<= 360px)
           =============================== */
        @@media (max-width: 360px) {
            /* Container that holds the search */
            .mobile-nav .d-flex

        {
            gap: 6px !important;
        }

        /* Search input */
        .mobile-nav input.form-control {
            height: 32px !important;
            font-size: 11px !important;
            padding: 4px 10px !important;
            border-radius: 16px !important;
        }

        /* Search button */
        .mobile-nav button,
        .mobile-nav .btn-primary {
            width: 32px !important;
            height: 32px !important;
            min-width: 32px !important;
            padding: 0 !important;
        }

            .mobile-nav .btn-primary i {
                font-size: 13px !important;
            }

        /* Limit search container width */
        .mobile-nav .container > .d-flex > div {
            max-width: calc(100% - 46px) !important;
        }

        /* Logo slightly smaller */
        .mobile-nav .logo img {
            height: 34px !important;
        }

        }
        /* Fix mobile search width */
        .mobile-nav .search-container {
            flex: 1 1 auto;
            min-width: 0;
            max-width: 100%;
        }

        .mobile-nav form {
            width: 100%;
        }

        .mobile-nav input.form-control {
            width: 100%;
        }

        /* Mobile search */
        .mobile-search {
            gap: 6px;
        }

            .mobile-search input {
                font-size: 13px;
                height: 32px;
                padding: 4px 12px;
                flex: 1 1 auto;
                min-width: 0;
            }

            .mobile-search button {
                width: 32px;
                height: 32px;
                padding: 0;
                background-color: #253F8E;
                border: none;
                flex-shrink: 0;
            }

            .mobile-search i {
                font-size: 14px;
            }

        .mobile-nav {
            padding: 3px 0; /* تقليل padding من 12px إلى 6px */
            background-color: #fff;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05); /* ظل أخف */
        }

            .mobile-nav .container {
                padding-top: 0;
                padding-bottom: 0;
            }

        .mobile-logo img {
            width: auto;
            max-width: 160px; /* أصغر قليلاً لتقليل الارتفاع */
            height: 90px; /* ارتفاع أكبر للشعار في الشاشات الصغيرة */
            max-height: 90px;
            border: 2px solid #253F8E; /* إطار أنحف */
            border-radius: 10px; /* زوايا مستديرة خفيفة */
            padding: 2px; /* padding أقل */
            background-color: #fff;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .mobile-logo img:hover {
                transform: scale(1.03);
                box-shadow: 0 3px 10px rgba(0,0,0,0.08);
            }
            .header-search {
                flex: 1 1 auto;
                min-width: 0;
                max-width: 540px;
                margin: 0 auto;
                padding: 0 12px;
            }

            .header-search form {
                width: 100%;
            }

            .header-search .sf-search {
                max-width: 100%;
            }

            .header-search .sf-search input {
                padding: 9px 18px;
            }

            .header-actions {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .header-action {
                position: relative;
                width: 44px;
                height: 44px;
                border-radius: 50%;
                background: #fff;
                border: 1px solid #e7eaf0;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #061C42;
                text-decoration: none;
                transition: border-color 0.15s ease, background-color 0.15s ease;
            }

                .header-action:hover {
                    color: #061C42;
                    border-color: #c4ccdb;
                    background-color: #f7f8fa;
                }

                .header-action i {
                    font-size: 18px;
                }

            .btn-login {
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 10px 22px;
                border-radius: 999px;
                background: #061C42;
                color: #fff;
                text-decoration: none;
                font-size: 14px;
                font-weight: 600;
                white-space: nowrap;
                transition: background-color 0.15s ease;
            }

                .btn-login:hover {
                    background-color: #0a2a5e;
                    color: #fff;
                }

            .header-badge {
                position: absolute;
                top: -5px;
                right: -5px;
                min-width: 19px;
                height: 19px;
                padding: 0 4px;
                border-radius: 999px;
                background: #061C42;
                color: #fff;
                font-size: 11px;
                font-weight: 700;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 2px solid #fff;
            }

    </style>
    @RenderSection("Styles", false)

</head>
<body>
    @await Component.InvokeAsync("TopBar")
    <!-- ======= Header ======= -->
    <header id="header">
        @*@await Component.InvokeAsync("CashbackOffer")*@
        <!-- Desktop Navigation -->
        <div class="container d-flex align-items-center justify-content-between gap-3 py-2 full-nav d-none d-lg-flex" dir="rtl">
            @await Component.InvokeAsync("Branding", new { variant = "desktop" })

            <div class="header-search">
                @await Component.InvokeAsync("SearchBar", new { formAction = "Index", placeholder = "ابحث عن منتجك المفضل..." })
            </div>

            <div class="d-flex align-items-center gap-4">

                <div class="header-actions">

                    <a asp-controller="Product"
                       asp-action="Wishlist"
                       class="header-action"
                       title="المفضلة"
                       aria-label="المفضلة">

                        <i class="far fa-heart"></i>
                        <span id="wishlistCount" class="header-badge">0</span>

                    </a>

                    <a asp-controller="Product"
                       asp-action="CartDetails"
                       class="header-action"
                       title="السلة"
                       aria-label="السلة">

                        <i class="fas fa-shopping-cart"></i>
                        <span id="cartItemCount" class="header-badge">0</span>

                    </a>

                </div>

                <div class="nav-item d-flex align-items-center">
                    @await Component.InvokeAsync("IsAuthenticate")
                </div>
            </div>

        </div>

        <!-- Mobile Navigation -->
        <div class="mobile-nav d-lg-none">
            <div class="container">
                @await Component.InvokeAsync("Branding", new { variant = "mobile" })
            </div>
        </div>



        <!-- Mobile Authentication Container (displays only on mobile) -->
        <div class="mobile-auth-container d-lg-none">
            <div class="container">
                <div class="d-flex align-items-center justify-content-center py-3">
                    @await Component.InvokeAsync("IsAuthenticate")
                </div>
            </div>
        </div>
    </header><!-- End Header -->


    <main id="main">
        @RenderBody()
    </main><!-- End #main -->
    @await Component.InvokeAsync("Footer")

    @if (showTourismPlatformAd)
    {
        <partial name="_TourismPlatformAd" />
    }


    <div id="preloader"></div>
    <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    @if (!pageLoadsSweetAlert)
    {
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    }


    <!-- jQuery (Only if required for other plugins) -->
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/js/favorites.js" asp-append-version="true"></script>

    <!-- Vendor JS Files -->
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>

    <!-- Template Main JS File -->
    <script src="~/assets/js/arshamain.js" asp-append-version="true"></script>
    @if (showTourismPlatformAd)
    {
        <script src="~/js/tourism-platform-ad.js" asp-append-version="true" defer></script>
    }







    <script type="text/javascript">

        function updateCartItemCount() {
            console.log('from update count');
            $.ajax({
                type: "GET",
                url: "@Url.Action("CartItemsNo", "Product")",  // Ensure correct controller and action name
                success: function (response) {
                    if (response && response.itemCount !== undefined) {
                        // Update the cart item count in desktop, mobile, and bottom navbar
                        $('#cartItemCount').text(response.itemCount);
                        $('#cartItemCountMobile').text(response.itemCount);
                        $('#cartItemCountBottom').text(response.itemCount);
                    }
                },
                error: function () {
                    console.error('Failed to fetch cart details');
                }
            });
        }
        // Run the function on page load
        $(document).ready(function () {
            updateCartItemCount();
        });
    </script>

    <script type="text/javascript">
        // Highlight active bottom nav item based on current URL
        $(document).ready(function() {
            var currentPath = window.location.pathname.toLowerCase();

            $('.bottom-nav-item').each(function() {
                var href = $(this).attr('href');
                if (href && currentPath.includes(href.toLowerCase()) && href !== '/') {
                    $(this).addClass('active').attr('aria-current', 'page');
                } else if (href === '/' && currentPath === '/') {
                    $(this).addClass('active').attr('aria-current', 'page');
                } else {
                    $(this).removeAttr('aria-current');
                }
            });
        });
    </script>

    <script type="text/javascript">
        // Force bottom navigation to be visible on page load and scroll for mobile devices
        (function() {
            function ensureBottomNavVisible() {
                var bottomNav = $('.bottom-nav');
                if (bottomNav.length && $(window).width() <= 991) {
                    bottomNav.css({
                        'position': 'fixed',
                        'bottom': '0',
                        'left': '0',
                        'right': '0',
                        'width': '100%',
                        'opacity': '1',
                        'visibility': 'visible',
                        'transform': 'translateY(0)',
                        'display': 'flex',
                        'z-index': '10000'
                    });
                }
            }

            // Run immediately
            ensureBottomNavVisible();

            // Run on page load
            $(document).ready(function() {
                ensureBottomNavVisible();
            });

            // Run on window load (after all resources loaded)
            $(window).on('load', function() {
                ensureBottomNavVisible();
            });

            // Run on scroll (to maintain visibility)
            $(window).on('scroll', function() {
                ensureBottomNavVisible();
            });

            // Run on window resize (to handle orientation changes)
            $(window).on('resize', function() {
                ensureBottomNavVisible();
            });

            // Run every 500ms for the first 5 seconds to ensure it appears
            var counter = 0;
            var interval = setInterval(function() {
                ensureBottomNavVisible();
                counter++;
                if (counter >= 10) {
                    clearInterval(interval);
                }
            }, 500);
        })();
    </script>

    <!-- Bottom Navigation Bar -->
    <nav class="bottom-nav" role="navigation" aria-label="التنقل الرئيسي">

        <a href="/" class="bottom-nav-item" aria-label="الصفحة الرئيسية">
            <i class="fas fa-home" aria-hidden="true"></i>
            <span>الرئيسية</span>
        </a>

        <a asp-controller="Product" asp-action="Index" class="bottom-nav-item" aria-label="المتجر">
            <i class="fas fa-th-large" aria-hidden="true"></i>
            <span>المتجر</span>
        </a>

        <a asp-controller="Product" asp-action="CartDetails" class="bottom-nav-item" aria-label="سلة التسوق">
            <i class="fas fa-shopping-cart" aria-hidden="true"></i>
            <span id="cartItemCountBottom" class="bottom-nav-badge" aria-label="عدد العناصر في السلة">0</span>
            <span>السلة</span>
        </a>

        <a asp-controller="Product" asp-action="Wishlist" class="bottom-nav-item" aria-label="المفضلة">
            <i class="fas fa-heart" aria-hidden="true"></i>
            <span>المفضلة</span>
        </a>

        <a asp-controller="Account" asp-action="Index" class="bottom-nav-item" aria-label="حسابي">
            <i class="fas fa-user" aria-hidden="true"></i>
            <span>حسابي</span>
        </a>

    </nav>

    @RenderSection("Scripts", false)
</body>
</html>
