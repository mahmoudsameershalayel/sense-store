@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "تم رفض الوصول";
}

@section Styles {
    <style>
        .access-denied-container {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 80vh;
            background: linear-gradient(to right, #061C42, #253F8E);
            color: white;
            text-align: center;
            padding: 2rem;
            border-radius: 20px;
        }

        .access-denied-box {
            background-color: rgba(255, 255, 255, 0.1);
            padding: 2rem;
            border-radius: 15px;
            max-width: 600px;
            box-shadow: 0 0 20px rgba(0,0,0,0.2);
        }

            .access-denied-box h1 {
                font-size: 3rem;
                margin-bottom: 1rem;
            }

            .access-denied-box p {
                font-size: 1.25rem;
                margin-bottom: 2rem;
            }

            .access-denied-box a.btn-home {
                background-color: #FFD700;
                color: #253F8E;
                padding: 0.75rem 1.5rem;
                border-radius: 30px;
                font-weight: bold;
                transition: background-color 0.3s ease;
                text-decoration: none;
            }

                .access-denied-box a.btn-home:hover {
                    background-color: white;
                }

        .access-denied-icon {
            font-size: 4rem;
            color: #FFD700;
            margin-bottom: 1rem;
        }
    </style>
}

<div class="access-denied-container">
    <div class="access-denied-box">
        <div class="access-denied-icon">
            <i class="fas fa-ban"></i>
        </div>
        <h1>تم رفض الوصول</h1>
        <p>ليس لديك الصلاحية للوصول إلى هذه الصفحة.<br />إذا كنت تعتقد أن هذا خطأ، يرجى التواصل مع الإدارة.</p>
        <a href="/" class="btn-home">العودة إلى الصفحة الرئيسية</a>
    </div>
</div>