@using Sense.Application.DTOs.CategoryDTOs
@{
    var categories = ViewBag.Categories as List<CategoryDto> ?? new List<CategoryDto>();
}

@if (categories.Any())
{
    <section id="categories" class="sf-section sf-categories" dir="rtl" aria-labelledby="categoriesTitle">
        <div class="container">
            <div class="sf-section-head sf-categories__head">
                <div class="sf-section-head__titles">
                    <span class="sf-kicker">
                        <i class="bi bi-grid" aria-hidden="true"></i>
                        اكتشف المتجر
                    </span>
                    <h2 id="categoriesTitle" class="sf-title">تسوّق حسب الفئة</h2>
                    <p class="sf-subtitle">اختر الفئة المناسبة وانتقل مباشرة إلى منتجاتها.</p>
                </div>

                <div class="sf-categories__controls" aria-label="التنقل بين الفئات">
                    <button class="sf-categories__nav sf-categories__next" type="button" aria-label="الفئة التالية">
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </button>
                    <button class="sf-categories__nav sf-categories__prev" type="button" aria-label="الفئة السابقة">
                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <div class="sf-categories__carousel">
                <div class="swiper categorySwiper">
                    <div class="swiper-wrapper">
                    @for (var index = 0; index < categories.Count; index++)
                    {
                        var category = categories[index];
                        <a asp-controller="Product"
                           asp-action="Index"
                           asp-route-ProductCategoryId="@category.Id"
                           class="swiper-slide sf-category-card"
                           style="--sf-category-delay: @(Math.Min(index, 6) * 45)ms"
                           aria-label="عرض منتجات فئة @category.Name">
                            <span class="sf-category-card__media">
                                @if (!string.IsNullOrWhiteSpace(category.ImageURL))
                                {
                                    <img src="@category.ImageURL"
                                         alt=""
                                         width="320"
                                         height="220"
                                         loading="lazy"
                                         decoding="async" />
                                }
                                else
                                {
                                    <span class="sf-category-card__placeholder" aria-hidden="true">
                                        <i class="bi bi-grid"></i>
                                    </span>
                                }
                            </span>

                            <span class="sf-category-card__body">
                                <span class="sf-category-card__text">
                                    <small>تصفّح الفئة</small>
                                    <strong>@category.Name</strong>
                                </span>
                                <span class="sf-category-card__arrow" aria-hidden="true">
                                    <i class="bi bi-arrow-left"></i>
                                </span>
                            </span>
                        </a>
                    }
                    </div>
                </div>
            </div>
        </div>
    </section>
}
