@using Sense.Application.DTOs.ApplicationUserDTOs
@model IsAuthenticateDto

@if (!string.IsNullOrEmpty(Model.FullName))
{
    <!-- User is logged in -->
    <div class="d-flex align-items-center gap-3">
        <a class="d-flex align-items-center text-decoration-none gap-2" href="@Url.Action("Index", "Account")" style="color: inherit;">
            @if(Model.ImageURL == null)
            {
                <img src="~/assets/img/avatar-default.svg"
                     class="rounded-circle"
                style="width: 40px; height: 40px; object-fit: cover;" />
            }else
            {
                <img src="@Model.ImageURL"
                     class="rounded-circle"
                     style="width: 40px; height: 40px; object-fit: cover;" />
            }
            <span>مرحبا @Model.FullName</span>
        </a>

        <!-- Logout icon -->
        <a href="@Url.Action("Logout", "Account")" class="text-decoration-none" title="تسجيل الخروج">
            <i class="fas fa-sign-out-alt fa-lg" style="color: #dc3545;"></i>
        </a>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="Account" asp-action="Login" class="btn-login" title="تسجيل الدخول" aria-label="تسجيل الدخول">
            تسجيل الدخول
        </a>
    </div>
}
