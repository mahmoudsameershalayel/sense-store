@using Sense.Application.DTOs.FreeMaintenanceOfferDTOs
@model List<FreeMaintenanceOfferDto>

@if (Model != null && Model.Any())
{
    foreach (var offer in Model)
    {
        @if (offer.IsActive)
        {
            <div class="offer-slide" style="min-width: 100%; display: flex; align-items: center; justify-content: center; background-color: #FFD700;padding:10px 0px">
                <div class="container text-center" style="color: #253F8E;">
                    <strong>@offer.Title:</strong> @offer.Description - 
                    <span>احجز @offer.RequiredAppointments مواعيد واحصل على صيانة مجانية لمدة @offer.FreePeriodInDays يومًا</span>
                </div>
            </div>
        }

    }
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const wrapper = document.getElementById("offerSlideWrapper");
            const slides = wrapper.querySelectorAll(".offer-slide");
            let currentIndex = 0;

            setInterval(() => {
                currentIndex = (currentIndex + 1) % slides.length;
                wrapper.style.transform = `translateX(-${currentIndex * 100}%)`;
            }, 4000); // 4 seconds per slide
        });
    </script>
}