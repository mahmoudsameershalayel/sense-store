@using Sense.Application.DTOs.CategoryDTOs
@{
    var placeholder = ViewBag.Placeholder as string ?? "ابحث عن فئة محددة...";
    var isMobile = ViewBag.IsMobile as bool? ?? false;
    var categories = ViewBag.Categories as List<CategoryDto> ?? new List<CategoryDto>();
    var inputId = isMobile ? "categorySearchInputMobile" : "categorySearchInput";
    var suggestionsId = isMobile ? "categorySearchSuggestionsMobile" : "categorySearchSuggestions";
}

<form class="sf-category-search @(isMobile ? "sf-category-search--mobile" : string.Empty)"
      method="get"
      asp-controller="Product"
      asp-action="Index"
      role="search"
      autocomplete="off"
      data-category-search>
    <div class="sf-search">
        <input type="search"
               id="@inputId"
               class="sf-category-search__input"
               placeholder="@placeholder"
               aria-label="البحث عن فئة محددة"
               aria-controls="@suggestionsId"
               aria-expanded="false"
               aria-autocomplete="list" />

        <button type="submit" aria-label="البحث عن فئة">
            <i class="bx bx-search" aria-hidden="true"></i>
            <span class="d-none d-sm-inline">بحث</span>
        </button>
    </div>

    <div class="sf-category-search__suggestions"
         id="@suggestionsId"
         role="listbox"
         aria-label="الفئات المقترحة"
         hidden>
        <div class="sf-category-search__heading">الفئات المقترحة</div>

        @foreach (var category in categories)
        {
            <a asp-controller="Product"
               asp-action="Index"
               asp-route-ProductCategoryId="@category.Id"
               class="sf-category-search__suggestion"
               role="option"
               data-category-suggestion
               data-category-name="@category.Name">
                <span class="sf-category-search__thumb">
                    @if (!string.IsNullOrWhiteSpace(category.ImageURL))
                    {
                        <img src="@category.ImageURL"
                             alt=""
                             width="48"
                             height="48"
                             loading="lazy"
                             decoding="async" />
                    }
                    else
                    {
                        <i class="bi bi-grid" aria-hidden="true"></i>
                    }
                </span>
                <span class="sf-category-search__copy">
                    <small>الفئة</small>
                    <strong>@category.Name</strong>
                </span>
                <i class="bi bi-arrow-left sf-category-search__arrow" aria-hidden="true"></i>
            </a>
        }

        <div class="sf-category-search__empty" data-category-search-empty hidden>
            <i class="bi bi-search" aria-hidden="true"></i>
            <span>لا توجد فئة مطابقة لبحثك.</span>
        </div>
    </div>
</form>
