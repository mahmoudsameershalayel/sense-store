@using Sense.Application.DTOs.ProductDTOs
@model List<ProductDto>
@{
    var categories = ViewBag.Categories;
}
@section Styles
{
    <style type="text/css">
        .contact-banner {
            position: relative;
            width: 100%;
            height: 300px;
            background: url('https://media.istockphoto.com/id/499178422/photo/new-auto-parts.jpg?s=612x612&w=0&k=20&c=JFj6CcYMubYwTFV7WeDwgRUq1ED6r2dLcKyle7BF93U=') no-repeat center center/cover;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-align: center;
        }

            .contact-banner::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.5);
                z-index: 1;
            }

        .contact-banner-text {
            position: relative;
            z-index: 2;
        }

            .contact-banner-text h1 {
                font-size: 3rem;
                color: white;
                margin: 0;
                padding: 0;
            }

            .contact-banner-text p {
                font-size: 1.25rem;
            }
    </style>
}

<div class="contact-banner">
    <div class="contact-banner-text">
        <h1>
            المتجر
        </h1>

    </div>
</div>

<section id="contact" class="contact section m-5">
    <!-- Store Section -->
    <div class="product-area mt-3">
        <div class="container">
            <div class="showing-result">
                <form class="row align-items-center">

                    <div class="col-lg-3 col-sm-3">
                        <select name="categoryId" class="form-control">
                            <option value="">
                                اختر الصنف
                            </option>
                            @foreach (var item in categories)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-lg-1 col-sm-1">
                        <button type="submit" class="btn btn-primary"><i class="bx bx-search"></i></button>
                    </div>
                </form>
            </div>

            <div class="row">
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {

                        <div class="col-lg-4 col-sm-6">
                            <div style="position:relative" class="single-product">
                                <a href="/Product/Details/?id=@item.Id" class="product-img">
                                    <div class="imgProductContainer">
                                        <img src="@item.ImageURL" width="500" alt="@item.Name">
                                    </div>
                                </a>

                                <a href="/Product/Details/?id=@item.Id" style="display:block">
                                    <h3>@item.Name</h3>
                                </a>
                                <div class="ProductBrandCategory">
                                    <a href="/Solution/Index?categoryId=@item.Category.Id" class="btn btn-danger btn-sm">
                                        @item.Category.Name
                                    </a>
                                    @if (item.ProviderId != null && !string.IsNullOrWhiteSpace(item.ProviderName))
                                    {
                                        <a href="/Providers/Details/@item.ProviderId" class="btn btn-outline-secondary btn-sm">
                                            <i class="bx bx-store"></i> @item.ProviderName
                                        </a>
                                    }
                                </div>
                                <!-- Price Display -->
                                <p class="card-text fw-bold text-success">
                                    السعر: @item.Price.ToString("C0", new System.Globalization.CultureInfo("ar-SA"))
                                </p>


                                <button type="submit" class="btn btn-outline-primary add-to-cart w-100" data-product-id="@item.Id">
                                    <i class="bx bx-cart"></i> أضف إلى السلة
                                </button>
                            </div>
                        </div>
                    }
                    <div class="col-lg-12">
                    </div>
                }
                else
                {
                    <div class="col-sm-12">
                        <div class="alert alert-info">
                            لا يوجد منتجات لعرضها
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            // AJAX call for Add to Cart
            $('.add-to-cart').on('click', function (e) {
                e.preventDefault();  // Prevent default behavior (if it's inside a form or linked button)

                var productId = $(this).data('product-id');  // Get the product ID from the button data attribute

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("AddToCart", "Product")", // Ensure correct controller and action name
                    data: { productId: productId },  // Pass product ID to the server
                    success: function (response) {
                        if (response.success) {
                            // Show a success message, for example in a toast or alert
                            alert(response.message);

                            // Optionally, update cart summary (e.g., number of items)
                            updateCartSummary();
                        } else {
                            alert('Failed to add product to cart');
                        }
                    },
                    error: function () {
                        alert('An error occurred while adding the product to the cart');
                    }
                });
            });

            // Function to update cart summary after adding a product
            function updateCartSummary() {
                $.ajax({
                    type: "GET",
                    url: "@Url.Action("CartDetails", "Product")", // Controller action to get the updated cart details
                    success: function (response) {
                        $('#cartSummary').html(response); // Update the cart summary in the HTML element with ID cartSummary
                    },
                    error: function () {
                        alert('Failed to update cart summary');
                    }
                });
            }
        }

    </script>
}