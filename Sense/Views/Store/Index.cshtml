@using Sense.Application.DTOs.ProductDTOs
@model List<ProductDto>
@{
    var categories = ViewBag.Categories;
}
@section Styles
{
    <style type="text/css">
        .contact-banner {
            position: relative;
            width: 100%;
            height: 150px;
            background: url('https://www.gaadizo.com/gaadizo-car-service-repairs/assets/media/components/b-main-slider/dent%20repairs.jpg') no-repeat center center/cover;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-align: center;
        }

            .contact-banner::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.5);
                z-index: 1;
            }

        .contact-banner-text {
            position: relative;
            z-index: 2;
        }

            .contact-banner-text h1 {
                font-size: 3rem;
                color: white;
                margin: 0;
                padding: 0;
            }

            .contact-banner-text p {
                font-size: 1.25rem;
            }
    </style>
}

<!-- Contact Banner Image -->
<div class="contact-banner">
    <div class="contact-banner-text">
        <h1>المتجر</h1>
    </div>
</div>
<!-- Contact Section -->
<section id="contact" class="contact section m-5">
    <div class="container">
        <div class="showing-result">
            <form class="row align-items-center">
                <div class="col-lg-2 col-sm-2">
                    <input type="text" name="key" placeholder="Enter Your Search" class="form-control" />
                </div>
                <div class="col-lg-3 col-sm-3">
                    <select name="categoryId" class="form-control">
                        <option value="null">
                           اختر الصنف
                        </option>
                        @foreach (var item in categories)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </div>
              
                <div class="col-lg-1 col-sm-1">
                    <button type="submit" class="btn btn-primary"><i class="bx bx-search"></i></button>
                </div>
            </form>
        </div>

        <div class="row">
            @if (Model.Count() > 0)
            {
                foreach (var item in Model)
                {

                    <div class="col-lg-4 col-sm-6">
                        <div style="position:relative" class="single-product">
                            <a href="/Product/Details/?id=@item.Id" class="product-img">
                                <div class="imgProductContainer">
                                    <img src="@item.ImageURL" width="500" alt="@item.Name">
                                </div>
                            </a>

                            <a href="/Product/Details/?id=@item.Id" style="display:block">
                                <h3>@item.Name</h3>
                            </a>
                            <div class="ProductBrandCategory">
                                <a href="/Solution/Index?categoryId=@item.Category.Id" class="btn btn-danger btn-sm">
                                   @item.Category.Name;
                                </a>
                               
                            </div>
                        </div>
                    </div>
                }
                <div class="col-lg-12">
                </div>
            }
            else
            {
                <div class="col-sm-12">
                    <div class="alert alert-info">
                       لا يوجد منتجات لعرضها
                    </div>
                </div>
            }
        </div>
    </div>
</section>